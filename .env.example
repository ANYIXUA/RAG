RAG_DATA_DIR=data
RAG_STORAGE_DIR=storage
RAG_CONFIG_DIR=config
RAG_COLLECTION_NAME=default
RAG_APP_VERSION=0.1.0
RAG_BUILD_COMMIT=
RAG_BUILD_TIME=
RAG_IMAGE_TAG=
RAG_KNOWLEDGE_VERSION=knowledge-v1

POSTGRES_IMAGE=pgvector/pgvector:pg16
POSTGRES_DB=rag
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag_password
POSTGRES_PORT=15432

RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120

RAG_KNOWLEDGE_REGISTRY_PATH=data/knowledge_registry.json
RAG_KNOWLEDGE_DEFAULT_STATUS=approved
RAG_REQUIRE_APPROVAL_FOR_CRAWLED=true
RAG_KNOWLEDGE_UPLOAD_DIR=storage/uploads
RAG_KNOWLEDGE_BUILD_DIR=storage/knowledge_builds
RAG_PDF_BORDERED_TABLE_PARSER=deepdoc
RAG_PDF_BORDERLESS_TABLE_PARSER=mineru
RAG_PDF_SEMISTRUCTURED_TABLE_PARSER=rules_ml
RAG_MINERU_ONLINE_ENABLED=false
RAG_MINERU_ONLINE_API_BASE=https://mineru.net/api/v1/agent
RAG_MINERU_ONLINE_LANGUAGE=ch
RAG_MINERU_ONLINE_ENABLE_TABLE=true
RAG_MINERU_ONLINE_ENABLE_OCR=false
RAG_MINERU_ONLINE_ENABLE_FORMULA=true
RAG_MINERU_ONLINE_PAGE_RANGE=
RAG_MINERU_ONLINE_TIMEOUT_SECONDS=300
RAG_MINERU_ONLINE_POLL_INTERVAL_SECONDS=3
RAG_MINERU_ONLINE_HTTP_RETRIES=3
RAG_MINERU_ONLINE_RETRY_BACKOFF_SECONDS=1
RAG_MINERU_ONLINE_TOKEN=

RAG_TOP_K=4
RAG_RETRIEVAL_MODE=hybrid
RAG_RETRIEVAL_CANDIDATE_K=20
RAG_SEMANTIC_WEIGHT=0.7
RAG_BM25_WEIGHT=0.3
RAG_MIN_SIMILARITY_SCORE=0.05
RAG_RELATIVE_SCORE_THRESHOLD=0.35

RAG_RERANK_PROVIDER=none
RAG_RERANK_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
RAG_RERANK_CANDIDATE_K=20
RAG_RERANK_TRIGGER=always
RAG_RERANK_INTENTS=recommend_solution,explain_error,query_rule,similar_case,need_human
RAG_RERANK_MIN_INTENT_CONFIDENCE=0.75

RAG_QUERY_EMBEDDING_CACHE_ENABLED=true
RAG_QUERY_EMBEDDING_CACHE_SIZE=128

RAG_ORDER_STATUS_TOOL_ENABLED=true
RAG_ORDER_STATUS_POSTGRES_DSN=postgresql://rag:rag_password@postgres:5432/rag

RAG_QUERY_LOGGING_ENABLED=true
RAG_OPS_STORE_PROVIDER=postgresql
RAG_OPS_POSTGRES_DSN=postgresql://rag:rag_password@postgres:5432/rag

RAG_VECTOR_STORE_PROVIDER=postgresql

RAG_API_ADMIN_TOKEN=
RAG_API_CORS_ORIGINS=*
RAG_API_PORT=18080

RAG_EMBEDDING_PROVIDER=openai
RAG_EMBEDDING_DIMENSION=1024
RAG_EMBEDDING_BATCH_SIZE=10
RAG_EMBEDDING_TIMEOUT_SECONDS=3
RAG_EMBEDDING_MAX_RETRIES=0
RAG_LLM_PROVIDER=openai

DASHSCOPE_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_CHAT_MODEL=qwen-plus
OPENAI_MAX_TOKENS=800
OPENAI_TIMEOUT_SECONDS=8
OPENAI_MAX_RETRIES=0
OPENAI_EMBEDDING_MODEL=text-embedding-v4
RAG_GENERATION_CONTEXT_MAX_CHARS=3200
