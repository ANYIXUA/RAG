 护次数计算 清洁空调室内外机；检修冷媒管的保温层；检查 空调运行状态；检修空调排水；紧固空调保护地 线和室外机的机架；"}, "keyword_score": 0.35516527518653307, "normalized_bm25_score": 0.35516527518653307, "rerank_score": null, "retrieval_score": 0.5712570784416013, "score": 0.5712570784416013, "semantic_score": 0.6638678512652021}, {"bm25_score": 16.287784811620053, "chunk": {"document_id": "c8588238d99d4079e1ec6101", "id": "e3c8b8f0828edef287c4c60c", "metadata": {"block_id": "blk_8a49983c7c4622817b0b", "block_index": 297, "block_type": "paragraph", "business_module": "通用知识", "chunk_index": 297, "chunk_parse_quality_status": "parsed_with_warning", "chunk_parse_warning_codes": ["bordered_table_detected"], "content_hash": "8ae9b63d869002c1950aaf1192e44b0b876ccb9d927154f35e8c48bcd24094bb", "detected_codes": [], "document_ocr_page_count": 0, "document_ocr_status": "not_required", "document_parse_quality_status": "parsed_with_warning", "document_parse_warning_count": 7, "end_unit": 48, "error_codes": [], "extension": ".pdf", "filename": "电信基础设施维护规程.pdf", "governance_source": "default_curated_policy", "heading_path": ["电信基础设施维护规程", "第298页"], "knowledge_status": "approved", "media_type": "pdf", "next_block_id": "blk_2ab796d049a715447af4", "page_number": 298, "page_warning_codes": ["bordered_table_detected"], "parent_block_id": "blk_3346a6d2044fb764e077", "parser_name": "pdf", "parser_strategy": "pymupdf_text_with_page_quality_report", "parser_version": "document-parser-v7", "permission_tags": ["public"], "previous_block_id": "blk_3346a6d2044fb764e077", "review_status": "approved", "section_path": ["电信基础设施维护规程", "第298页"], "section_title": "第298页", "source": "电信基础设施维护规程.pdf", "source_block_ids": ["blk_8a49983c7c4622817b0b"], "source_path": "/app/data/电信基础设施维护规程.pdf", "source_type": "manual", "split_index": 0, "start_unit": 0, "table_parse_applied": false, "table_parse_skip_reason": "block_type_is_paragraph", "table_parse_status": "skipped", "table_parser_route": "deepdoc", "tenant_id": "default", "title": "电信基础设施维护规程", "version_id