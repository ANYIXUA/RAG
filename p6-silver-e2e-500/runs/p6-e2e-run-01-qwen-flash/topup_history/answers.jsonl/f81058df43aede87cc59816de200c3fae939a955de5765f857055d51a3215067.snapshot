f35e8c48bcd24094bb", "detected_codes": [], "document_ocr_page_count": 0, "document_ocr_status": "not_required", "document_parse_quality_status": "parsed_with_warning", "document_parse_warning_count": 7, "end_unit": 51, "error_codes": [], "extension": ".pdf", "filename": "电信基础设施维护规程.pdf", "governance_source": "default_curated_policy", "heading_path": ["电信基础设施维护规程", "第172页"], "knowledge_status": "approved", "media_type": "pdf", "next_block_id": "blk_385d2fe67eafb43e9ff7", "page_number": 172, "page_warning_codes": ["bordered_table_detected"], "parent_block_id": "blk_4cc11cba07a63f4943f3", "parser_name": "pdf", "parser_strategy": "pymupdf_text_with_page_quality_report", "parser_version": "document-parser-v7", "permission_tags": ["public"], "previous_block_id": "blk_4cc11cba07a63f4943f3", "review_status": "approved", "section_path": ["电信基础设施维护规程", "第172页"], "section_title": "第172页", "source": "电信基础设施维护规程.pdf", "source_block_ids": ["blk_12b226084de4d0f09f82"], "source_path": "/app/data/电信基础设施维护规程.pdf", "source_type": "manual", "split_index": 0, "start_unit": 0, "table_parse_applied": false, "table_parse_skip_reason": "block_type_is_paragraph", "table_parse_status": "skipped", "table_parser_route": "deepdoc", "tenant_id": "default", "title": "电信基础设施维护规程", "version_id": "v_8ae9b63d869002c1"}, "text": "章节：电信基础设施维护规程 > 第172页 页码：172 T/CAICI XXXX—XXXX 166 10 电信基础设施维护工作量清单项目综合单价指标 10.1 电信基础设施维护工作量清单项目综合单价指标使用说明 《电信基础设施维护工作量清单项目综合单价指标》（以下简称《单价指标》）是根据《电信基础设 施维护工作量清单计价规则》规定的计价项目和计价规则制定的，其中人工的消耗是按照《通信维护企业 信息通信光缆线路维护规程范本》、《通信维护企业无线通信基站设备和设施维护规程范本》、《通信维 护企业小型局站有线通信及配套设备维护规程》、《通信维护企业宽带安装和维护规程》中规定的工作内 容和质量要求，以正常的维护工作条件、合理的劳动组织为基础，经过对企业实际维护工作成本分析、测 算综合取定的。 10.1.1 《单价指标》适用于海拔高程2000 米以下(不含2000 米)地区电信基础设施的维护工作。海拔超 过2000 米时，综合单价乘以下述调整系数： 表10.1.1 海拔高程调整系数 海拔高程（米） 2000 以上 3000 以上 4000 以上 综合单价调整系数 1.13 1.30 1.37 10.1.2 原始森林地区（室外）及沼泽地区的电信基础设施维护工作，综合单价乘以系数1.30。 10.1.3 非固定沙漠地带，进行室外的电信基础设施维护工作，综合单价乘以系数1.10。 10.1.4 其他类型的特殊地区按相关部门规定处理。 10.1.5 10.1.1～10.1.4 条所列四类特殊地区若在维护作业中同时存在两种以上情况时，调整系数相乘。 10.1.6 各专业抢修费依据故障工单次数按实计取。 10.1.7 本单价指标中注有“××以内”或“××以下”者均包括“××”本身；“××以外”或“×× 以上”者则不包括“××”本身。 ”本身。"}, "keyword_score": 0.16622501251279673, "normalized_bm25_score": 0.16622501251279673, "rerank_score": null, "retrieval_score": 0.5236342999712096, "score": 0.5236342999712096, "semantic_score": 0.676809708881958}, {"bm25_score": 13.332852826993314, "chunk": {"document_id": "c8588238d99d4079e1ec6101", "id": "6ef6abcdb9faa71cd577015c", "metadata": {"block_id": "blk_ca2123f114d93a220d93", "block_index": 245, "block_type": "paragraph", "business_module": "通用知识", "chunk_index": 245, "chunk_parse_quality_status": "parsed_with_warning", "chunk_parse_warning_codes": ["bordered_table_detected"], "content_hash": "8ae9b63d869002c1950aaf1192e44b0b876ccb9d927154f35e8c48bcd24094bb", "detected_codes": [], "document_ocr_page_count": 0, "document_ocr_status": "not_required", "document_parse_quality_status": "parsed_with_warning", "document_parse_warning_count": 7, "end_unit": 83, "error_codes": [], "extension": ".pdf", "filename": "电信基础设施维护规程.pdf", "governance_source": "default_curated_policy", "heading_path": ["电信基础设施维护规程", "第246页"], "knowledge_status": "approved", "media_type": "pdf", "next_block_id": "blk_3f54af53cc55c652d612", "page_number": 246, "page_warning_codes": ["bordered_table_detected"], "parent_block_id": "blk_750f473662a9e5144fe3", "parser_name": "pdf", "parser_strategy": "pymupdf_text_with_page_quality_report", "parser_version": "document-parser-v7", "permission_tags": ["public"], "previous_block_id": "blk_750f473662a9e5144fe3", "review_status": "approved", "section_path": ["电信基础设施维护规程", "第246页"], "section_title": "第246页", "source": "电信基础设施维护规程.pdf", "source_block_ids": ["blk_ca2123f114d93a220d93"], "source_path": "/app/data/电信基础设施维护规程.pdf", "source_type": "manual", "split_index": 0, "start_unit": 0, "table_parse_applied": false, "table_parse_skip_reason": "block_type_is_paragraph", "table_parse_status": "skipped", "table_parser_route": "deepdoc", "tenant_id": "default", "title