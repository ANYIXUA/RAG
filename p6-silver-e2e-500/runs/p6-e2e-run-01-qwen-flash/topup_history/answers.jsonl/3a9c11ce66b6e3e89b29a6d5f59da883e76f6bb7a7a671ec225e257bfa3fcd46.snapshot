": 0.657428066211105}, {"bm25_score": 13.649908381916187, "chunk": {"document_id": "c8588238d99d4079e1ec6101", "id": "6b980f4f3b783a0bcb029caf", "metadata": {"block_id": "blk_d425bb0b0c958730c21c", "block_index": 301, "block_type": "paragraph", "business_module": "设备维护", "chunk_index": 301, "chunk_parse_quality_status": "parsed_with_warning", "chunk_parse_warning_codes": ["bordered_table_detected", "semi_structured_table_detected"], "content_hash": "8ae9b63d869002c1950aaf1192e44b0b876ccb9d927154f35e8c48bcd24094bb", "detected_codes": [], "document_ocr_page_count": 0, "document_ocr_status": "not_required", "document_parse_quality_status": "parsed_with_warning", "document_parse_warning_count": 7, "end_unit": 58, "error_codes": [], "extension": ".pdf", "filename": "电信基础设施维护规程.pdf", "governance_source": "default_curated_policy", "heading_path": ["电信基础设施维护规程", "第302页"], "knowledge_status": "approved", "media_type": "pdf", "next_block_id": "blk_1c64d17f5721e159b5fd", "page_number": 302, "page_warning_codes": ["bordered_table_detected", "semi_structured_table_detected"], "parent_block_id": "blk_441ae4c7137c7ad3fbc0", "parser_name": "pdf", "parser_strategy": "pymupdf_text_with_page_quality_report", "parser_version": "document-parser-v7", "permission_tags": ["public"], "previous_block_id": "blk_441ae4c7137c7ad3fbc0", "review_status": "approved", "section_path": ["电信基础设施维护规程", "第302页"], "section_title": "第302页", "source": "电信基础设施维护规程.pdf", "source_block_ids": ["blk_d425bb0b0c958730c21c"], "source_path": "/app/data/电信基础设施维护规程.pdf", "source_type": "manual", "split_index": 0, "start_unit": 0, "table_parse_applied": false, "table_parse_skip_reason": "block_type_is_paragraph", "table_parse_status": "skipped", "table_parser_route": "deepdoc", "tenant_id": "default", "title": "电信基础设施维护规程", "version_id": "v_8ae9b63d869002c1"}, "text": "章节：电信基础设施维护规程 > 第302页 页码：302 T/CAICI XXXX—XXXX 296 10.4.3 小型局站有线设备单点维护项目综合单价指标 表10.4.3.1 WH33101 安装室内缆线走道 工作内容：1、电缆操作及走线架：开箱检验、清洁搬运、打孔、固定吊挂活支架、组装电缆走道、调