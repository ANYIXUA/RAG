按照同一信号源下天线数量计算。无源系统巡检按照同一信号源下每50 面天线计算，不足50 面按50 面计算。有源系统巡检按照每20 面天线计算，不足20 面 天线按照20 面计算。 2.安装在普通隧道的直放站和泄露式同轴电缆巡检按相应子目乘以系数1.1，高铁、地铁隧道、直放站和漏泄式同轴电缆巡检按相应子目乘以系数1.5。 3.直放站+八木天线组合巡检按照WH21115003 子目乘以系数1.2。 4.WLAN 系统巡检按照每20 面天线计算，不足20 面天线按照20 面计算。"}, "keyword_score": 0.6175909072936792, "normalized_bm25_score": 0.6175909072936792, "rerank_score": null, "retrieval_score": 0.6009663838791688, "score": 0.6009663838791688, "semantic_score": 0.593841588130093}, {"bm25_score": 16.09023570398859, "chunk": {"document_id": "c8588238d99d4079e1ec6101", "id": "4ea66e8600e99421cfbd255c", "metadata": {"block_id": "blk_1a11b304b0b0483b8865", "block_index": 134, "block_type": "paragraph", "business_module": "设备维护", "chunk_index": 134, "chunk_parse_quality_status": "parsed_with_warning", "chunk_parse_warning_codes": ["bordered_table_detected"], "content_hash": "8ae9b63d869002c1950aaf1192e44b0b876ccb9d927154f35e8c48bcd24094bb", "detected_codes": [], "document_ocr_page_count": 0, "document_ocr_status": "not_required", "document_parse_quality_status": "parsed_with_warning", "document_parse_warning_count": 7, "end_unit": 107, "error_codes": [], "extension": ".pdf", "filename": "电信基础设施维护规程.pdf", "governance_source": "default_curated_policy", "heading_path": ["电信基础设施维护规程", "第135页"], "knowledge_status": "approved", "media_type": "pdf", "next_block_id": "blk_6ad16084f542598d0186", "page_number": 135, "page_warning_codes": ["bordered_table_detected"], "parent_block_id": "blk_0ec96bb1cdea2bf1723b", "parser_name": "pdf", "parser_strategy": "pymupdf_text_with_page_quality_report", "parser_version": "document-parser-v7", "permission_tags": ["public"], "previous_block_id": "blk_0ec96bb1cdea2bf1723b", "review_status": "approved", "section_path": ["电信基础设施维护规程", "第135页"], "section_title": "第135页", "source": "电信基础设施维护规程.pdf", "source_block_ids": ["blk_1a11b304b0b0483b8865"], "source_path": "/app/data/电信基础设施维护规程.pdf", "source_type": "manual", "split_index": 0, "start_unit": 0, "table_parse_applied": false, "t