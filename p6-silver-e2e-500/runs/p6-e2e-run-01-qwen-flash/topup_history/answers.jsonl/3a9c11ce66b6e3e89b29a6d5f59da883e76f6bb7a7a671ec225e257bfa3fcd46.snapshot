B 10755 高速铁路通信工程施工质量验收标准 《信息通信建设工程预算定额》(工信部通[2016]451 号) 《信息通信建设工程费用定额》(工信部通[2016]451 号) 《信息通信建设工程概预算编制规程》(工信部通[2016]451 号) 3 术语和定义 3.1 通信光缆线路所有人 Communication Cable Line owner 指拥有通信光缆线路设施产权的电信运营商及其他信息网络设施所有人，本规程简称运营企业。 3.2 基站所有人 Base station owner 指拥有基站设施产权的电信运营商及其他信息网络设施所有人，本规程简称运营企业。 3.3 有线设备所有人 Wired device owner 指拥有有线通信及配套设备的信息通信运营商及其他信息网络设施所有者，本规程简称运营企业。 3.4 宽带设施所有人 Broadband facility owner 指拥有宽带设施及配套设备的信息通信运营商及其他信息网络设施所有者，本规程简称运营企业。"}, "keyword_score": 0.524092992990171, "normalized_bm25_score": 0.524092992990171, "rerank_score": null, "retrieval_score": 0.5856614677535109, "score": 0.5856614677535109, "semantic_score": 0.6120479569377995}, {"bm25_score": 15.068248849280755, "chunk": {"document_id": "5256824b6b72b3f03d9c7a2c", "id": "81bd459de1d4e62f9428ae88", "metadata": {"block_id": "blk_a141bf941ce190b17f72", "block_index": 3, "block_type": "paragraph", "business_module": "通用知识", "chunk_index": 3, "chunk_parse_quality_status": "parsed_with_warning", "chunk_parse_warning_codes": ["table_like_text_detected", "semi_structured_table_detected"], "content_hash": "dcf78195a87f01f45fc99b3af1c541f948a7cc8b6578168c0cb862cf9b620277", "detected_codes": [], "document_ocr_page_count": 0, "document_ocr_status": "not_required", "document_parse_quality_status": "parsed_with_warning", "document_parse_warning_count": 4, "end_unit": 300, "error_codes": [], "extension": ".pdf", "filename": "智慧家庭装维工程与管理职业技能等级标准.pdf", "governance_source": "default_curated_policy", "heading_path": ["智慧家庭装维工程与管理职业技能等级标准", "第4页"], "knowledge_status": "approved", "media_type": "pdf", "next_block_id": "blk_a360264dc7a73d4748b4", "page_number": 4, "page_warning_codes": ["table_like_text_detected", "semi_structured_table_detected"], "parent_block_id": "blk_0b8fc771544b96d89aa8", "parser_name": "pdf", "parser_strategy": "pymupdf_text_with_page_quality_report", "parser_version": "document-parser-v7", "permission_tags": ["public"], "previous_block_id": "blk_0b8fc771544b96d89aa8", "review_status": "approve