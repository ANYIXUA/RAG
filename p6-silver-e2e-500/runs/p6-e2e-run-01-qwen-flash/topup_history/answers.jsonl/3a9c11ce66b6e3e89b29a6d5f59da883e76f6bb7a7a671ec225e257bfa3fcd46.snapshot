rning", "document_parse_warning_count": 7, "end_unit": 131, "error_codes": [], "extension": ".pdf", "filename": "电信基础设施维护规程.pdf", "governance_source": "default_curated_policy", "heading_path": ["电信基础设施维护规程", "第342页"], "knowledge_status": "approved", "media_type": "pdf", "next_block_id": "blk_e0c89cc6f3b2d520d0e8", "page_number": 342, "page_warning_codes": ["table_like_text_detected"], "parent_block_id": "blk_9144e930802d6a8f5355", "parser_name": "pdf", "parser_strategy": "pymupdf_text_with_page_quality_report", "parser_version": "document-parser-v7", "permission_tags": ["public"], "previous_block_id": "blk_9144e930802d6a8f5355", "review_status": "approved", "section_path": ["电信基础设施维护规程", "第342页"], "section_title": "第342页", "source": "电信基础设施维护规程.pdf", "source_block_ids": ["blk_a8df9eb65d473f945163"], "source_path": "/app/data/电信基础设施维护规程.pdf", "source_type": "manual", "split_index": 0, "start_unit": 0, "table_parse_applied": false, "table_parse_skip_reason": "block_type_is_paragraph", "table_parse_status": "skipped", "table_parser_route": "deepdoc", "tenant_id": "default", "title": "电信基础设施维护规程", "version_id": "v_8ae9b63d869002c1"}, "text": "章节：电信基础设施维护规程 > 第342页\n页码：342\nT/CAICI XXXX—XXXX\n336\n表格列：附；录；D\n（规范性）\n信息通信光缆线路维护主要验收标准\n\n1）D.0.1 杆路与其他设施最小水平净距表：\n表 D.0.1 杆路与其他设施最小水平净距表"}, "keyword_score": 0.13931214376720397, "normalized_bm25_score": 0.13931214376720397, "rerank_score": null, "retrieval_score": 0.5144686523405692, "score": 0.5144686523405692, "semantic_score": 0.6752500131577257}]}
{"answer": "1. 架空通信线路与110KV及以上电力线路交越时，最小垂直净距为4.0米。[1]  \n2. 若电力线路有防雷保护，垂直净距要求为4.0米。[1]  \n3. 无防雷保护时，最小垂直净距应为6.0米。[1]  \n4. 该标准出自《电信基础设施维护规程》第344页表D.0.3。[1]  \n5. 110KV至220KV电力线交越时，最小垂直净距为4.0米。[1]", "case_id": "p6s-0115", "question": "当架空通信线路与110KV及以上电力线路交越时，最小垂直净距应满足什么条件？", "sources": [{"bm25_score": 107.98255206373122, "chunk": {"document_id": "c8588238d99d4079e1ec6101", "id": "23a3f4fcf6c1064229d8e25c", "metadata": {"block_id": "blk_aa79b3d4578c5a9d83a9", "block_index": 343, "block_type": "paragraph", "business_module": "设备维护", "chunk_index": 343, "chunk_parse_quality_status": "parsed_with_warning", "chunk_parse_warning_codes": ["bordered_table_detected"], "content_hash": "8ae9b63d869002c1950aaf1192e44b0b876ccb9d927154f35e8c48bcd24094bb", "detected_codes": [], "document_ocr_page_count": 0, "document_ocr_status": "not_required", "document_parse_quality_status": "parsed_with_warning", "document_parse_warning_count": 7, "end_unit": 57, "error_codes": [], "extension": ".pdf", "filename": "电信基础设施维护规程.pdf", "governance_source": "default_curated_policy", "heading_path": ["电信基础设施维护规程", "第344页"], "knowledge_status": "approved", "media_type": "pdf", "next_block_id": "blk_1ba9d238a2817aaf87e2", "page_number": 344, "page_warning_codes": ["bordered_table_detected"], "parent_block_id": "blk_9fb82b1766911b54a376", "parser_name": "pdf", "parser_strategy": "pymupdf_text_with_page_quality_report", "parser_version": "document-parser-v7", "permission_tags": ["public"], "previous_block_id": "blk_9fb82b1766911b54a376", "review_status": "approved", "section_path": ["电信基础设施维护规程", "第344页"], "section_title": "第344页", "source": "电信基础设施维护规程.pdf", "source_block_ids": ["blk_aa79b3d4578c5a9d83a9"], "source_path": "/app/data/电信基础设施维护规程.pdf", "source_type": "manual", "split_index": 0, "start_unit": 0, "table_parse_applied": false, "table_parse_skip_reason": "block_type_is_paragraph", "table_parse_status": "skipped", "table_parser_route": "deepdoc", "tenant_id": "default", "title": "电信基础设施维护规程", "