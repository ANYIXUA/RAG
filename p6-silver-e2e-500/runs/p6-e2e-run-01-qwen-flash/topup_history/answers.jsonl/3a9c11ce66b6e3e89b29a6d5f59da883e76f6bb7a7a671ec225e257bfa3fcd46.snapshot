5642}]}
{"answer": "1. 技工人工费单价为114元/工日。[3]  \n2. 普工人工费单价为61元/工日。[3]  \n3. 铺水泥盖板项目中技工与普工的工日单价已明确。[3]  \n4. 人工费包含在综合单价内，按工日计价。[3]  \n5. 单价依据《信息通信建设工程费用定额》规定。[3]", "case_id": "p6s-0194", "question": "铺水泥盖板时，技工和普工的人工费单价分别是多少？", "sources": [{"bm25_score": 38.164893390119346, "chunk": {"document_id": "c8588238d99d4079e1ec6101", "id": "986d6255e0f61ce5e0bb2b9a", "metadata": {"block_id": "blk_ee6915ce638a33b9f865", "block_index": 214, "block_type": "paragraph", "business_module": "通用知识", "chunk_index": 214, "chunk_parse_quality_status": "parsed_with_warning", "chunk_parse_warning_codes": ["bordered_table_detected", "semi_structured_table_detected"], "content_hash": "8ae9b63d869002c1950aaf1192e44b0b876ccb9d927154f35e8c48bcd24094bb", "detected_codes": [], "document_ocr_page_count": 0, "document_ocr_status": "not_required", "document_parse_quality_status": "parsed_with_warning", "document_parse_warning_count": 7, "end_unit": 80, "error_codes": [], "extension": ".pdf", "filename": "电信基础设施维护规程.pdf", "governance_source": "default_curated_policy", "heading_path": ["电信基础设施维护规程", "第215页"], "knowledge_status": "approved", "media_type": "pdf", "next_block_id": "blk_72ed2b6eb74c3b316f24", "page_number": 215, "page_warning_codes": ["bordered_table_detected", "semi_structured_table_detected"], "parent_block_id": "blk_32720c0b2af7cd6aea91", "parser_name": "pdf", "parser_strategy": "pymupdf_text_with_page_quality_report", "parser_version": "document-parser-v7", "permission_tags": ["public"], "previous_block_id": "blk_32720c0b2af7cd6aea91", "review_status": "approved", "section_path": ["电信基础设施维护规程", "第215页"], "section_title": "第215页", "source": "电信基础设施维护规程.pdf", "source_block_ids": ["blk_ee6915ce638a33b9f865"], "source_path": "/app/data/电信基础设施维护规程.pdf", "source_type": "manual", "split_index": 0, "start_unit": 0, "table_parse_applied": false, "table_parse_skip_reason": "block_type_is_paragraph", "table_parse_status": "skipped", "table_parser_route": "deepdoc", "tenant_id": "default", "title": "电信基础设