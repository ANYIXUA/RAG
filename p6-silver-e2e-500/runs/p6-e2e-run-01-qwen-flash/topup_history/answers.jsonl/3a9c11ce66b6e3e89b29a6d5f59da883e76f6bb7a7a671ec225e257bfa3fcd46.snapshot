tart_unit": 0, "table_parse_applied": false, "table_parse_skip_reason": "block_type_is_paragraph", "table_parse_status": "skipped", "table_parser_route": "deepdoc", "tenant_id": "default", "title": "电信基础设施维护规程", "version_id": "v_8ae9b63d869002c1"}, "text": "章节：电信基础设施维护规程 > 第155页 页码：155 T/CAICI XXXX—XXXX 149 8.6.4.3 宽带巡检 宽带巡检。维护工作量清单项目设置及工作量计算规则，应按表8.6.4.3 的规定执行。 表8.6.4.3 宽带巡检（编码：WH43） 项目编码 维护分项 作业名称 项目特征 计量单位 维护工作量计算规 则 维护工作（操作）内容 WH43101 光分纤箱巡 检 个²次 按照合同约定的维 护周期和实际发生 的维护次数计算 1.检查箱体安装是否牢固、箱盖是否完好。 2.检查箱内是否清洁无杂物。 3.检查分光器固定情况、分光器防尘帽是否齐全。 4.检查箱体内线缆走线、绑扎固定是否符合规范。 5.检查线缆标识是否齐全准确。 6.处理或上报发现的问题。 7.填写巡检记录。 WH43201 光网络箱巡 检 个²次 按照合同约定的维 护周期和实际发生 的维护次数计算 1.检查箱体安装是否牢固，箱盖、门锁是否完好。 2.检查箱内是否清洁无杂物。 3.检查电源电压、指示灯是否正常，箱门是否密封， 风扇是否正常、散热是否良好。 4.检查箱体内线缆走线、绑扎固定是否符合规范。 5.检查线缆标识是否齐全准确。 6.处理或上报发现的问题。 7.填写巡检记录。 WH43301 用户引入线 巡检（双绞 线、皮线光 缆） 户²次 按照合同约定的维 护周期和实际发生 的维护次数计算 1.检查用户引入线的完好情况。 2.检查用户引入线的接头是否完好、安全和规范。 3.检查用户引入线架设高度及三线交越的间距是 否符合规范要求。 4.处理或上报发现的问题。 5.填写巡检记录。"}, "keyword_score": 0.73161626618032, "normalized_bm25_score": 0.73161626618032, "rerank_score": null, "retrieval_score": 0.7081324627075126, "score": 0.7081324627075126, "semantic_score": 0.698067975504881}, {"bm25_score": 4.724207172405167, "chunk": {"document_id": "c8588238d99d4079e1ec6101", "id": "1b2149ec028f9c253059616f", "metadata": {"block_id": "blk_4ac62b325be30adec469", "block_index": 293, "block_type": "paragraph", "business_module": "设备维护", "chunk_index": 293, "chunk_parse_quality_status": "parsed_with_warning", "chunk_parse_warning_codes": ["bordered_table_detected", "semi_structured_table_detected"], "content_hash": "8ae9b63d869002c1950aaf1192e44b0b876ccb9d927154f35e8c48bcd24094bb", "detected_codes": [], "document_ocr_page_count": 0, "document_ocr_status": "not_required", "document_parse_quality_status": "parsed_with_warning", "document_parse_warning_count": 7, "end_unit": 74, "error_codes": [], "extension": ".pdf", "filename": "电信基础设施维护规程.pdf", "governance_source": "default_curated_policy", "heading_path": ["电信基础设施维护规程", "第294页"], "knowledge_status": "approved", "media_type": "pdf", "next_block_id": "blk_0a4c38e1f6766374e6ab", "page_number": 294, "page_warning_codes": ["bordered_table_detected", "semi_structured_table_detected"], "parent_block_id": "blk_c2cdb4038c2f4cb2c98f", "parser_name": "pdf", "parser_strategy": "pymupdf_text_with_page_quality_report", "parser_version": "document-parser-v7", "permission_tags": ["public"], "previous_block_id": "blk_c2cdb4038c2f4cb2c98f", "review_status": "approved", "section_path": ["电信基础设施维护规程", "第294页"], "section_title": "第294页", "source": "电信基础设施维护规程.pdf", "source_block_ids": ["blk_4ac62b325be30adec469"], "source_path": "/app/data/电信基础设施维护规程.pdf", "source_type": "manual", "split_index": 0, "start_unit": 0, "table_parse_applied": false, "table_parse_skip_reason": "block_type_is_paragraph", "table_parse_status": "skipped", "table_parser_route": "deepdoc", "tenant_id": "default", "title": "电信基础设施维护规程", "version_id": "v_8ae9b63d869002c1"}, "text": "章节：电信基础设施维护规程 > 第294页 页码：294 T/CAICI XXXX—XXXX 288 表10.4.1.3 WH31103 有线设备巡检 工作内容：1、设备子框连接检查；2、设备运行温度状况检查；3、空闲槽位状况检查；4、空闲端口状况检查；5、各已连接线缆端口连接状况检查； 6、风扇运行状态检查；7、设备已连接各类型线缆状态检查（包括信号线和电源线）等。 计量单位：架·次 次 表10.4.1.4 WH31104 高频开关电源巡检 工作内容：1、设备清洁；2、检查电源系统设备工作状态；3、检查连接点连接状态；4、检查电源线接头的防腐处理；5、检查标签标识等。 计量单位：站·次 次 维护分项作业 项目编码 项目名称 综合单价 （元） 其中 名称 人工 人工费(元) 企业管理费(元) 利润(元) 技工 普工 单位 工日 单价(元) 114.00 61.00 WH31104001 高频开关电源巡检 9.12 5.70 1.71 1.71 消耗量 0.05 — 维护分项作业 项目编码 项目名称 综合单价 （元） 其中 名称 人工 人工费(元) 企业管理费(元) 利润(元) 技工 普工 单位 工日 单价(元) 114.00 61.00 WH31103001 有线设备巡检 20.00 13.57 3.72 2.71 消耗量 0.12 0.00"}, "keyword_score": 0.12054217870457982, "normalized_bm25_score": 0.12054217870457982, "rerank_score": null, "retrieval_score": 0.5256375123469018, "score": 0.5256375123469018, "semantic_score": 0.6992497981936113}, {"bm25_score": 5.040396431925713, "chunk": {"document_id": "c8588238d99d4079e1ec6101", "id": "d3e3f69ff07c4d7974ea7013", "metadata": {"block_id": "blk_1ef5fabee14ec64b1347", "block_index": 240, "block_type": "paragraph", "business_module": "设备维护", "chunk_index": 240, "chunk_parse_quality_status": "parsed_with_warning", "chunk_parse_warning_codes": ["bordered_table_detected", "semi_structured_table_detected"], "content_hash": "8ae9b63d869002c1950aaf1192e44b0b876ccb9d927154f35e8c48bcd24094bb", "detected_codes": [], "document_ocr_page_count": 0, "document_ocr_status": "not_required", "document_parse_quality_status": "parsed_with_warning", "document_parse_warning_count": 7, "end_unit": 100, "error_codes": [], "extension": ".pdf", "filename": "电信基础设施维护规程.pdf", "governance_source": "default_curated_policy", "heading_path": ["电信基础设施维护规程", "第241页"], "knowledge_status": "approved", "media_type": "pdf", "next_block_id": "blk_2c3d5f6ccd3d0847bf14", "page_number": 241, "page_warning_codes": ["bordered_table_detected", "semi_structured_table_detected"], "parent_block_id": "blk_7c2d2add39b28db32f5b", "parser_name": "pdf", "parser_strategy": "pymupdf_text_with_page_quality_report", "parser_version": "document-parser-v7", "permission_tags": ["public"], "previous_block_id": "blk_7c2d2add39b28db32f5b", "review_status": "approved", "section_path": ["电信基础设施维护规程", "第241页"], "section_title": "第241页", "source": "电信基础设施维护规程.pdf", "source_block_ids": ["blk_1ef5fabee14ec64b1347"], "source_path": "/app/data/电信基础设施维护规程.pdf", "source_type": "manual", "split_index": 0, "start_unit": 0, "table_parse_applied": false, "table_parse_skip_reason": "block_type_is_paragraph", "table_parse_status": "skipped", "table_parser_route": "deepdoc", "tenant_id": "default", "title": "电信基础设施维护规程", "version_id": "v_8ae9b63d869002c1"}, "text": "章节：电信基础设施维护规程 > 第241页 页码：241 T/CAICI XXXX—XXXX 235 表10.3.1.15 WH21115 室内分布和WLAN 系统巡检 工作内容：检查室分天线外观、固定情况，清理遮挡物；检查外露馈线外观以及固定情况外观，检查清洁无源设备外观、线缆连接和标签等。 计量单位：综合 维护分项作业 项目编码 项目名称 综合单价 （元） 其中 名称 人工 人工费(元) 企业管理费(元) 利润(元) 技工 普工 单位 工日 单价(元) 114.00 61.00 WH21115001 室内分布和 WLAN 系统巡检 无源 50 面·次 次 62.02 38.76 11.63 11.63 消耗量 0.34 WH21115002 有源 20 面·次 次 29.18 18.24 5.47 5.47 0.16 WH21115003 直放站设备 台·次 次 21.89 13.68 4.10 4.10 0.12 WH21115004 漏泄式同轴电缆 百米·次 次 36.48 22.80 6.84 6.84 0.20 WH21115005 无线局域网接入点 （AP）设备 20 套·次 次 29.18 18.24 5.47 5.47 0.16 注：1.室内分布系统巡检按照同一信号源下天线数量计算。无源系统巡检按照同一信号源下每50 面天线计算，不足50 面按50 面计算。有源系统巡检按照每20 面天线计算，不足20 面 天线按照20 面计算。 2.安装在普通隧道的直放站和泄露式同轴电缆巡检按相应子目乘以系数1.1，高铁、地铁隧道、直放站和漏泄式同轴电缆巡检按相应子目乘以系数1.5。 3.直放站+八木天线组合巡检按照WH21115003 子目乘以系数1.2。 4.WLAN 系统巡检按照每20 面天线计算，不足20 面天线按照20 面计算。"}, "keyword_score": 0.12861001756825732, "normalized_bm25_score": 0.12861001756825732, "rerank_score": null, "retrieval_score": 0.4957212924406179, "score": 0.4957212924406179, "semantic_score": 0.6530546959573439}]}
{"answer": "1. 接到工单后，首先确认工单信息并准备相应器材。[1]  \n2. 根据规范确定障碍原因，开展障碍维修工作。[1]  \n3. 完成维修后，进行业务恢复确认。[1]  \n4. 确保业务正常后，完成障碍回单操作。[3]  \n5. 多障碍时应遵循“先重点、后一般”和“先抢通、后修复”原则。[2]", "case_id": "p6s-0270", "question": "当接到宽带障碍工单时，应如何开展障碍处理流程？", "sources": [{"bm25_score": 29.852359922595284, "chunk": {"document_id": "c8588238d99d4079e1ec6101", "id": "ba10f2779266d60fb65e5b8b", "metadata": {"block_id": "blk_274b15a4c140bfc5d3fa", "block_index": 337, "block_type": "paragraph", "business_module": "工单流转", "chunk_index": 337, "chunk_parse_quality_status": "parsed_with_warning", "chunk_parse_warning_codes": ["bordered_table_detected"], "content_hash": "8ae9b63d869002c1950aaf1192e44b0b876ccb9d927154f35e8c48bcd24094bb", "detected_codes": [], "document_ocr_page_count": 0, "document_ocr_status": "not_required", "document_parse_quality_status": "parsed_with_warning", "document_parse_warning_count": 7, "end_unit": 41, "error_codes": [], "extension": ".pdf", "filename": "电信基础设施维护规程.pdf", "governance_source": "default_curated_policy", "heading_path": ["电信基础设施维护规程", "第338页"], "knowledge_status": "approved", "media_type": "pdf", "next_block_id": "blk_266c6d2d50a01903867e", "page_number": 338, "page_warning_codes": ["bordered_table_detected"], "parent_block_id": "blk_c6d9755c25f701f917cd", "parser_name": "pdf", "parser_strategy": "pymupdf_text_with_page_quality_report", "parser_version": "document-parser-v7", "permission_tags": ["public"], "previous_block_id": "blk_c6d9755c25f701f917cd", "review_status": "approved", "section_path": ["电信基础设施维护规程", "第338页"], "section_title": "第338页", "source": "电信基础设施维护规程.pdf", "source_block_ids": ["blk_274b15a4c140bfc5d3fa"], "source_path": "/app/data/电信基础设施维护规程.pdf", "source_type": "manual", "split_index": 0, "start_unit": 0, "table_parse_applied": false, "table_parse_skip_reason": "block_type_is_paragraph", "table_parse_status": "skipped", "table_parser_route": "deepdoc", "tenant_id": "default", "title": "电信基础设施维护规程", "version_id": "v_8ae9b63d869002c1"}, "text": "章节：电信基础设施维护规程 > 第338页 页码：338 T/CAICI XXXX—XXXX 332 10.5.4 宽带障碍处理项目综合单价指标 表10.5.4.1 WH44101 障碍处理 工作内容：工单信息确认，器材准备、确定障碍原因、障碍维修、业务恢复确认、障碍回单等。 计量单位：工单²条 维护分项作业 项目编码 项目名称 综合单价 （元） 其中 名称 人工 人工费(元) 企业管理费(元) 利润(元) 技工 普工 单位 工日 单价(元) 114.00 61.00 WH44101001 障碍处理 32.34 21.94 6.01 4.39 消耗量 0.19 —"}, "keyword_score": 1.0, "normalized_bm25_score": 1.0, "rerank_score": null, "retrieval_score": 0.8026135199991418, "score": 0.8026135199991418, "semantic_score": 0.7180193142844882}, {"bm25_score": 26.73431462797766, "chunk": {"document_id": "c8588238d99d4079e1ec6101", "id": "76ed396c75bf9d41c1b6e3e5", "metadata": {"block_id": "blk_d0d65cb9dce45e788b4b", "block_index": 80, "block_type": "paragraph", "business_module": "设备维护", "chunk_index": 80, "chunk_parse_quality_status": "parsed_with_warning", "chunk_parse_warning_codes": ["bordered_table_detected"], "content_hash": "8ae9b63d869002c1950aaf1192e44b0b876ccb9d927154f35e8c48bcd24094bb", "detected_codes": [], "document_ocr_page_count": 0, "document_ocr_status": "not_required", "document_parse_quality_status": "parsed_with_warning", "document_parse_warning_count": 7, "end_unit": 62, "error_codes": [], "extension": ".pdf", "filename": "电信基础设施维护规程.pdf", "governance_source": "default_curated_policy", "heading_path": ["电信基础设施维护规程", "第81页"], "knowledge_status": "approved", "media_type": "pdf", "next_block_id": "blk_3c2ba0bda4bf5f033ea6", "page_number": 81, "page_warning_codes": ["bordered_table_detected"], "parent_block_id": "blk_0e6de1f96900b72286c4", "parser_name": "pdf", "parser_strategy": "pymupdf_text_with_page_quality_report", "parser_version": "document-parser-v7", "permission_tags": ["public"], "previous_block_id": "blk_0e6de1f96900b72286c4", "review_status": "approved", "section_path": ["电信基础设施维护规程", "第81页"], "section_title": "第81页", "source": "电信基础设施维护规程.pdf", "source_block_ids": ["blk_d0d65cb9dce45e788b4b"], "source_path": "/app/data/电信基础设施维护规程.pdf", "source_type": "manual", "split_index": 0, "start_unit": 0, "table_parse_applied": false, "table_parse_skip_reason": "block_type_is_paragraph", "table_parse_status": "skipped", "table_parser_route": "deepdoc", "tenant_id": "default", "title": "电信基础设施维护规程", "version_id": "v_8ae9b63d869002c1"}, "text": "章节：电信基础设施维护规程 > 第81页 页码：81 T/CAICI XXXX—XXXX 75 表7.5.0.3 拆机工作内容与要求 拆机环节 项目 工作内容 跳线 跳接分线盒指定信号端口 用户引入线 拆除相对应引入线部分 终端 按照运营企业要求回收业务终端 7.6 宽带安装和维护障碍及突发事件处理 7.6.1 障碍处理 7.6.1.1 宽带装维障碍是由于用户引入线、设备终端等原因导致用户无法正常使用相关业务的事件。 7.6.1.2 装维企业应配备专职维修员，在接到障碍申告后，按照装维规范及时处理。 7.6.1.3 在多起障碍同时发生时，装维企业应遵循“先重点、后一般”和“先抢通、后修复”的原则进行 修复。 7.6.1.4 宽带装维障碍处理流程见附录N。 7.6.2 突发事件处理 7.6.2.1 凡是危及网络正常运行及其附属设施安全运行的事件均称为突发事件。突发事件分为一般突发事 件、重大突发事件。一般突发事件为在设备安全和通信正常的情况下，经过对接入终端、线路一般性处理， 网络能恢复正常状态，重大突发事件为人为、自然灾害或其他不明原因导致的或将要导致设备损害和通信 中断的事件。 7.6.2.2 突发事件发生时，装维部门技术人员应迅速赶往突发事件现场，立即对现场进行处理并判断该事 件为一般突发事件或重大突发事件： a） 一般突发事件，装维部门应现场妥善处理，恢复并确保网络正常安全运行，并及时向用户通报处 理过程及结果； b） 重大突发事件，维护人员应在第一时间内通知用户，并同用户及时赶赴现场。维护人员应立即采 取措施，尽可能恢复网络正常运行。如无法及时解决，用户与维护单位技术人员应共同制定相应 的处理方案，并立即组织实施。 7.6.2.3 装维部门应根据用户的应急预案编制相应的预案，发生突发事件时应按照应急预案进行应急处理。 7.6.2.4 应急预案的编制应包括以下内容： a） 应急组织方案； b） 指挥机构； c） 主要车辆、仪表、工机具及材料的配置； d） 现场职责分工。 7.7 宽带安装和维护质量管理"}, "keyword_score": 0.8955511288654412, "normalized_bm25_score": 0.8955511288654412, "rerank_score": null, "retrieval_score": 0.7505442175059378, "score": 0.7505442175059378, "semantic_score": 0.6883983983518651}, {"bm25_score": 25.65553550412035, "chunk": {"document_id": "c8588238d99d4079e1ec6101", "id": "206d11a37b452206c3d2fc95", "metadata": {"block_id": "blk_22b59fcf2f74c7cd9af4", "block_index": 155, "block_type": "paragraph", "business_module": "设备维护", "chunk_index": 155, "chunk_parse_quality_status": "parsed_with_warning", "chunk_parse_warning_codes": ["bordered_table_detected"], "content_hash": "8ae9b63d869002c1950aaf1192e44b0b876ccb9d927154f35e8c48bcd24094bb", "detected_codes": [], "document_ocr_page_count": 0, "document_ocr_status": "not_required", "document_parse_quality_status": "parsed_with_warning", "document_parse_warning_count": 7, "end_unit": 79, "error_codes": [], "extension": ".pdf", "filename": "电信基础设施维护规程.pdf", "governance_source": "default_curated_policy", "heading_path": ["电信基础设施维护规程", "第156页"], "knowledge_status": "approved", "media_type": "pdf", "next_block_id": "blk_3085902e4b4957158254", "page_number": 156, "page_warning_codes": ["bordered_table_detected"], "parent_block_id": "blk_333244c89c00c3c08242", "parser_name": "pdf", "parser_strategy": "pymupdf_text_with_page_quality_report", "parser_version": "document-parser-v7", "permission_tags": ["public"], "previous_block_id": "blk_333244c89c00c3c08242", "review_status": "approved", "section_path": ["电信基础设施维护规程", "第156页"], "section_title": "第156页", "source": "电信基础设施维护规程.pdf", "source_block_ids": ["blk_22b59fcf2f74c7cd9af4"], "source_path": "/app/data/电信基础设施维护规程.pdf", "source_type": "manual", "split_index": 0, "start_unit": 0, "table_parse_applied": false, "table_parse_skip_reason": "block_type_is_paragraph", "table_parse_status": "skipped", "table_parser_route": "deepdoc", "tenant_id": "default", "title": "电信基础设施维护规程", "version_id": "v_8ae9b63d869002c1"}, "text": "章节：电信基础设施维护规程 > 第156页 页码：156 T/CAICI XXXX—XXXX 150 8.6.4.4 宽带障碍处理 宽带障碍处理。维护工作量清单项目设置及工作量计算规则，应按表8.6.4.4 的规定执行。 表8.6.4.4 宽带障碍处理（编码：WH44） 项目编码 维护分项 作业名称 项目特征 计量单位 维护工作量计算规则 维护工作（操作）内容 WH44101 障碍处理 工单²条 按实计列 1.工单信息确认 2.器材准备 3.确定障碍原因、障碍维修 4.障碍回单 8.6.5 电信基础设施维护工作措施清单项目（ 编码 CS100000 ） 电信基础设施维护工作措施清单项目设置、计量单位及工作量计算规则，应按表8.6.5 的规定执行。 表8.6.5 电信基础设施维护工作措施项目（编码：CS00） 项目编码 项目名称 计量 单位 工作内容及包含范围 CS00001 文明施工费 项 指维护现场为达到环保要求及文明作业所需要的各项费用。 CS00002 维护干扰费 项 指维护作业中由于受市政管理、交通管制、人流密集、现场协调等影响 工效的补偿费用。在城区、高速公路隔离带、铁路路基边缘作业的维护 项目计取此项费用。 CS00003 车辆使用费 项 指维护作业中接送维护作业人员、生活用车等（含过路、过桥）费用。 CS00004 维护资料更新、器材清点费 项 指按规定编制、更新维护资料和器材点交等所发生的费用 CS00005 维护站点设施费 项 指维护企业为进行维护作业必须设置的生活和生产用建筑物、构筑物和 其他临时设施费用等 CS00006 夜间维护作业增加费 项 指因夜间维护作业所发生的补助费、工效降低、照明设备摊销及照明用 电等费用。 CS00007 冬雨季维护作业增加费 项 指冬雨季维护作业所采取的防冻、保温、防雨防滑等安全措施及工效降 低所增加的费用。室内作业的维护项目不计此项费用。 CS00008 生产工具用具使用费 项 指维护作业所需的不属于固定资产的工具用具等的购置、摊销、维修费。"}, "keyword_score": 0.8594139816966916, "normalized_bm25_score": 0.8594139816966916, "rerank_score": null, "retrieval_score": 0.7096223920289013, "score": 0.7096223920289013, "semantic_score": 0.6454259964569913}, {"bm25_score": 22.108574592322654, "chunk": {"document_id": "5256824b6b72b3f03d9c7a2c", "id": "1c317b1dd2cebfbf9647d03e", "metadata": {"block_id": "blk_e4bef2211b5bd8cddc76", "block_index": 11, "block_type": "paragraph", "business_module": "通用知识", "chunk_index": 11, "chunk_parse_quality_status": "parsed_with_warning", "chunk_parse_warning_codes": ["bordered_table_detected"], "content_hash": "dcf78195a87f01f45fc99b3af1c541f948a7cc8b6578168c0cb862cf9b620277", "detected_codes": [], "document_ocr_page_count": 0, "document_ocr_status": "not_required", "document_parse_quality_status": "parsed_with_warning", "document_parse_warning_count": 4, "end_unit": 96, "error_codes": [], "extension": ".pdf", "filename": "智慧家庭装维工程与管理职业技能等级标准.pdf", "governance_source": "default_curated_policy", "heading_path": ["智慧家庭装维工程与管理职业技能等级标准", "第12页"], "knowledge_status": "approved", "media_type": "pdf", "next_block_id": "blk_7678536353d72d515bc9", "page_number": 12, "page_warning_codes": ["bordered_table_detected"], "parent_block_id": "blk_941760edda054c582a94", "parser_name": "pdf", "parser_strategy": "pymupdf_text_with_page_quality_report", "parser_version": "document-parser-v7", "permission_tags": ["public"], "previous_block_id": "blk_941760edda054c582a94", "review_status": "approved", "section_path": ["智慧家庭装维工程与管理职业技能等级标准", "第12页"], "section_title": "第12页", "source": "智慧家庭装维工程与管理职业技能等级标准.pdf", "source_block_ids": ["blk_e4bef2211b5bd8cddc76"], "source_path": "/app/data/智慧家庭装维工程与管理职业技能等级标准.pdf", "source_type": "manual", "split_index": 0, "start_unit": 0, "table_parse_applied": false, "table_parse_skip_reason": "block_type_is_paragraph", "table_parse_status": "skipped", "table_parser_route": "deepdoc", "tenant_id": "default", "title": "智慧家庭装维工程与管理职业技能等级标准", "version_id": "v_dcf78195a87f01f4"}, "text": "章节：智慧家庭装维工程与管理职业技能等级标准 > 第12页 页码：12 T/CAICIXXXX—XX 11 业务开通 和业务运维 光纤到户业务运维： 1.熟悉光分配网应用场景及其建设 模式 2.熟悉光纤到户业务的放装 光纤到户业务运维： 1.熟悉光纤到户的一般故障处理 光纤到户业务运维： 1.掌握光纤到户的复杂故障处理 交互式网络电视业务运维： 1.熟悉交互式网络电视开通业务流 程。 2.掌握交互式网络电视机顶盒配置。 交互式网络电视业务运维： 1.熟悉交互式网络电视的常见故障 处理方法 交互式网络电视业务运维： 1.掌握交互式网络电视的故障分析、 处理方法 基础网络故障处理： 1.基础宽带故障处理 基础网络故障处理： 1.智能组网一般故障处理 基础网络故障处理： 1.智能组网复杂故障处理 物联网接入业务运维： 1.掌握物联网接入业务的设置 2.了解常见网关故障 物联网接入业务运维： 1.掌握常见网关故障 2.了解网关组网方法 物联网接入业务运维： 1.掌握网关组网方法 2.熟悉路由协议等 家庭复合总线接入业务运维： 1.熟悉家庭复合总线的设置 家庭复合总线接入业务运维： 1.熟悉家庭复合总线常见故障处理 家庭复合总线接入业务运维： 1.掌握家庭复合总线常见故障处理 智能家居业务运维： 1.了解智能家居组网及场景设置 智能家居业务运维： 1.熟悉智能家居组网及场景设置 2.了解常见智能家居故障 智能家居业务运维： 1.熟悉常见智能家居故障 2.了解智能家居常用协议 服务能力 1.服务礼仪 2.交付技巧 3.销售技巧 4.沟通技巧 5.维护技巧 1.服务礼仪 2.交付能力 3.销售技巧 4.沟通技巧 5.维护技巧 1.服务礼仪 2.交付能力 3.销售能力 4.沟通能力 5.维护能力 安全作业 1.施工安全 2.用户信息安全 1.施工安全 2.用户信息安全 1.施工安全 2.用户信息安全 3.网络安全 6.3 初级 职业功能 工作内容 技能要求 相关知识要求 1.职业道德 1.1 职业道德 1.1.1 能进行职业道德描述 1.1.2 能进行职业道德展示 1.1.1 职业道德规范知识 1.1.2 职业道德内容知识"}, "keyword_score": 0.7405972140778274, "normalized_bm25_score": 0.7405972140778274, "rerank_score": null, "retrieval_score": 0.6627051322354496, "score": 0.6627051322354496, "semantic_score": 0.6293228114458592}]}
{"answer": "1. 发现光缆保护措施损坏，应立即修补沟坎、护坡、挡水墙等。[3]  \n2. 须及时清除路由上的杂物并培土恢复。[3]  \n3. 检查内容包括堵塞、漫水坝、护坡等是否完好。[3]  \n4. 做好巡查记录，并将问题及时上报。[3]  \n5. 此操作属于直埋光缆日常检修工作范畴。[3]", "case_id": "p6s-0271", "question": "对于直埋光缆线路，若发现沿线光缆保护措施损坏，应执行哪项日常检修操作？", "sources": [{"bm25_score": 49.05237993901815, "chunk": {"document_id": "c8588238d99d4079e1ec6101", "id": "9832f94c5c169b4751480ff2", "metadata": {"block_id": "blk_04c89d14ae2ae07179d0", "block_index": 175, "block_type": "paragraph", "business_module": "通用知识", "chunk_index": 175, "chunk_parse_quality_status": "parsed_with_warning", "chunk_parse_warning_codes": ["bordered_table_detected", "semi_structured_table_detected"], "content_hash": "8ae9b63d869002c1950aaf1192e44b0b876ccb9d927154f35e8c48bcd24094bb", "detected_codes": [], "document_ocr_page_count": 0, "document_ocr_status": "not_required", "document_parse_quality_status": "parsed_with_warning", "document_parse_warning_count": 7, "end_unit": 58, "error_codes": [], "extension": ".pdf", "filename": "电信基础设施维护规程.pdf", "governance_source": "default_curated_policy", "heading_path": ["电信基础设施维护规程", "第176页"], "knowledge_status": "approved", "media_type": "pdf", "next_block_id": "blk_903b982cfd3ac498a79a", "page_number": 176, "page_warning_codes": ["bordered_table_detected", "semi_structured_table_detected"], "parent_block_id": "blk_54252ce0967a6e6ff776", "parser_name": "pdf", "parser_strategy": "pymupdf_text_with_page_quality_report", "parser_version": "document-parser-v7", "permission_tags": ["public"], "previous_block_id": "blk_54252ce0967a6e6ff776", "review_status": "approved", "section_path": ["电信基础设施维护规程", "第176页"], "section_title": "第176页", "source": "电信基础设施维护规程.pdf", "source_block_ids": ["blk_04c89d14ae2ae07179d0"], "source_path": "/app/data/电信基础设施维护规程.pdf", "source_type": "manual", "split_index": 0, "start_unit": 0, "table_parse_applied": false, "table_parse_skip_reason": "block_type_is_paragraph", "table_parse_status": "skipped", "table_parser_route": "deepdoc", "tenant_id": "default", "title": "电信基础设施维护规程", "version_id": "v_8ae9b63d869002c1"}, "text": "章节：电信基础设施维护规程 > 第176页 页码：176 T/CAICI XXXX—XXXX 170 表10.2.1.4 WH11004 直埋光缆线路车辆巡回 工作内容：检查沿线标石、宣传牌、标志牌、警示牌是否歪斜或缺漏，沿线光缆保护措施（沟坎、堵塞、护坡、漫水坝、挡水墙等）是否损坏，沿线重点部位 保护是否到位，沿线有无外力施工影响线路安全等；做好巡查记录，并将发现的问题及时上报等。 计量单位：千米²次 维护分项作业 项目编码 项目名称 综合单价 （元） 其中 名称 人工 人工费(元) 企业管理费(元) 利润(元) 技工 普工 单位 工日 单价(元) 114.00 61.00 WH11004001 直埋光缆线路车辆巡回 平原、丘陵 24.01 16.29 4.46 3.26 消耗量 0.14 — WH11004002 山区 36.01 24.43 6.69 4.89 0.21 — WH11004003 城区 28.81 19.54 5.35 3.91 0.17 — 注：直埋硅芯管道及光缆视同直埋光缆，按直埋光缆条目取费。"}, "keyword_score": 0.9669416017979763, "normalized_bm25_score": 0.9669416017979763, "rerank_score": null, "retrieval_score": 0.8187614282265419, "score": 0.8187614282265419, "semantic_score": 0.7552556395530701}, {"bm25_score": 47.05891974885238, "chunk": {"document_id": "c8588238d99d4079e1ec6101", "id": "c379e9fa43fe7ee20946d7ab", "metadata": {"block_id": "blk_48c85ad3ad7eb7503b4c", "block_index": 174, "block_type": "paragraph", "business_module": "通用知识", "chunk_index": 174, "chunk_parse_quality_status": "parsed_with_warning", "chunk_parse_warning_codes": ["bordered_table_detected"], "content_hash": "8ae9b63d869002c1950aaf1192e44b0b876ccb9d927154f35e8c48bcd24094bb", "detected_codes": [], "document_ocr_page_count": 0, "document_ocr_status": "not_required", "document_parse_quality_status": "parsed_with_warning", "document_parse_warning_count": 7, "end_unit": 58, "error_codes": [], "extension": ".pdf", "filename": "电信基础设施维护规程.pdf", "governance_source": "default_curated_policy", "heading_path": ["电信基础设施维护规程", "第175页"], "knowledge_status": "approved", "media_type": "pdf", "next_block_id": "blk_54252ce0967a6e6ff776", "page_number": 175, "page_warning_codes": ["bordered_table_detected"], "parent_block_id": "blk_69f3d1dd84eaa7be2be1", "parser_name": "pdf", "parser_strategy": "pymupdf_text_with_page_quality_report", "parser_version": "document-parser-v7", "permission_tags": ["public"], "previous_block_id": "blk_69f3d1dd84eaa7be2be1", "review_st