ion_tags": ["public"], "previous_block_id": "blk_0ec96bb1cdea2bf1723b", "review_status": "approved", "section_path": ["电信基础设施维护规程", "第135页"], "section_title": "第135页", "source": "电信基础设施维护规程.pdf", "source_block_ids": ["blk_1a11b304b0b0483b8865"], "source_path": "/app/data/电信基础设施维护规程.pdf", "source_type": "manual", "split_index": 0, "start_unit": 0, "table_parse_applied": false, "table_parse_skip_reason": "block_type_is_paragraph", "table_parse_status": "skipped", "table_parser_route": "deepdoc", "tenant_id": "default", "title": "电信基础设施维护规程", "version_id": "v_8ae9b63d869002c1"}, "text": "章节：电信基础设施维护规程 > 第135页 页码：135 T/CAICI XXXX—XXXX 129 力发电机组、太 阳能光伏离网 发电系统） 7.检查附属设备运行情况。 8.检查紧固连接线缆。 WH21112 环境监控设 备巡检 地貌、社会因素 （市区、平原、 山区） 站²次 按照合同约定的 维护周期和实际 发生的维护次数 计算 1.检查清洁监控设备。 2.测试告警功能。 3.检查标识标签。 WH21113 温控设备巡 检 地貌、社会因素 （市区、平原、 山区） 站²次 按照合同约定的 维护周期和实际 发生的维护次数 计算 1.检查空调及通风设备室内外机运行情况。 2.清理室内外机设备滤网。 3.检查标识标签。 WH21114 防雷接地系 统巡检 地貌、社会因素 （市区、平原、 山区） 站²次 按照合同约定的 维护周期和实际 发生的维护次数 计算 1.接地体剂配件防腐防锈处理。 2.螺栓紧固，外露回填等。 WH21115 室内分布系 统巡检 1.类型（无源、 有源） 2.天线数量（无 源50 面，有源 20 面） 50 面²次 20 面²次 按照合同约定的 维护周期和实际 发生的维护次数 计算 1.检查室分天线外观、固定情况。 2.清理遮挡物。 3.检查外露馈线外观以及固定情况外观。 4.检查清洁无源设备外观、线缆连接和标签。 WH21116 铁塔巡检 1.地貌、社会因 素（市区、平原、 山区） 2.铁塔类型 座²次 按照合同约定的 维护周期和实际 发生的维护次数 计算 1.检查铁塔主体结构以及附属设施、铁塔基础、 防雷接地装置。 2.清理铁塔周边环境卫生。 WH21117 基站机房及 附属设施巡 检 1.地貌、社会因 素（市区、平原、 山区） 2.机房类型 站²次 按照合同约定的 维护周期和实际 发生的维护次数 计算 1.检查机房主体结构、内外墙面、防盗设施、走 线架、照明插座、消防设施等。以及孔洞封堵机 房密封情况 2.检修上站道路、清除机房外部杂物杂草、 3.内外部环境安全、清洁机房内卫生等。"}, "keyword_score": 0.7167924194068194, "normalized_bm25_score": 0.7167924194068194, "rerank_score": null, "retrieval_score": 0.6712376553097475, "score": 0.6712376553097475, "semantic_score": 0.6517141849824312}, {"bm25_score": 25.170810402450538, "chunk": {"document_id": "c8588238d99d4079e1ec6101", "id": "c970633a7f30540e71c7654b", "metadata": {"block_id": "blk_3dbbfd3fd4632ddda29a", "block_index": 143, "block_type": "paragraph", "business_module": "设备维护", "chunk_index": 143, "chunk_parse_quality_status": "parsed_with_warning", "chunk