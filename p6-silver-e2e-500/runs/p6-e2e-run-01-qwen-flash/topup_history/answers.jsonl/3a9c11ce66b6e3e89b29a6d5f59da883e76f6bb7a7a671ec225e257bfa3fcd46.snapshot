、 山区） 百 米²次 按照合同约定的 维护周期和实际 发生的维护次数 1.检查沿线塔杆以及附属设施、电缆、标牌标识。 2.清理线路杂物。"}, "keyword_score": 0.5701615994387084, "normalized_bm25_score": 0.5701615994387084, "rerank_score": null, "retrieval_score": 0.6212228621709944, "score": 0.6212228621709944, "semantic_score": 0.6431062604848313}, {"bm25_score": 19.0877868508624, "chunk": {"document_id": "c8588238d99d4079e1ec6101", "id": "2a3f286b6e5ec60a42b3c05d", "metadata": {"block_id": "blk_8c1e74cb7f219426f21e", "block_index": 235, "block_type": "paragraph", "business_module": "设备维护", "chunk_index": 235, "chunk_parse_quality_status": "parsed_with_warning", "chunk_parse_warning_codes": ["bordered_table_detected"], "content_hash": "8ae9b63d869002c1950aaf1192e44b0b876ccb9d927154f35e8c48bcd24094bb", "detected_codes": [], "document_ocr_page_count": 0, "document_ocr_status": "not_required", "document_parse_quality_status": "parsed_with_warning", "document_parse_warning_count": 7, "end_unit": 57, "error_codes": [], "extension": ".pdf", "filename": "电信基础设施维护规程.pdf", "governance_source": "default_curated_policy", "heading_path": ["电信基础设施维护规程", "第236页"], "knowledge_status": "approved", "media_type": "pdf", "next_block_id": "blk_c6537a764c96e14bb01c", "page_number": 236, "page_warning_codes": ["bordered_table_detected"], "parent_block_id": "blk_faed13d92e4fd340e29b", "parser_name": "pdf", "parser_strategy": "pymupdf_text_with_page_quality_report", "parser_version": "document-parser-v7", "permission_tags": ["public"], "previous_block_id": "blk_faed13d92e4fd340e29b", "review_status": "approved", "section_path": ["电信基础设施维护规程", "第236页"], "section_title": "第236页", "source": "电信基础设施维护规程.pdf", "source_block_ids": ["blk_8c1e74cb7f219426f21e"], "source_path": "/app/data/电信基础设施维护规程.pdf", "source_type": "manual", "split_index": 0, "start_unit": 0, "table_parse_applied": false, "table_parse_skip_reason": "block_type_is_paragraph", "table_parse_status": "skipped", "table_parser_route": "deepdoc", "tenant_id": "default", "title": "电信基础设施维护规程", "versi