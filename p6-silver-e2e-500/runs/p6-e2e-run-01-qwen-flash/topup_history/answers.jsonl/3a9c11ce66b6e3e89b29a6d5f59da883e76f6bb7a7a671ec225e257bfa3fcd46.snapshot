aaf87e2", "parser_name": "pdf", "parser_strategy": "pymupdf_text_with_page_quality_report", "parser_version": "document-parser-v7", "permission_tags": ["public"], "previous_block_id": "blk_1ba9d238a2817aaf87e2", "review_status": "approved", "section_path": ["电信基础设施维护规程", "第345页"], "section_title": "第345页", "source": "电信基础设施维护规程.pdf", "source_block_ids": ["blk_6fdc580ea7ee592dcec4"], "source_path": "/app/data/电信基础设施维护规程.pdf", "source_type": "manual", "split_index": 0, "start_unit": 0, "table_parse_applied": false, "table_parse_skip_reason": "block_type_is_paragraph", "table_parse_status": "skipped", "table_parser_route": "deepdoc", "tenant_id": "default", "title": "电信基础设施维护规程", "version_id": "v_8ae9b63d869002c1"}, "text": "章节：电信基础设施维护规程 > 第345页 页码：345 T/CAICI XXXX—XXXX 339 4）D.0.4 直埋光缆与其它建筑物及地下管线间最小净距： 表 D.0.4 直埋光缆与其它建筑物及地下管线间最小净距表 名称 平行时 交越时 通信管道边线（不包括人手孔） 0.75 0.25 非同沟的直埋通信光（电）缆 0.5 0.25 埋式电力电缆（交流35KV以下） 0.5 0.5 埋式电力电缆（交流36KV及以上） 2 0.5 给水管（管径小于300mm) 0.5 0.5 给水管（管径大于300mm～500mm) 1 0.5 给水管（管径大于500mm) 1.5 0.5 高压油管、天然气管 10 0.5 热力、排水管 1 0.5 燃气管（压力小于300KPa) 1 0.5 燃气管（压力300KPa及以上) 2 0.5 其他通信线路 0.5 - 排水沟 0.8 0.5 房屋建筑红线或基础 1 - 树木（市内、村镇大村、果树、行道树） 0.75 - 树木（市外大树） 2 - 水井、坟墓 3 - 粪坑、积肥池、沼气池、氨水池等 3 - 架空杆路及拉线 1.5 -"}, "keyword_score": 0.2918527231569375, "normalized_bm25_score": 0.2918527231569375, "rerank_score": null, "retrieval_score": 0.5843443902121603, "score": 0.5843443902121603, "semantic_score": 0.709697961807256}, {"bm25_score": 25.12458738509622, "chunk": {"document_id": "c8588238d99d4079e1ec6101", "id": "2e289f86a0a6e0c5054978fa", "metadata": {"block_id": "blk_a8df9eb65d473f945163", "block_index": 341, "block_type": "paragraph", "business_module": "通用知识", "chunk_index": 341, "chunk_parse_quality_status": "parsed_with_warning", "chunk_parse_warning_codes": ["table_like_text_detected"], "content_hash": "8ae9b63d869002c1950aaf1192e44b0b876ccb9d927154f35e8c48bcd24094bb", "detected_codes": [], "document_ocr_page_count": 0, "document_ocr_status": "not_required", "document_parse_quality_status": "parsed_with_warning", "document_parse_warning_count": 7, "end_unit": 131, "error_codes": [], "extension": ".pdf", "filename": "电信基础设施维护规程.pdf", "governance_source": "default_curated_policy", "heading_path": ["电信基础设施维护规程", "第342页"], "knowledge_status": "approved", "media_type": "pdf", "next_block_id": "blk_e0c89cc6f3b2d520d0e8", "page_number": 342, "page_warning_codes": ["table_like_text_detected"], "parent_block_id": "blk_9144e930802d6a8f5355", "parser_name": "pdf", "parser_strategy": "pymupdf_text_with_page_quality_report", "parser_version": "document-parser-v7", "permission_tags": ["public"], "previous_block_id": "blk_9144e930802d6a8f5355", "review_status": "approved", "section_path": ["电信基础设施维护规程", "第342页"], "section_title": "第342页", "source": "电信基础设施维护规程.pdf", "source_block_ids": ["blk_a8df9eb65d473f945163"], "source_path": "/app/data/电信基础设施维护规程.pdf", "source_type": "manual", "split_index": 0, "start_unit": 0, "table_parse_applied": false, "table_parse_skip_reason": "block_type_is_paragraph", "table_parse_status": "skipped", "table_parser_route": "deepdoc", "tenant_id": "default", "title": "电信基础设施维护规程", "version_id": "v_8ae9b63d869002c1"}, "text": "章节：电信基础设施维护规程 > 第342页\n页码：342\nT/CAICI XXXX—XXXX\n336\n表格列：附；录；D\n（规范性）\n信息通信光缆线路维护主要验收标准\n\n1）D.0.1 杆路与其他设施最小水平净距表：\n表 D.0.1 杆路与其他设施最小水平净距表"}, "keyword_score": 0.2060947711924416, "normalized_bm25_score": 0.2060947711924416, "rerank_score": null, "retrieval_score": 0.5119269488889782, "score": 0.5119269488889782, "semantic_score": 0.6429978821874939}]}
{"answer": "1. 直埋光缆与管径大于500mm的给水管交越时，最小净距为0.5米。[1]  \n2. 该数据来源于《电信基础设施维护规程》表D.0.4。[1]  \n3. 交越时净距要求统一为0.5米，与管径大小无关。[1]  \n4. 平行时最小净距为1.5米，交越时为0.5米。[1]  \n5. 此标准适用于直埋光缆与其他地下管线交越情况。[1]", "case_id": "p6s-0276", "question": "直埋光缆与管径大于500mm的给水管交越时，最小净距是多少？", "sources": [{"bm25_score": 97.04883037801345, "chunk": {"document_id": "c8588238d99d4079e1ec6101", "id": "fc09e131509365839af6116b", "metadata": {"block_id": "blk_6fdc580ea7ee592dcec4", "block_index": 344, "block_type": "paragraph", "business_module": "通用知识", "chunk_index": 344, "chunk_parse_quality_status": "parsed_with_warning", "chunk_parse_warning_codes": ["bordered_table_detected"], "content_hash": "8ae9b63d869002c1950aaf1192e44b0b876ccb9d927154f35e8c48bcd24094bb", "detected_codes": [], "document_ocr_page_count": 0, "document_ocr_status": "not_required", "document_parse_quality_status": "parsed_with_warning", "document_parse_warning_count": 7, "end_unit": 72, "error_codes": [], "extension": ".pdf", "filename": "电信基础设施维护规程.pdf", "governance_source": "default_curated_policy", "heading_path": ["电信基础设施维护规程", "第345页"], "knowledge_status": "approved", "media_type": "pdf", "next_block_id": "blk_123605f020da8241e04a", "page_number": 345, "page_warning_codes": ["bordered_table_detected"], "parent_block_id": "blk_1ba9d238a2817aaf87e2", "parser_name": "pdf", "parser_strategy": "pymupdf_text_with_page_quality_report", "parser_version": "document-parser-v7", "permission_tags": ["public"], "previous_block_id": "blk_1ba9d238a2817aaf87e2", "review_status": "approved", "section_path": ["电信基础设施维护规程", "第345页"], "section_title": "第345页", "source": "电信基础设施维护规程.pdf", "source_block_ids": ["blk_6fdc580ea7ee592dcec4"], "source_path": "/app/data/电信基础设施维护规程.pdf", "source_type": "manual", "split_index": 0, "start_unit": 0, "table_parse_applied": false, "table_parse_skip_reason": "block_type_is_paragraph", "table_parse_status": "skipped", "table_parser_route": "deepdoc", "tenant_id": "default", "title": "电信基础设施维护规程", "version_id": "v_8ae9b6