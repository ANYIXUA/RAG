2649c831c0ba910"], "source_path": "/app/data/电信基础设施维护规程.pdf", "source_type": "manual", "split_index": 0, "start_unit": 0, "table_parse_applied": false, "table_parse_skip_reason": "block_type_is_paragraph", "table_parse_status": "skipped", "table_parser_route": "deepdoc", "tenant_id": "default", "title": "电信基础设施维护规程", "version_id": "v_8ae9b63d869002c1"}, "text": "章节：电信基础设施维护规程 > 第173页 页码：173 T/CAICI XXXX—XXXX 167 10.2 信息通信光缆线路维护工作量清单项目综合单价指标 10.2.1 信息通信光缆线路日常维护项目综合单价指标 表10.2.1.1 WH11101 架空光缆线路徒步巡回 工作内容：徒步沿线巡回，检查拉线是否生锈、电杆是否正立、有无塌方、吊线垂度是否符合要求、挂钩有无脱落、宣传牌、标志牌、警示牌是否歪斜或缺漏、 沿线重点部位保护是否到位、沿线有无外力施工影响线路安全等；做好巡查记录，并将发现的问题及时上报等。 计量单位：千米²次 维护分项作业 项目编码 项目名称 综合单价 （元） 其中 名称 人工 人工费(元) 企业管理费(元) 利润(元) 技工 普工 单位 工日 单价(元) 114.00 61.00 WH11001001 架空光缆线路徒步巡回 平原 66.01 44.79 12.27 8.96 消耗量 0.39 — WH11001002 丘陵、城市 79.22 53.74 14.73 10.75 0.47 — WH11001003 山区 99.02 67.18 18.41 13.44 0.59 —"}, "keyword_score": 0.6607929011207945, "normalized_bm25_score": 0.6607929011207945, "rerank_score": null, "retrieval_score": 0.6904588617224734, "score": 0.6904588617224734, "semantic_score": 0.7031728448374788}, {"bm25_score": 53.84591728192899, "chunk": {"document_id": "c8588238d99d4079e1ec6101", "id": "b5b58e3e4548ba852371e3a8", "metadata": {"block_id": "blk_28e3f09af578b7c9d104", "block_index": 122, "block_type": "paragraph", "business_module": "通用知识", "chunk_index": 122, "chunk_parse_quality_status": "parsed_with_warning", "chunk_parse_warning_codes": ["bordered_table_detected"], "content_hash": "8ae9b63d869002c1950aaf1192e44b0b876ccb9d927154f35e8c48bcd24094bb", "detected_codes": [], "document_ocr_page_count": 0, "document_ocr_status": "not_required", "document_parse_quality_status": "parsed_with_warning", "document_parse_warning_count": 7, "end_unit": 148, "error_codes": [], "extension": ".pdf", "filename": "电信基础设施维护规程.pdf", "governance_source": "default_curated_policy", "heading_path": ["电信基础设施维护规程", "第123页"], "knowledge_status": "approved", "media_type": "pdf", "next_block_id": "blk_3f3781525a23688be721", "page_number": 123, "page_warning_codes": ["bordered_table_detected"], "parent_block_id": "blk_cb2080c77055e703a491", "parser_name": "pdf", "parser_strategy": "pymupdf_text_with_page_quality_report", "parser_version": "document-parser-v7", "permission_tags": ["public"], "previous_block_id": "blk_cb2080c77055e703a491", "review_status": "approved", "section_path": ["电信基础设施维护规程", "第123页"], "section_title": "第123页", "source": "电信基础设施维护规程.pdf", "source_block_ids": ["blk_28e3f09af578b7c9d104"], "source_path": "/app/data/电信基础设施维护规程.pdf", "source_type": "manual", "split_index": 0, "start_unit": 0, "table_parse_applied": false, "table_parse_skip_reason": "block_type_is_paragraph", "table_parse_status": "skipped", "table_parser_route": "deepdoc", "tenant_id": "default", "title": "电信基础设施维护规程", "version_id": "v_8ae9b63d869002c1"}, "text": "章节：电信基础设施维护规程 > 第123页 页码：123 T/CAICI XXXX—XXXX 117 8.6 专业项目维护工作量清单项目和计算规则 8.6.1 信息通信光缆线路维护工作量清单项目和计算规则（ 编码 WH10000 ） 8.6.1.1 信息通信光缆线路日常维护项目 信息通信光缆线路日常维护项目。维护工作量清单项目设置及工作量计算规则，应按表8.6.1.1 的规 定执行。 表8.6.1.1 信息通信光缆线路日常维护（编码：WH11） 项目编 码 维护分 项作业 名称 项目特征 计量单 位 维护工作量计算 规则 维护工作（操作）内容 WH11001 架空光 缆线路 徒步巡 回 地貌（平原、 丘陵、城区、 山区） 千 米²次 按照合同约定的 维护周期和实际 发生的维护次数 计算 1、 徒步沿线巡回 2、 检查拉线是否生锈、电杆是否正立、有无塌方、吊 线垂度是否符合要求、挂钩有无脱落、宣传牌、标 志牌、警示牌是否歪斜或缺漏、沿线重点部位保护 是否到位、沿线有无外力施工影响线路安全等 3、 做好巡查记录，并将发现的问题及时上报。 WH11002 架空光 缆线路 车辆巡 回 地貌（平原、 丘陵、山区、 城区） 千 米²次 按照合同约定的 维护周期和实际 发生的维护次数 计算 1、 检查电杆是否倒塌、吊线垂度是否有明显变化、警 示牌是否歪斜、沿线有无外力施工等影响到线路安 全的行为。 2、 做好巡查记录，并将发现的问题及时上报。 WH11003 直埋光 缆线路 徒步巡 回 地貌（平原、 丘陵、城区、 山区） 千 米²次 按照合同约定的 维护周期和实际 发生的维护次数 计算 1、 徒步沿线巡回 2、 检查沿线标石、宣传牌、标志牌、警示牌是否歪斜 或缺漏 3、 沿线光缆保护措施（沟坎、堵塞、护坡、漫水坝、 挡水墙等是否损坏，沿线重点部位保护是否到位， 沿线有无外力施工等影响线路安全的行为，沿线是 否发生鼠害、蚁害等对线路构成威胁的情况） 4、 做好巡查记录，并将发现的问题及时上报。 WH11004 直埋光 缆线路 车辆巡 回 地貌（平原、 丘陵、山区、 城区） 千 米²次 按照合同约定的 维护周期和实际 发生的维护次数 计算 1、 检查沿线标石、宣传牌、标志牌、警示牌是否歪斜 或缺漏 2、 沿线光缆保护措施（沟坎、堵塞、护坡、漫水坝、 挡水墙等是否损坏，沿线重点部位保护是否到位， 沿线有无外力施工影响线路安全等 3、 做好巡查记录，并将发现的问题及时上报。 WH11005 管道光 缆线路 徒步巡 回 千 米²次 按照合同约定的 维护周期和实际 发生的维护次数 计算 1、 查看管道或人孔是否有沉陷、破损、井盖丢失等情 况 2、 路由探测 3、 做好巡查记录，并将发现的问题及时上报。 4、 检查沿线重点部位保护是否到位，沿线有无外力施 工等影响线路安全的行为，沿线是否发生鼠害、蚁 害等对线路构成威胁的情况 5、 做好巡查记录，并将发现的问题及时上报。"}, "keyword_score": 0.7042263487455193, "normalized_bm25_score": 0.7042263487455193, "rerank_score": null, "retrieval_score": 0.654879469475153, "score": 0.654879469475153, "semantic_score": 0.6337308069307104}, {"bm25_score": 45.783844146288686, "chunk": {"document_id": "c8588238d99d4079e1ec6101", "id": "9832f94c5c169b4751480ff2", "metadata": {"block_id": "blk_04c89d14ae2ae07179d0", "block_index": 175, "block_type": "paragraph", "business_module": "通用知识", "chunk_index": 175, "chunk_parse_quality_status": "parsed_with_warning", "chunk_parse_warning_codes": ["bordered_table_detected", "semi_structured_table_detected"], "content_hash": "8ae9b63d869002c1950aaf1192e44b0b876ccb9d927154f35e8c48bcd24094bb", "detected_codes": [], "document_ocr_page_count": 0, "document_ocr_status": "not_required", "document_parse_quality_status": "parsed_with_warning", "document_parse_warning_count": 7, "end_unit": 58, "error_codes": [], "extension": ".pdf", "filename": "电信基础设施维护规程.pdf", "governance_source": "default_curated_policy", "heading_path": ["电信基础设施维护规程", "第176页"], "knowledge_status": "approved", "media_type": "pdf", "next_block_id": "blk_903b982cfd3ac498a79a", "page_number": 176, "page_warning_codes": ["bordered_table_detected", "semi_structured_table_detected"], "parent_block_id": "blk_54252ce0967a6e6ff776", "parser_name": "pdf", "parser_strategy": "pymupdf_text_with_page_quality_report", "parser_version": "document-parser-v7", "permission_tags": ["public"], "previous_block_id": "blk_54252ce0967a6e6ff776", "review_status": "approved", "section_path": ["电信基础设施维护规程", "第176页"], "section_title": "第176页", "source": "电信基础设施维护规程.pdf", "source_block_ids": ["blk_04c89d14ae2ae07179d0"], "source_path": "/app/data/电信基础设施维护规程.pdf", "source_type": "manual", "split_index": 0, "start_unit": 0, "table_parse_applied": false, "table_parse_skip_reason": "block_type_is_paragraph", "table_parse_status": "skipped", "table_parser_route": "deepdoc", "tenant_id": "default", "title": "电信基础设施维护规程", "version_id": "v_8ae9b63d869002c1"}, "text": "章节：电信基础设施维护规程 > 第176页 页码：176 T/CAICI XXXX—XXXX 170 表10.2.1.4 WH11004 直埋光缆线路车辆巡回 工作内容：检查沿线标石、宣传牌、标志牌、警示牌是否歪斜或缺漏，沿线光缆保护措施（沟坎、堵塞、护坡、漫水坝、挡水墙等）是否损坏，沿线重点部位 保护是否到位，沿线有无外力施工影响线路安全等；做好巡查记录，并将发现的问题及时上报等。 计量单位：千米²次 维护分项作业 项目编码 项目名称 综合单价 （元） 其中 名称 人工 人工费(元) 企业管理费(元) 利润(元) 技工 普工 单位 工日 单价(元) 114.00 61.00 WH11004001 直埋光缆线路车辆巡回 平原、丘陵 24.01 16.29 4.46 3.26 消耗量 0.14 — WH11004002 山区 36.01 24.43 6.69 4.89 0.21 — WH11004003 城区 28.81 19.54 5.35 3.91 0.17 — 注：直埋硅芯管道及光缆视同直埋光缆，按直埋光缆条目取费。"}, "keyword_score": 0.5987861479981782, "normalized_bm25_score": 0.5987861479981782, "rerank_score": null, "retrieval_score": 0.6301482685413633, "score": 0.6301482685413633, "semantic_score": 0.6435891773455856}]}
{"answer": "1. 架空光缆线路徒步巡回在平原地区综合单价为66.01元/千米²次。[1]  \n2. 直埋光缆线路车辆巡回在平原地区综合单价为24.01元/千米²次。[2]  \n3. 两者计量单位均为千米²次，按维护周期和实际次数计算。[4]  \n4. 平原地区架空徒步巡回项目编码为WH11001001。[1]  \n5. 平原地区直埋车辆巡回项目编码为WH11004001。[2]", "case_id": "p6s-0173", "question": "在平原地区，若同时存在直埋光缆线路车辆巡回与架空光缆线路徒步巡回，应分别采用哪些项目单价？", "sources": [{"bm25_score": 53.49886584008296, "chunk": {"document_id": "c8588238d99d4079e1ec6101", "id": "5396ea9eec4125daa7f95045", "metadata": {"block_id": "blk_a20372649c831c0ba910", "block_index": 172, "block_type": "paragraph", "business_module": "通用知识", "chunk_index": 172, "chunk_parse_quality_status": "parsed_with_warning", "chunk_parse_warning_codes": ["bordered_table_detected"], "content_hash": "8ae9b63d869002c1950aaf1192e44b0b876ccb9d927154f35e8c48bcd24094bb", "detected_codes": [], "document_ocr_page_count": 0, "document_ocr_status": "not_required", "document_parse_quality_status": "parsed_with_warning", "document_parse_warning_count": 7, "end_unit": 61, "error_codes": [], "extension": ".pdf", "filename": "电信基础设施维护规程.pdf", "governance_source": "default_curated_policy", "heading_path": ["电信基础设施维护规程", "第173页"], "knowledge_status": "approved", "media_type": "pdf", "next_block_id": "blk_0448465a89bfa194f94a", "page_number": 173, "page_warning_codes": ["bordered_table_detected"], "parent_block_id": "blk_385d2fe67eafb43e9ff7", "parser_name": "pdf", "parser_strategy": "pymupdf_text_with_page_quality_report", "parser_version": "document-parser-v7", "permission_tags": ["public"], "previous_block_id": "blk_385d2fe67eafb43e9ff7", "review_status": "approved", "section_path": ["电信基础设施维护规程", "第173页"], "section_title": "第173页", "source": "电信基础设施维护规程.pdf", "source_block_ids": ["blk_a20372649c831c0ba910"], "source_path": "/app/data/电信基础设施维护规程.pdf", "source_type": "manual", "split_index": 0, "start_unit": 0, "table_parse_applied": false, "table_parse_skip_reason": "block_type_is_paragraph", "table_parse_status": "skipped", "table_parser_route": "deepdoc", "tenant_id": "default", "title": "电信基