b876ccb9d927154f35e8c48bcd24094bb", "detected_codes": [], "document_ocr_page_count": 0, "document_ocr_status": "not_required", "document_parse_quality_status": "parsed_with_warning", "document_parse_warning_count": 7, "end_unit": 67, "error_codes": [], "extension": ".pdf", "filename": "电信基础设施维护规程.pdf", "governance_source": "default_curated_policy", "heading_path": ["电信基础设施维护规程", "第80页"], "knowledge_status": "approved", "media_type": "pdf", "next_block_id": "blk_0e6de1f96900b72286c4", "page_number": 80, "page_warning_codes": ["bordered_table_detected"], "parent_block_id": "blk_484700a8fc7459872431", "parser_name": "pdf", "parser_strategy": "pymupdf_text_with_page_quality_report", "parser_version": "document-parser-v7", "permission_tags": ["public"], "previous_block_id": "blk_484700a8fc7459872431", "review_status": "approved", "section_path": ["电信基础设施维护规程", "第80页"], "section_title": "第80页", "source": "电信基础设施维护规程.pdf", "source_block_ids": ["blk_d71cbfb3397e3b94a3f3"], "source_path": "/app/data/电信基础设施维护规程.pdf", "source_type": "manual", "split_index": 0, "start_unit": 0, "table_parse_applied": false, "table_parse_skip_reason": "block_type_is_paragraph", "table_parse_status": "skipped", "table_parser_route": "deepdoc", "tenant_id": "default", "title": "电信基础设施维护规程", "version_id": "v_8ae9b63d869002c1"}, "text": "章节：电信基础设施维护规程 > 第80页 页码：80 T/CAICI XXXX—XXXX 74 FTTH 跳接末级分光器指定的端口 用户引入线布放和测试 ADSL 1.通过分线盒指定端口信号布放引入线到用户多媒体箱或用户指定的位置 2.测试线路通断情况 FTTB 1.从FTTB 设备指定端口布放或对接网线到用户多媒体箱或用户指定的位置 2.测试线路通断情况 FTTH 1.从末级分纤箱布放引入线到用户多媒体箱或者用户指定的位置 2.两端熔接，并插入指定资源端口 3.测试线路通断及衰耗情况 信息点线路调测 室内线 从MODEM 到用户业务安装位置的线路测试。 设备安装和调测 安装 把设备和用户家中的线路进行连接 调试 对用户开通的业务进行调试 演示与交付 演示 用户开通的业务演示与讲解 交付 按照装维规范交付相关内容 表7.5.0.2 宽带维护内容与要求 维护对象 维护周期 作业内容 光分纤箱 箱体检查 按需 1.布线要规范，插头无松动保证接触良好 2.用后随手关好门 3.盒体安装牢固、盒盖完好 4.盒内清洁 分光器检查 按需 1.分光器固定在指定位置 2.分光器防尘帽齐全 线缆检查 按需 1.箱体内线缆绑扎固定符合规范 2.线缆标识齐全 光网络箱（FTTB） 按需 1.箱体完整无脱落 2.门锁完好 3.电源符合规范 铜缆双绞线 按需 1.使用年久老化的用户引入线进行更换 2.保证用户引入线的接头良好 3.架设高度及三线交越的间距符合要求 皮线光缆 按需"}, "keyword_score": 0.8240937008057989, "normalized_bm25_score": 0.8240937008057989, "rerank_score": null, "retrieval_score": 0.7048009722962819, "score": 0.7048009722962819, "semantic_score": 0.6536755172207748}]}
{"answer": "1. 更换吊线保护装置技工人工费为16.67元/米。[2]  \n2. 安装电杆地线（拉线式）技工人工费为10.53元/条。[3]  \n3. 直埋式电杆地线技工人工费为42.35元/条。[3]  \n4. 延伸式电杆地线技工人工费为58.45元/条。[3]  \n5. 以上费用均基于综合单价中技工人工费明细。[2][3]", "case_id": "p6s-0217", "question": "更换吊线保护装置和安装电杆地线的综合单价中，技工人工费分别是多少？", "sources": [{"bm25_score": 53.05398958329837, "chunk": {"document_id": "c8588238d99d4079e1ec6101", "id": "74207e88e3fcb93a6e60028b", "metadata": {"block_id": "blk_64d79e1cf185aff79478", "block_index": 127, "block_type": "paragraph", "business_module": "通用知识", "chunk_index": 127, "chunk_parse_quality_status": "parsed_with_warning", "chunk_parse_warning_codes": ["bordered_table_detected"], "content_hash": "8ae9b63d869002c1950aaf1192e44b0b876ccb9d927154f35e8c48bcd24094bb", "detected_codes": [], "document_ocr_page_count": 0, "document_ocr_status": "not_required", "document_parse_quality_status": "parsed_with_warning", "document_parse_warning_count": 7, "end_unit": 104, "error_codes": [], "extension": ".pdf", "filename": "电信基础设施维护规程.pdf", "governance_source": "default_curated_policy", "heading_path": ["电信基础设施维护规程", "第128页"], "knowledge_status": "approved", "media_type": "pdf", "next_block_id": "blk_1601eacdb0854f3bb8de", "page_number": 128, "page_warning_codes": ["bordered_table_detected"], "parent_block_id": "blk_2bc86a72dc850c513de7", "parser_name": "pdf", "parser_strategy": "pymupdf_text_with_page_quality_report", "parser_version": "document-parser-v7", "permission_tags": ["public"], "previous_block_id": "blk_2bc86a72dc850c513de7", "review_status": "approved", "section_path": ["电信基础设施维护规程", "第128页"], "section_title": "第128页", "source": "电信基础设施维护规程.pdf", "source_block_ids": ["blk_64d79e1cf185aff79478"], "source_path": "/app/data/电信基础设施维护规程.pdf", "source_type": "manual", "split_index": 0, "start_unit": 0, "table_parse_applied": false, "table_parse_skip_reason": "block_type_is_paragraph", "table_parse_status": "skipped", "table_parser_route": "deepdoc", "tenant_id": "default", "title": "电信基础设施维护规程", "version_id": "v_8ae9b63d86