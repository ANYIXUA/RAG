"], "content_hash": "ab72ce00c904f060e1a60edb2af37b98f35cb9464f510e1022e29c657a94cf99", "detected_codes": [], "document_ocr_page_count": 0, "document_ocr_status": "not_required", "document_parse_quality_status": "parsed_with_warning", "document_parse_warning_count": 6, "end_unit": 42, "error_codes": [], "extension": ".pdf", "filename": "中国移动智慧家庭全光组网产品技术规范V2.0.0.pdf", "governance_source": "default_curated_policy", "heading_path": ["中国移动智慧家庭全光组网产品技术规范V2.0.0", "第61页"], "knowledge_status": "approved", "media_type": "pdf", "next_block_id": "blk_064e0f6da6396f3bb0f4", "page_number": 61, "page_warning_codes": ["table_like_text_detected", "semi_structured_table_detected"], "parent_block_id": "blk_c4b3e58e5ce3e156f087", "parser_name": "pdf", "parser_strategy": "pymupdf_text_with_page_quality_report", "parser_version": "document-parser-v7", "permission_tags": ["public"], "previous_block_id": "blk_c4b3e58e5ce3e156f087", "review_status": "approved", "section_path": ["中国移动智慧家庭全光组网产品技术规范V2.0.0", "第61页"], "section_title": "第61页", "source": "中国移动智慧家庭全光组网产品技术规范V2.0.0.pdf", "source_block_ids": ["blk_0e9f34a5017e65493591"], "source_path": "/app/data/中国移动智慧家庭全光组网产品技术规范V2.0.0.pdf", "source_type": "manual", "split_index": 0, "start_unit": 0, "table_parse_applied": false, "table_parse_skip_reason": "block_type_is_paragraph", "table_parse_status": "skipped", "table_parser_route": "deepdoc", "tenant_id": "default", "title": "中国移动智慧家庭全光组网产品技术规范V2.0.0", "version_id": "v_ab72ce00c904f060"}, "text": "章节：中国移动智慧家庭全光组网产品技术规范V2.0.0 > 第61页 页码：61 56 A.2 光路由终端二维码标识要求 二维码内容： （1）ssid1：设备的Wi-Fi名称，需与设备背面板的“默认无线网络名称”一致，一般 使用2.4G的SSID； （2）wifipwd：设备的Wi-Fi密码，需与设备背面板的“默认无线网络密钥”一致； （3）username：用户帐号，需与设备背面板的“默认终端配置帐号”一致；注：如 果此设备只使用密码登录，则username可填写空值； （4）userpwd：用户密码，需与设备背面板的“默认终端配置密码”一致； （5）productname: 产品名称码，2位阿拉伯数字； （6）mac：全光组网终端MAC地址； （7）sn：全光组网终端的SN； （8）cmei: 全光组网终端的CMEI号，具体编码规则请参考《中国移动非蜂窝类智能 硬件产品统一编码规范》； （9）ip：终端配置地址，如192.168.10.1，需与设备背面板的“默认终端配置地址” 一致; （10）vendor：全光组网终端合作伙伴名称，使用智家中心分配的厂商编码； （11）model：全光组网终端的产品型号，使用智家中心分配的型号编码。 （12）date：智能设备生产日期，6字节，格式xxxxxx，前4字节表示年，后2字节表示 月，例如：201901表示2019年1月。 二维码内容格式要求： 二维码内容所有符号为英文半角；用“&”把所有字段连起来，“&”左右无空格。 【实例】 ssid1=CMCC-xxx(无线网络名称)&wifipwd=xxx(无线网络密钥)&username=xxx（终端 配置帐号）&userpwd=xxx(终端配置密码)&ip=192.168.10.1&productname=xxx(产品名称 码)& mac=xxx( 终端MAC 地址)&sn=xxx( 终端的SN)&cmei=xxx( 终端的CMEI)& vendor=xxx(合作伙伴名称)&model=xxx(产品型号)&date=xxx(生产日期) 表格列：3.；二维码要求： （1）颜色：黑色； （2）黏贴位置：组网终端背面；"}, "keyword_score": 0.45090107773575555, "normalized_bm25_score": 0.45090107773575555, "rerank_score": null, "retrieval_score": 0.493975045248372, "score": 0.493975045248372, "semantic_score": 0.5124353170394934}, {"bm25_score": 18.157076962689374, "chunk": {"document_id": "a2053ec18f1415e4912c510f", "id": "0b2bc61ba6e04bf37c779232", "metadata": {"block_id": "blk_11cf8226430943edf8b4", "block_index": 48, "block_type": "paragraph", "business_module": "地址校验", "chunk_index": 48, "chunk_parse_quality_status": "parsed_with_warning", "chunk_parse_warning_codes": [], "content_hash": "ab72ce00c904f060e1a60edb2af37b98f35cb9464f510e1022e29c657a94cf99", "detected_codes": [], "document_ocr_page_count": 0, "document_ocr_status": "not_required", "document_parse_quality_status": "parsed_with_warning", "document_parse_warning_count": 6, "end_unit": 48, "error_codes": [], "extension": ".pdf", "filename": "中国移动智慧家庭全光组网产品技术规范V2.0.0.pdf", "governance_source": "default_curated_policy", "heading_path": ["中国移动智慧家庭全光组网产品技术规范V2.0.0", "第49页"], "knowledge_status": "approved", "media_type": "pdf", "next_block_id": "blk_3165e05117262b0d1b5f", "page_number": 49, "page_warning_codes": [], "parent_block_id": "blk_57333f6c13c3453fc15b", "parser_name": "pdf", "parser_strategy": "pymupdf_text_with_page_quality_report", "parser_version": "document-parser-v7", "permission_tags": ["public"], "previous_block_id": "blk_57333f6c13c3453fc15b", "review_status": "approved", "section_path": ["中国移动智慧家庭全光组网产品技术规范V2.0.0", "第49页"], "section_title": "第49页", "source": "中国移动智慧家庭全光组网产品技术规范V2.0.0.pdf", "source_block_ids": ["blk_11cf8226430943edf8b4"], "source_path": "/app/data/中国移动智慧家庭全光组网产品技术规范V2.0.0.pdf", "source_type": "manual", "split_index": 0, "start_unit": 0, "table_parse_applied": false, "table_parse_skip_reason": "block_type_is_paragraph", "table_parse_status": "skipped", "table_parser_route": "deepdoc", "tenant_id": "default", "title": "中国移动智慧家庭全光组网产品技术规范V2.0.0", "version_id": "v_ab72ce00c904f060"}, "text": "章节：中国移动智慧家庭全光组网产品技术规范V2.0.0 > 第49页 页码：49 44 （2） 本地管理地址（光网关要求为192.168.1.1，统一域名：https://cmcc.wifi/及 http://cmcc.wifi）、光网关终端须具备用户账号及密码、无线SSID名称及密码。 （3） 光网关还需具备PPPoE拨号零配置二维码标签贴纸。 （4） 和家亲APP下载地址二维码标签贴纸。 说明： （1）光网关铭牌需包含管理地址及管理域名；光路由铭牌需包含管理域名信息。 （2）光网关需支持零配置功能，零配置二维码要求见附录A.1，光路由无需支持零配 置功能。光路由需搭载具备终端信息的二维码标签贴纸，贴纸内容见附录 A.2。 （3）Web登录界面应包含以下信息： ①中国移动标识； ②和家亲APP下载二维码； 4.6.4.2. 设备外壳文字标识要求 全光组网终端表面应有相关的端口、按钮、电源接口标识信息，并应和相关指示灯的 标识一致。 4.7. 室内光网组件要求 4.7.1. 光缆要求 室内光缆用于光网关与分光器或分光器与光路由之间的连接，应符合ITU G.657B3或 ITU G.657A2技术要求，包括：蝶形光缆和隐形光缆，优选隐形光缆。 4.7.2. 蝶形光缆 蝶形光缆应符合YD/T 1997.1相关要求； 4.7.3. 透明光缆 ⚫ 光纤应符合ITU G.657A2 技术要求； ⚫ 光缆可承受100N，1min 拉力不拉断； ⚫ 光缆表皮自带胶，可通过施工工具自粘在墙体表面（乳胶漆、木板、墙纸），连 续粘接不易脱落；"}, "keyword_score": 0.6245243043281166, "normalized_bm25_score": 0.6245243043281166, "rerank_score": null, "retrieval_score": 0.47837108291998887, "score": 0.47837108291998887, "semantic_score": 0.4157339880307913}, {"bm25_score": 14.458218677310613, "chunk": {"document_id": "a2053ec18f1415e4912c510f", "id": "3a3f2c0bc27d1815ea693a4a", "metadata": {"block_id": "blk_e3bc5306109b03034777", "block_index": 59, "block_type": "paragraph", "business_module": "设备维护", "chunk_index": 59, "chunk_parse_quality_status": "parsed_with_warning", "chunk_parse_warning_codes": [], "content_hash": "ab72ce00c904f060e1a60edb2af37b98f35cb9464f510e1022e29c657a94cf99", "detected_codes": [], "document_ocr_page_count": 0, "document_ocr_status": "not_required", "document_parse_quality_status": "parsed_with_warning", "document_parse_warning_count": 6, "end_unit": 285, "error_codes": [], "extension": ".pdf", "filename": "中国移动智慧家庭全光组网产品技术规范V2.0.0.pdf", "governance_source": "default_curated_policy", "heading_path": ["中国移动智慧家庭全光组网产品技术规范V2.0.0", "第60页"], "knowledge_status": "approved", "media_type": "pdf", "next_block_id": "blk_c4b3e58e5ce3e156f087", "page_number": 60, "page_warning_codes": [], "parent_block_id": "blk_be75cf4df344a45df211", "parser_name": "pdf", "parser_strategy": "pymupdf_text_with_page_quality_report", "parser_version": "document-parser-v7", "permission_tags": ["public"], "previous_block_id": "blk_be75cf4df344a45df211", "review_status": "approved", "section_path": ["中国移动智慧家庭全光组网产品技术规范V2.0.0", "第60页"], "section_title": "第60页", "source": "中国移动智慧家庭全光组网产品技术规范V2.0.0.pdf", "source_block_ids": ["blk_e3bc5306109b03034777"], "source_path": "/app/data/中国移动智慧家庭全光组网产品技术规范V2.0.0.pdf", "source_type": "manual", "split_index": 0, "start_unit": 0, "table_parse_applied": false, "table_parse_skip_reason": "block_type_is_paragraph", "table_parse_status": "skipped", "table_parser_route": "deepdoc", "tenant_id": "default", "title": "中国移动智慧家庭全光组网产品技术规范V2.0.0", "version_id": "v_ab72ce00c904f060"}, "text": "章节：中国移动智慧家庭全光组网产品技术规范V2.0.0 > 第60页\n页码：60\n55\n附录 A 组网终端相关二维码标识要求\nA.1 光网关零配置二维码标识要求\n光网关终端应支持通过二维码实现放装零配置功能，在设备上展示张贴二维码标识，\n二维码应集成该设备的Wi-Fi 的SSID 和密码参数，具备扫码直接连接该台设备Wi-Fi 并\n进行POST 配置的功能，且光网关终端应支持依据是否已连接互联网决定是否进行PPPoE\n拨号。光网关零配置要求详见《中国移动智能家庭网关技术规范》，其中“model”字段\n推荐采用“FTTR-Wi-Fi6”或“FTTR-Wi-Fi7”。"}, "keyword_score": 0.4972997019192988, "normalized_bm25_score": 0.4972997019192988, "rerank_score": null, "retrieval_score": 0.47385363158073646, "score": 0.47385363158073646, "semantic_score": 0.46380531572135264}], "state": "success", "timeout": false, "trace": {"answer_source": "rag", "augmented_context": "请求ID：3d2de6311bea497a89f45523ac9e7361\n会话ID：p6-e2e-run01-qwen-flash-p6s-0050-attempt1\n租户ID：未指定\n用户ID：未指定\n权限标签：未指定\n用户原始问题：二维码文字字号是多少PT？\n归一化查询：二维码文字字号是多少PT？\n是否跟进问答：否\n上下文改写查询：二维码文字字号是多少PT？\n上下文关键术语：无\n改写查询：二维码文字字号是多少PT？\n检索查询：二维码文字字号是多少PT？ 业务说明 知识库 常见问题\n同义词扩展：无\n语义扩展：业务说明, 知识库, 常见问题\n识别意图：general_knowledge\n\n会话历史摘要：\n无\n\n工具调用结果：\n无\n\n检索到的相关文档：\n[1] 来源：中国移动智慧家庭全光组网产品技术规范V2.0.0.pdf\n引用标签：[1]\n标题：第62页\n定位信息：62\n综合分：0.743550\n召回综合分：0.743550\n重排分：无\n语义分：0.633643\nBM25 原始分：29.073451\nBM25 归一化分：1.000000\n内容：章节：中国移动智慧家庭全光组网产品技术规范V2.0.0 > 第62页\n页码：62\n57\n（3）尺寸大小：不小于17×17mm（公差：±1mm)，正方形；\n（4）文字说明：“二维码”，方正兰亭，字号5.5PT，文字位置根据实际情况紧贴二\n维码的边缘线；\n（5）打印分辨率：大于300dpi；\n（6）材质要求：防水、防潮、防老化、防磨损。\n【实例】\n\n二维码\n\n[2] 来源：中国移动智慧家庭全光组网产品技术规范V2.0.0.pdf\n引用标签：[2]\n标题：第61页\n定位信息：61\n综合分：0.493975\n召回综合分：0.493975\n重排分：无\n语义分：0.512435\nBM25 原始分：13.109251\nBM25 归一化分：0.450901\n内容：章节：中国移动智慧家庭全光组网产品技术规范V2.0.0 > 第61页 页码：61 56 A.2 光路由终端二维码标识要求 二维码内容： （1）ssid1：设备的Wi-Fi名称，需与设备背面板的“默认无线网络名称”一致，一般 使用2.4G的SSID； （2）wifipwd：设备的Wi-Fi密码，需与设备背面板的“默认无线网络密钥”一致； （3）username：用户帐号，需与设备背面板的“默认终端配置帐号”一致；注：如 果此设备只使用密码登录，则username可填写空值； （4）userpwd：用户密码，需与设备背面板的“默认终端配置密码”一致； （5）productname: 产品名称码，2位阿拉伯数字； （6）mac：全光组网终端MAC地址； （7）sn：全光组网终端的SN； （8）cmei: 全光组网终端的CMEI号，具体编码规则请参考《中国移动非蜂窝类智能 硬件产品统一编码规范》； （9）ip：终端配置地址，如192.168.10.1，需与设备背面板的“默认终端配置地址” 一致; （10）vendor：全光组网终端合作伙伴名称，使用智家中心分配的厂商编码； （11）model：全光组网终端的产品型号，使用智家中心分配的型号编码。 （12）date：智能设备生产日期，6字节，格式xxxxxx，前4字节表示年，后2字节表示 月，例如：201901表示2019年1月。 二维码内容格式要求： 二维码内容所有符号为英文半角；用“&”把所有字段连起来，“&”左右无空格。 【实例】 ssid1=CMCC-xxx(无线网络名称)&wifipwd=xxx(无线网络密钥)&username=xxx（终端 配置帐号）&userpwd=xxx(终端配置密码)&ip=192.168.10.1&productname=xxx(产品名称 码)& mac=xxx( 终端MAC 地址)&sn=xxx( 终端的SN)&cmei=xxx( 终端的CMEI)& vendor=xxx(合作伙伴名称)&model=xxx(产品型号)&date=xxx(生产日期) 表格列：3.；二维码要求： （1）颜色：黑色； （2）黏贴位置：组网终端背面；\n\n[3] 来源：中国移动智慧家庭全光组网产品技术规范V2.0.0.pdf\n引用标签：[3]\n标题：第49页\n定位信息：49\n综合分：0.478371\n召回综合分：0.478371\n重排分：无\n语义分：0.415734\nBM25 原始分：18.157077\nBM25 归一化分：0.624524\n内容：章节：中国移动智慧家庭全光组网产品技术规范V2.0.0 > 第49页 页码：49 44 （2） 本地管理地址（光网关要求为192.168.1.1，统一域名：https://cmcc.wifi/及 http://cmcc.wifi）、光网关终端须具备用户账号及密码、无线SSID名称及密码。 （3） 光网关还需具备PPPoE拨号零配置二维码标签贴纸。 （4） 和家亲APP下载地址二维码标签贴纸。 说明： （1）光网关铭牌需包含管理地址及管理域名；光路由铭牌需包含管理域名信息。 （2）光网关需支持零配置功能，零配置二维码要求见附录A.1，光路由无需支持零配 置功能。光路由需搭载具备终端信息的二维码标签贴纸，贴纸内容见附录 A.2。 （3）Web登录界面应包含以下信息： ①中国移动标识； ②和家亲APP下载二维码； 4.6.4.2. 设备外壳文字标识要求 全光组网终端表面应有相关的端口、按钮、电源接口标识信息，并应和相关指示灯的 标识一致。 4.7. 室内光网组件要求 4.7.1. 光缆要求 室内光缆用于光网关与分光器或分光器与光路由之间的连接，应符合ITU G.657B3或 ITU G.657A2技术要求，包括：蝶形光缆和隐形光缆，优选隐形光缆。 4.7.2. 蝶形光缆 蝶形光缆应符合YD/T 1997.1相关要求； 4.7.3. 透明光缆 ⚫ 光纤应符合ITU G.657A2 技术要求； ⚫ 光缆可承受100N，1min 拉力不拉断； ⚫ 光缆表皮自带胶，可通过施工工具自粘在墙体表面（乳胶漆、木板、墙纸），连 续粘接不易脱落；\n\n[4] 来源：中国移动智慧家庭全光组网产品技术规范V2.0.0.pdf\n引用标签：[4]\n标题：第60页\n定位信息：60\n综合分：0.473854\n召回综合分：0.473854\n重排分：无\n语义分：0.463805\nBM25 原始分：14.458219\nBM25 归一化分：0.497300\n内容：章节：中国移动智慧家庭全光组网产品技术规范V2.0.0 > 第60页\n页码：60\n55\n附录 A 组网终端相关二维码标识要求\nA.1 光网关零配置二维码标识要求\n光网关终端应支持通过二维码实现放装零配置功能，在设备上展示张贴二维码标识，\n二维码应集成该设备的Wi-Fi 的SSID 和密码参数，具备扫码直接连接该台设备Wi-Fi 并\n进行POST 配置的功能，且光网关终端应支持依据是否已连接互联网决定是否进行PPPoE\n拨号。光网关零配置要求详见《中国移动智能家庭网关技术规范》，其中“model”字段\n推荐采用“FTTR-Wi-Fi6”或“FTTR-Wi-Fi7”。", "authorized_source_count": 4, "bm25_weight": 0.3, "context_latency_ms": 1.553, "context_terms": [], "contextual_query": "二维码文字字号是多少PT？", "conversation_history_turn_count": 0, "created_at": "2026-11-05T12:14:04.366277+00:00", "degradation_reason": null, "embedding_latency_ms": 152.262, "generation_latency_ms": 1013.44, "intent_confidence": 0.35, "intent_label": "general_knowledge", "intent_latency_ms": 0.058, "intent_reason": "未命中明确业务意图，按通用知识问答处理。", "is_follow_up": false, "keyword_weight": 0.3, "latency_ms": 1647.405, "min_similarity_score": 0.05, "normalized_query": "二维码文字字号是多少PT？", "original_query": "二维码文字字号是多少PT？", "override_degradation_reason": null, "override_hit": false, "override_id": null, "override_type": null, "permission_tags": [], "query_embedding_cache_hit": false, "query_embedding_dimensions": 1024, "query_rewrite_rules": [], "relative_score_threshold": 0.35, "request_id": "3d2de6311bea497a89f45523ac9e7361", "rerank_applied": false, "rerank_candidate_k": 20, "rerank_latency_ms": 0.0, "rerank_model": "none", "rerank_provider": "none", "rerank_skip_reason": "provider_disabled", "reranked_count": 4, "retrieval_candidate_k": 20, "retrieval_latency_ms": 628.735, "retrieval_mode": "hybrid", "retrieval_query": "二维码文字字号是多少PT？ 业务说明 知识库 常见问题", "retrieved_count": 4, "rewrite_latency_ms": 0.048, "rewritten_query": "二维码文字字号是多少PT？", "semantic_expansions": ["业务说明", "知识库", "常见问题"], "semantic_weight": 0.7, "session_id": "p6-e2e-run01-qwen-flash-p6s-0050-attempt1", "synonym_expansions": [], "tenant_id": null, "tool_calls": [], "top_k": 4, "user_id": null, "vector_search_latency_ms": 476.449, "vector_store_provider": "postgresql"}, "wall_seconds": 1.6760911999735981}
{"answer": "1. 全光组网终端DHCPName总长度应不超过32字节。[1]  \n2. DHCPName格式为：合作伙伴-型号-YYYY。[1]  \n3. YYYY为设备MAC后四位，不可修改。[1]  \n4. 合作伙伴及型号采用智家中心标准名称。[1]  \n5. 该要求出自《中国移动智慧家庭全光组网产品技术规范V2.0.0》。[1]", "attempt": 1, "case_id": "p6s-0051", "error": null, "finished_at": "2026-11-05T20:14:07.801445+08:00", "model_calls": [{"api_call_id": "75493c2b8d954c1a9821c4cae293e4e9", "kind": "embedding", "request": {"dimensions": 1024, "input": ["全光组网终端DHCPName总长度应不超过多少字节？ 业务说明 知识库 常见问题"], "model": "text-embedding-v4", "timeout": 3.0}, "response": {"data": [{"embedding": [-0.0028540308121591806, -0.012682287953794003, -0.037131648510694504, -0.015331598930060863, 0.05634431540966034, 0.038755640387535095, -0.015386650338768959, 0.08384210616350174, 0.010652296245098114, 0.025612303987145424, 0.019446633756160736, 0.018015317618846893, -0.005591079127043486, 0.02588755637407303, 0.0393061488866806, 0.030085166916251183, -0.024869119748473167, -0.11923965811729431, -0.04040715843439102, 0.06699661165475845, -0.011650089174509048, 0.003014021785929799, 0.0037400019355118275, -0.043820299208164215, 0.03985665366053581, 0.03352583199739456, 0.010934430174529552, 0.008925083093345165, 0.04313216730952263, 0.010624771006405354, 0.035314977169036865, -0.08758554607629776, 0.00756946112960577, -0.008704880252480507, 0.03016774356365204, 0.020919237285852432, -0.01209049392491579, 0.032534919679164886, -0.0022519147023558617, -0.04698570817708969, -0.014615940861403942, -0.02057517133653164, 0.02100181393325329, 0.01429940015077591, 0.04274681210517883, 0.020437544211745262, 0.008374576456844807, -0.08009865880012512, -0.042554132640361786, -0.026135284453630447, 0.016735389828681946, -0.04390287399291992, 0.025254474952816963, 0.045636970549821854, -0.026561927050352097, -0.0010184366255998611, -0.029507135972380638, -0.039719026535749435, -0.0032892748713493347, 0.007810307666659355, 0.02491040900349617, 0.028929103165864944, 0.02715372107923031, -0.025075560435652733, 0.013067642226815224, -0.04676550626754