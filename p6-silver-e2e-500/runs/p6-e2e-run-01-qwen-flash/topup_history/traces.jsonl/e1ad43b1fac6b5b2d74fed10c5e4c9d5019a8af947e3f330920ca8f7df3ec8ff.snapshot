ocument_parse_warning_count": 4, "end_unit": 39, "error_codes": [], "extension": ".pdf", "filename": "智慧家庭装维工程与管理职业技能等级标准.pdf", "governance_source": "default_curated_policy", "heading_path": ["智慧家庭装维工程与管理职业技能等级标准", "第9页"], "knowledge_status": "approved", "media_type": "pdf", "next_block_id": "blk_3acdfbf60b3f244896eb", "page_number": 9, "page_warning_codes": [], "parent_block_id": "blk_7cc29887c3519bb245b1", "parser_name": "pdf", "parser_strategy": "pymupdf_text_with_page_quality_report", "parser_version": "document-parser-v7", "permission_tags": ["public"], "previous_block_id": "blk_7cc29887c3519bb245b1", "review_status": "approved", "section_path": ["智慧家庭装维工程与管理职业技能等级标准", "第9页"], "section_title": "第9页", "source": "智慧家庭装维工程与管理职业技能等级标准.pdf", "source_block_ids": ["blk_9a89f1bb7cefe9455e61"], "source_path": "/app/data/智慧家庭装维工程与管理职业技能等级标准.pdf", "source_type": "manual", "split_index": 0, "start_unit": 0, "table_parse_applied": false, "table_parse_skip_reason": "block_type_is_paragraph", "table_parse_status": "skipped", "table_parser_route": "deepdoc", "tenant_id": "default", "title": "智慧家庭装维工程与管理职业技能等级标准", "version_id": "v_dcf78195a87f01f4"}, "text": "章节：智慧家庭装维工程与管理职业技能等级标准 > 第9页 页码：9 T/CAICIXXXX—XX 8 b）电子电路基础知识； c）物联网基础知识； d）通信及信息化新技术基础知识； e）矢量制图设计基础知识； f）电气照明等相关基础知识； 5.4 智能组网专业知识 智能组网专业基础知识应包括下列内容： a）综合布线知识； b）通信网络技术及光纤到户业务知识； c）无线局域网技术知识； d）视听业务技术知识； e）智能控制技术知识； f）智能组网及家庭总线（数据、视听、控制）技术知识； g）智能家居、智能家电及联网、联动技术知识 h） 家庭业务云平台及智能门户技术知识 5.5 全屋智能专业知识 全屋智能专业知识应包括下列内容： a）全屋智能综合布线知识； b）互联网、视听等（运营商业务）接入专业知识； c）家庭网络、智能组网及智能家居控制技术基础知识； d）智能单品、智能家居（本地控制）、智能家居（网关及云平台控制）及场景设置与操作知识； e）智慧家庭业务综合管理平台操作与应用知识； f）智慧家庭产品装维与故障处理知识； g）智能家电装维、联网/联动设置与操作知识。 5.6 终端和计算机知识 计算机知识应包括下列内容： a）计算机硬件基础知识； b）操作系统与办公应用软件知识； c）计算机防病毒基础知识；"}, "keyword_score": 0.7176464211085822, "normalized_bm25_score": 0.7176464211085822, "rerank_score": null, "retrieval_score": 0.6314724687081392, "score": 0.6314724687081392, "semantic_score": 0.5945407748222351}, {"bm25_score": 12.065866073920825, "chunk": {"document_id": "a2053ec18f1415e4912c510f", "id": "a7db14a3391bc332376a980d", "metadata": {"block_id": "blk_f5d5c6aad86fc6fbc683", "block_index": 28, "block_type": "paragraph", "business_module": "地址校验", "chunk_index": 28, "chunk_parse_quality_status": "parsed_with_warning", "chunk_parse_warning_codes": [], "content_hash": "ab72ce00c904f060e1a60edb2af37b98f35cb9464f510e1022e29c657a94cf99", "detected_codes": [], "document_ocr_page_count": 0, "document_ocr_status": "not_required", "document_parse_quality_status": "parsed_with_warning", "document_parse_warning_count": 6, "end_unit": 49, "error_codes": [], "extension": ".pdf", "filename": "中国移动智慧家庭全光组网产品技术规范V2.0.0.pdf", "governance_source": "default_curated_policy", "heading_path": ["中国移动智慧家庭全光组网产品技术规范V2.0.0", "第29页"], "knowledge_status": "approved", "media_type": "pdf", "next_block_id": "blk_46d0ff46a3f2976ef5dc", "page_number": 29, "page_warning_codes": [], "parent_block_id": "blk_47207fe8fee5b5ccbdb3", "parser_name": "pdf", "parser_strategy": "pymupdf_text_with_page_quality_report", "parser_version": "document-parser-v7", "permission_tags": ["public"], "previous_block_id": "blk_47207fe8fee5b5ccbdb3", "review_status": "approved", "section_path": ["中国移动智慧家庭全光组网产品技术规范V2.0.0", "第29页"], "section_title": "第29页", "source": "中国移动智慧家庭全光组网产品技术规范V2.0.0.pdf", "source_block_ids": ["blk_f5d5c6aad86fc6fbc683"], "source_path": "/app/data/中国移动智慧家庭全光组网产品技术规范V2.0.0.pdf", "source_type": "manual", "split_index": 0, "start_unit": 0, "table_parse_applied": false, "table_parse_skip_reason": "block_type_is_paragraph", "table_parse_status": "skipped", "table_parser_route": "deepdoc", "tenant_id": "default", "title": "中国移动智慧家庭全光组网产品技术规范V2.0.0", "version_id": "v_ab72ce00c904f060"}, "text": "章节：中国移动智慧家庭全光组网产品技术规范V2.0.0 > 第29页 页码：29 24 4.3.10.3. 教育加速功能 光网关需具备场景化宽带教育加速功能，即具备针对场景化宽带平台下发特定应用的 网络策略进行专用通道转发能力。场景化宽带平台基于此功能实现网络智能加速，解决用 户访问海外教育网站时网络卡顿、加载慢、掉线等问题，为海外教育用户提供更快、更稳 定的家庭网络服务。 场景化宽带具体功能详见《中国移动智慧家庭全光组网产品入库接口规范》7.5章节。 4.3.11. 地址预置要求 4.3.11.1. 省平台地址预置要求 全光组网终端应支持省份编码预配置功能，具备预置31 个省级平台IP 地址（或域名） 及端口号的能力，且装维APP 通过本地POST 接口选择省码后，支持选择注册此省码对 应IP 地址（或域名）及端口号，到指定的省平台注册上线。省份编码和省平台域名端口 对照表参考附录A.3。 4.3.11.2. 一级平台地址预置要求 预置一级平台的地址：“https://rgw.komect.com:443” 4.3.12. 移动闪联要求 全光组网终端须支持移动闪联能力，支持集成移动闪联能力的智能家居设备与组网 终端进行配网、连接，具体要求参见《中国移动智慧家庭智能硬件接入能力(And-link)技 术规范》。 4.3.13. 其他功能要求 全光组网终端的DHCPName 不应提供用户修改，且需符合以下要求：合作伙伴-型号 -YYYY（例如：CMHI-AN1202L-0000，DHCPName 总长度应不超32 字节）。其中合作 伙伴及型号采用在智家中心登记的标准名称，YYYY 为设备MAC 的后四位。 全光组网终端可选支持中国移动智家中心的Wi-Fi 感知插件，具有Wi-Fi CSI 数据获 取与数据处理，运用AI 算法进行人体运动规律和轨迹判断，对于异常情况及时预警的能"}, "keyword_score": 0.6148765141951386, "normalized_bm25_score": 0.6148765141951386, "rerank_score": null, "retrieval_score": 0.5990973314589776, "score": 0.5990973314589776, "semantic_score": 0.5923348245720516}]}], "sources": [{"bm25_score": 19.623234576969995, "chunk": {"document_id": "5256824b6b72b3f03d9c7a2c", "id": "1c317b1dd2cebfbf9647d03e", "metadata": {"block_id": "blk_e4bef2211b5bd8cddc76", "block_index": 11, "block_type": "paragraph", "business_module": "通用知识", "chunk_index": 11, "chunk_parse_quality_status": "parsed_with_warning", "chunk_parse_warning_codes": ["bordered_table_detected"], "content_hash": "dcf78195a87f01f45fc99b3af1c541f948a7cc8b6578168c0cb862cf9b620277", "detected_codes": [], "document_ocr_page_count": 0, "document_ocr_status": "not_required", "document_parse_quality_status": "parsed_with_warning", "document_parse_warning_count": 4, "end_unit": 96, "error_codes": [], "extension": ".pdf", "filename": "智慧家庭装维工程与管理职业技能等级标准.pdf", "governance_source": "default_curated_policy", "heading_path": ["智慧家庭装维工程与管理职业技能等级标准", "第12页"], "knowledge_status": "approved", "media_type": "pdf", "next_block_id": "blk_7678536353d72d515bc9", "page_number": 12, "page_warning_codes": ["bordered_table_detected"], "parent_block_id": "blk_941760edda054c582a94", "parser_name": "pdf", "parser_strategy": "pymupdf_text_with_page_quality_report", "parser_version": "document-parser-v7", "permission_tags": ["public"], "previous_block_id": "blk_941760edda054c