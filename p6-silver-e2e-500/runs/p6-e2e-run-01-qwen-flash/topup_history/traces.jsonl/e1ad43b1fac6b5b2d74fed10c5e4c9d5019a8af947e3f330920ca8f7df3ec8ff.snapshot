6772940158843994}, {"bm25_score": 11.563644536422196, "chunk": {"document_id": "c8588238d99d4079e1ec6101", "id": "096e926c7f2419fa383e7806", "metadata": {"block_id": "blk_db69cb6029ca84faa80b", "block_index": 71, "block_type": "paragraph", "business_module": "设备维护", "chunk_index": 71, "chunk_parse_quality_status": "parsed_with_warning", "chunk_parse_warning_codes": ["bordered_table_detected"], "content_hash": "8ae9b63d869002c1950aaf1192e44b0b876ccb9d927154f35e8c48bcd24094bb", "detected_codes": [], "document_ocr_page_count": 0, "document_ocr_status": "not_required", "document_parse_quality_status": "parsed_with_warning", "document_parse_warning_count": 7, "end_unit": 72, "error_codes": [], "extension": ".pdf", "filename": "电信基础设施维护规程.pdf", "governance_source": "default_curated_policy", "heading_path": ["电信基础设施维护规程", "第72页"], "knowledge_status": "approved", "media_type": "pdf", "next_block_id": "blk_2e48e66f79ae9f7757d6", "page_number": 72, "page_warning_codes": ["bordered_table_detected"], "parent_block_id": "blk_c2ee5a42922f4d6a6e37", "parser_name": "pdf", "parser_strategy": "pymupdf_text_with_page_quality_report", "parser_version": "document-parser-v7", "permission_tags": ["public"], "previous_block_id": "blk_c2ee5a42922f4d6a6e37", "review_status": "approved", "section_path": ["电信基础设施维护规程", "第72页"], "section_title": "第72页", "source": "电信基础设施维护规程.pdf", "source_block_ids": ["blk_db69cb6029ca84faa80b"], "source_path": "/app/data/电信基础设施维护规程.pdf", "source_type": "manual", "split_index": 0, "start_unit": 0, "table_parse_applied": false, "table_parse_skip_reason": "block_type_is_paragraph", "table_parse_status": "skipped", "table_parser_route": "deepdoc", "tenant_id": "default", "title": "电信基础设施维护规程", "version_id": "v_8ae9b63d869002c1"}, "text": "章节：电信基础设施维护规程 > 第72页 页码：72 T/CAICI XXXX—XXXX 66 （6）检查发电机换向器、集流环及带负载运用时碳刷的火花。 （7）检查启动蓄电池 监控系统检查 季度 模拟停电告警，准确上传。 表6.6.2.3 动力环境监控系统日常维护内容及要求： 维护对象 维护周期 作业内容 环境监控系 统 环境监控设备 季度 1. 检查清洁监控主机，上报处理告警信息。 2. 检查监控主机各项参数设定，满足参数设置要求。 3. 检查接线端子，紧固无松动。 4. 测量交、直流电压、温度值、开关电源等监控数据，与系统上传 数据进行对比，如误差过大需进行处理。 5. 检查测试监控感应设备，模拟告警检查灵敏度，发生故障及时进 行处理。 6. 模拟告警（市电停电、水浸、烟雾、防盗、空调、直流欠压等）， 与网管进行核对，能准确及时上传。 7. 检查门禁告警系统，告警信息能正确上传，并可远程遥控开启。 空调设备 季度 1. 检查空调温度按照规程的要求设置；对不符合要求的设置进行修 改。 2. 检查空调设备正常制冷，遥控器可用，空调自启动装置、主备倒 换等功能是否异常等；发现问题及时上报，并及时进行处理。 3. 检查室外风机、电机、风叶和压缩机运行状况，清洁或更换空气 过滤器； 4. 检查清洁冷凝器翅片、制冷管路、排水系统正常。 5. 检查空调支架的安全性，并进行防锈处理。 6. 检测制冷剂压力和制冷效果，根据检测结果及时上报，并通知专 业维修队伍补加制冷剂。 7. 用交流钳表测量记录每台空调的工作电流，并与额定电流比较， 实际工作电流与额定工作电流偏差在10%以内。 8. 检查空调室外机进排风温度差，进排风温度差：≥10℃，发现问 题及时上报，并及时进行处理。 9. 检查室内机、过滤网、室外机翅片清洁情况，应无明显的积尘， 及时清除积尘。 通风设备 季度 3. 检查设备、滤网清洁情况，选择合适方式清除积尘。 4. 检查控制系统、电气系统等运行情况，发现问题及时上报，并及 时进行处理。"}, "keyword_score": 0.49625381836328836, "normalized_bm25_score": 0.49625381836328836, "rerank_score": null, "retrieval_score": 0.5240215391189871, "score": 0.5240215391189871, "semantic_score": 0.5359219908714294}, {"bm25_score": 8.385039773391082, "chunk": {"document_id": "c8588238d99d4079e1ec6101", "id": "2fcc2d0a0be6115547b2d679", "metadata": {"block_id": "blk_684b06da912dd8d40640", "block_index": 318, "block_type": "paragraph", "business_module": "设备维护", "chunk_index": 318, "chunk_parse_quality_status": "parsed_with_warning", "chunk_parse_warning_codes": ["bordered_table_detected", "semi_structured_table_detected"], "content_hash": "8ae9b63d869002c1950aaf1192e44b0b876ccb9d927154f35e8c48bcd24094bb", "detected_codes": [], "document_ocr_page_count": 0, "document_ocr_status": "not_required", "document_parse_quality_status": "parsed_with_warning", "document_parse_warning_count": 7, "end_unit": 92, "error_codes": [], "extension": ".pdf", "filename": "电信基础设施维护规程.pdf", "governance_source": "default_curated_policy", "heading_path": ["电信基础设施维护规程", "第319页"], "knowledge_status": "approved", "media_type": "pdf", "next_block_id": "blk_5cb0192279705e625534", "page_number": 319, "page_warning_codes": ["bordered_table_detected", "semi_structured_table_detected"], "parent_block_id": "blk_db4ef65a5a2b90112e8d", "parser_name": "pdf", "parser_strategy": "pymupdf_tex