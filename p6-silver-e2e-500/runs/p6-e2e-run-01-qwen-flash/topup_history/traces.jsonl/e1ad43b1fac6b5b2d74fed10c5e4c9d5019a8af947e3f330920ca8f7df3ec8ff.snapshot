≥10℃，发现问 题及时上报，并及时进行处理。 9. 检查室内机、过滤网、室外机翅片清洁情况，应无明显的积尘， 及时清除积尘。 通风设备 季度 3. 检查设备、滤网清洁情况，选择合适方式清除积尘。 4. 检查控制系统、电气系统等运行情况，发现问题及时上报，并及 时进行处理。\n\n[4] 来源：电信基础设施维护规程.pdf\n引用标签：[4]\n标题：第319页\n定位信息：319\n综合分：0.467166\n召回综合分：0.467166\n重排分：无\n语义分：0.595697\nBM25 原始分：7.365159\nBM25 归一化分：0.167258\n内容：章节：电信基础设施维护规程 > 第319页 页码：319 T/CAICI XXXX—XXXX 313 表10.4.3.19 WH33119 空调检修 工作内容：清洁空调室内外机；检修冷媒管的保温层；检查空调运行状态；检修空调排水；紧固空调保护地线和室外机的机架等。 计量单位：台·次 次 维护分项作业 项目编码 项目名称 综合单价 （元） 其中 名称 人工 人工费(元) 企业管理费(元) 利润(元) 技工 普工 单位 工日 单价(元) 114.00 61.00 WH33119001 空调检修 54.53 34.08 10.22 10.22 消耗量 0.71 — 表10.4.3.20 WH33120 更换整流模块 工作内容：1、安装整流模块；2、检查电源系统设备工作状态；3、拆除故障模块；4、清理现场等。 计量单位：块 维护分项作业 项目编码 项目名称 综合单价 （元） 其中 名称 人工 人工费(元) 企业管理费(元) 利润(元) 技工 普工 单位 工日 单价(元) 114.00 61.00 WH33120001 更换整流模块 50A 以下 365.65 248.06 67.97 49.61 消耗量 2.18 0.00 WH33120002 100A 以下 470.12 318.94 87.39 63.79 2.80 0.00 WH33120003 100A 以上 607.23 411.96 112.88 82.39 3.61 0.00", "authorized_source_count": 4, "bm25_weight": 0.3, "context_latency_ms": 1.543, "context_terms": [], "contextual_query": "吊顶式机房通用空调的消耗量是多少？", "conversation_history_turn_count": 0, "created_at": "2026-11-05T12:14:03.616380+00:00", "degradation_reason": null, "embedding_latency_ms": 161.653, "generation_latency_ms": 1504.92, "intent_confidence": 0.35, "intent_label": "general_knowledge", "intent_latency_ms": 0.024, "intent_reason": "未命中明确业务意图，按通用知识问答处理。", "is_follow_up": false, "keyword_weight": 0.3, "latency_ms": 2200.909, "min_similarity_score": 0.05, "normalized_query": "吊顶式机房通用空调的消耗量是多少？", "original_query": "吊顶式机房通用空调的消耗量是多少？", "override_degradation_reason": null, "override_hit": false, "override_id": null, "override_type": null, "permission_tags": [], "query_embedding_cache_hit": false, "query_embedding_dimensions": 1024, "query_rewrite_rules": [], "relative_score_threshold": 0.35, "request_id": "438df19cb3534999a6f9244ba87cc61c", "rerank_applied": false, "rerank_candidate_k": 20, "rerank_latency_ms": 0.0, "rerank_model": "none", "rerank_provider": "none", "rerank_s