r_page_count": 0, "document_ocr_status": "not_required", "document_parse_quality_status": "parsed_with_warning", "document_parse_warning_count": 7, "end_unit": 84, "error_codes": [], "extension": ".pdf", "filename": "电信基础设施维护规程.pdf", "governance_source": "default_curated_policy", "heading_path": ["电信基础设施维护规程", "第249页"], "knowledge_status": "approved", "media_type": "pdf", "next_block_id": "blk_f226dbe905d18319b912", "page_number": 249, "page_warning_codes": ["bordered_table_detected"], "parent_block_id": "blk_7d1dc81c9f062a6eddad", "parser_name": "pdf", "parser_strategy": "pymupdf_text_with_page_quality_report", "parser_version": "document-parser-v7", "permission_tags": ["public"], "previous_block_id": "blk_7d1dc81c9f062a6eddad", "review_status": "approved", "section_path": ["电信基础设施维护规程", "第249页"], "section_title": "第249页", "source": "电信基础设施维护规程.pdf", "source_block_ids": ["blk_9a4c53dcbf86891bd81b"], "source_path": "/app/data/电信基础设施维护规程.pdf", "source_type": "manual", "split_index": 0, "start_unit": 0, "table_parse_applied": false, "table_parse_skip_reason": "block_type_is_paragraph", "table_parse_status": "skipped", "table_parser_route": "deepdoc", "tenant_id": "default", "title": "电信基础设施维护规程", "version_id": "v_8ae9b63d869002c1"}, "text": "章节：电信基础设施维护规程 > 第249页 页码：249 T/CAICI XXXX—XXXX 243 表10.3.2.5 WH2210 铁塔技术测试 工作内容：铁塔塔身垂直度、塔基回弹值测试等。 计量单位： 座·次 次 维护分项作业 项目编码 项目名称 综合单价 （元） 其中 名称 人工 人工费(元) 企业管理费(元) 利润(元) 技工 普工 单位 工日 单价(元) 114.00 61.00 WH22105001 铁塔技术测试 塔身垂直度 市区 69.31 43.32 13.00 13.00 消耗量 0.38 — WH22105002 平原、丘陵 83.17 51.98 15.60 15.60 0.46 — WH22105003 山区 103.97 64.98 19.49 19.49 0.57 — WH22105004 塔基回弹值 （未变） 市区 9.12 5.70 1.71 1.71 0.05 — WH22105005 平原、丘陵 10.94 6.84 2.05 2.05 0.06 — WH22105006 山区 13.68 8.55 2.57 2.57 0.08"}, "keyword_score": 1.0, "normalized_bm25_score": 1.0, "rerank_score": null, "retrieval_score": 0.8608020544052164, "score": 0.8608020544052164, "semantic_score": 0.801145792007452}, {"bm25_score": 17.410717049590367, "chunk": {"document_id": "c8588238d99d4079e1ec6101", "id": "14596d4e75ad163dd5bfc2e2", "metadata": {"block_id": "blk_fbb60ba460fb94404584", "block_index": 52, "block_type": "paragraph", "business_module": "通用知识", "chunk_index": 52, "chunk_parse_quality_status": "parsed_with_warning", "chunk_parse_warning_codes": ["bordered_table_detected"], "content_hash": "8ae9b63d869002c1950aaf1192e44b0b876ccb9d927154f35e8c48bcd24094bb", "detected_codes": [], "document_ocr_page_count": 0, "document_ocr_status": "not_required", "document_parse_quality_status": "parsed_with_warning", "document_parse_warning_count": 7, "end_unit": 42, "error_codes": [], "extension": ".pdf", "filename": "电信基础设施维护规程.pdf", "governance_source": "default_curated_policy", "heading_path": ["电信基础设施维护规程", "第53页"], "knowledge_status": "approved", "media_type": "pdf", "next_block_id": "blk_c554ddc5bd3cb22329d0", "page_number": 53, "page_warning_codes": ["bordered_table_detected"], "parent_block_id": "blk_f127cc796b81fd875b82", "parser_name": "pdf", "parser_strategy": "pymupdf_text_with_page_quality_report", "parser_version": "document-parser-v7", "permission_tags": ["public"], "previous_block_id": "blk_f127cc796b81fd875b82", "review_status": "approved", "section_path": ["电信基础设施维护规程", "第53页"], "section_title": "第53页", "source": "电信基础设施维护规程.pdf", "source_block_ids": ["blk_fbb60ba460fb94404584"], "source_path": "/app/data/电信基础设施维护规程.pdf", "source_type": "manual", "split_index": 0, "start_unit": 0, "table_parse_applied": false, "table_parse_skip_reason": "block_type_is_paragraph", "table_parse_status": "skipped", "table_parser_route": "deepdoc", "tenant_id": "default", "title": "电信基础设施维护规程", "version_id": "v_8ae9b63d869002c1"}, "text": "章节：电信基础设施维护规程 > 第53页 页码：53 T/CAICI XXXX—XXXX 47 网络质量测 试 C10T 测 试 按需 拨打次数、拨打区域符合规范要求 5.6.2.6 塔桅机房日常维护内容和要求见表5.6.2.6。 表5.6.2.6 塔桅机房日常维护内容和要求表 维护对象 维护周期 维护内容和要求 铁塔 基础 数据 半年 1.测量塔体经纬度、塔体和平台高度，与原基础数据进行核对。 塔基 基础 季度 1. 铁塔基础表面无蜂窝、麻面、无结构裂缝，基础钢筋无外露。塔脚包封良 好、地脚螺栓无外露现象。 2.地面回填土平整无开裂、下沉。 3.一体化塔房地梁无断裂、开裂、错位、滑移、异常沉降、不均匀沉降现象。 半埋式、全埋式地梁检查覆土完整。 4.楼面塔所在建筑结构受力构件（如墙体、墙面等）无裂纹、变形在允许范围 内。 5.塔脚地脚螺栓、螺母规格型号正确，无松动、缺损，防腐防盗措施有效。补 装更换缺损、问题螺栓，修复防腐防盗设施。 6.简单处理无潜在危害的裂缝。无法处理上报运营企业处理。 半年 基础回弹均值必须符合设计要求。"}, "keyword_score": 0.2602173830789943, "normalized_bm25_score": 0.2602173830789943, "rerank_score": null, "retrieval_score": 0.5521046443498948, "score": 0.5521046443498948, "semantic_score": 0.6771991848945665}, {"bm25_score": 13.431339704819104, "chunk": {"document_id": "c8588238d99d4079e1ec6101", "id": "611a9eb6554a2b482561c775", "metadata": {"block_id": "blk_b6285831e06aa97fe297", "block_index": 285, "block_type": "paragraph", "business_module": "通用知识", "chunk_index": 285, "chunk_parse_quality_status": "parsed_with_warning", "chunk_parse_warning_codes": ["bordered_table_detected"], "content_hash": "8ae9b63d869002c1950aaf1192e44b0b876ccb9d927154f35e8c48bcd24094bb", "detected_codes": [], "document_ocr_page_count": 0, "document_ocr_status": "not_required", "document_parse_quality_status": "parsed_with_warning", "document_parse_warning_count": 7, "end_unit": 87, "error_codes": [], "extension": ".pdf", "filename": "电信基础设施维护规程.pdf", "governance_source": "default_curated_policy", "heading_path": ["电信基础设施维护规程", "第286页"], "knowledge_status": "approved", "media_type": "pdf", "next_block_id": "blk_244e584d80ec7c6187b4", "page_number": 286, "page_warning_codes": ["bordered_table_detected"], "parent_block_id": "blk_29cf0bf514119eeccb11", "parser_name": "pdf", "parser_strategy": "pymupdf_text_with_page_quality_report", "parser_version": "document-parser-v7", "permission_tags": ["public"], "previous_block_id": "blk_29cf0bf514119eeccb11", "review_status": "approved", "section_path": ["电信基础设施维护规程", "第286页"], "section_title": "第286页", "source": "电信基础设施维护规程.pdf", "source_block_ids": ["blk_b6285831e06aa97fe297"], "source_path": "/app/data/电信基础设施维护规程.pdf", "source_type": "manual", "split_index": 0, "start_unit": 0, "table_parse_applied": false, "table_parse_skip_reason": "block_type_is_paragraph", "table_parse_status": "skippe