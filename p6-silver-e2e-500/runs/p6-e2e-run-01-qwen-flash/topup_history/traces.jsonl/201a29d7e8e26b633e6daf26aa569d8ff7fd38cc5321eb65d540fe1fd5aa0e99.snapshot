uired", "document_parse_quality_status": "parsed_with_warning", "document_parse_warning_count": 7, "end_unit": 75, "error_codes": [], "extension": ".pdf", "filename": "电信基础设施维护规程.pdf", "governance_source": "default_curated_policy", "heading_path": ["电信基础设施维护规程", "第56页"], "knowledge_status": "approved", "media_type": "pdf", "next_block_id": "blk_d0c77a8fd2fb352a4360", "page_number": 56, "page_warning_codes": ["bordered_table_detected"], "parent_block_id": "blk_ac8c82179f24d87ccfb2", "parser_name": "pdf", "parser_strategy": "pymupdf_text_with_page_quality_report", "parser_version": "document-parser-v7", "permission_tags": ["public"], "previous_block_id": "blk_ac8c82179f24d87ccfb2", "review_status": "approved", "section_path": ["电信基础设施维护规程", "第56页"], "section_title": "第56页", "source": "电信基础设施维护规程.pdf", "source_block_ids": ["blk_4e6e9dff2f6b1bccb350"], "source_path": "/app/data/电信基础设施维护规程.pdf", "source_type": "manual", "split_index": 0, "start_unit": 0, "table_parse_applied": false, "table_parse_skip_reason": "block_type_is_paragraph", "table_parse_status": "skipped", "table_parser_route": "deepdoc", "tenant_id": "default", "title": "电信基础设施维护规程", "version_id": "v_8ae9b63d869002c1"}, "text": "章节：电信基础设施维护规程 > 第56页 页码：56 T/CAICI XXXX—XXXX 50 防雷箱 季度 1.防雷箱工作正常，连接处部件无锈蚀，接地连线齐全、接头紧固。 2.检查防雷模块保护开关应处于闭合位置，告警指示正常，同时记录计数器 读数。 接地电阻 测试 半年 测试工作一般应安排在雷雨季节前，并做好记录。在强雷区、多雷区应适当 增加检查次数。 5.6.3 定期测试内容和指标 5.6.3.1 基站主设备及天馈线系统定期测试内容和指标见表5.6.3.1。 表5.6.3.1 基站主设备及天馈线系统定期测试内容和指标表 序号 测试内容 维护指标 测试周期 1 发射功率检测 测量值不低于设备规定值 季度 2 驻波比测试 测量值符合规定要求 季度 3 互调值测试 测量值符合规定要求 季度 4 天线方位角测试 允许误差≤5° 季度 5 天线俯仰角测试 允许误差≤1° 按季 5.6.3.2 电源系统定期测试内容和指标见表5.6.3.2. 表5.6.3.2 电源系统定期测试内容和指标表 序号 测试内容 维护指标 测试周期 1 直流电源电压变动范围（标准电压-48V） -40V～-57V 季度 2 直流电源电压变动范围（标准电压-24V） -19V～-29V 3 蓄电池内阻测试 符合厂家要求 4 铅酸蓄电池单体电池浮充端电压 符合厂家要求 5 锂电池单体电池浮充端电压 符合厂家要求 5.6.3.3 铁塔定期测试内容和指标见表5.6.3.3 表5.6.3.3 铁塔定期测试内容和指标表"}, "keyword_score": 1.0, "normalized_bm25_score": 1.0, "rerank_score": null, "retrieval_score": 0.7342179814447245, "score": 0.7342179814447245, 