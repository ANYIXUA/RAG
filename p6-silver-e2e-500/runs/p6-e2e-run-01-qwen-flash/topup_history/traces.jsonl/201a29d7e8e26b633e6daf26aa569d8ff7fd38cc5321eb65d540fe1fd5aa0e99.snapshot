me": "pdf", "parser_strategy": "pymupdf_text_with_page_quality_report", "parser_version": "document-parser-v7", "permission_tags": ["public"], "previous_block_id": "blk_266c6d2d50a01903867e", "review_status": "approved", "section_path": ["电信基础设施维护规程", "第339页"], "section_title": "第339页", "source": "电信基础设施维护规程.pdf", "source_block_ids": ["blk_71b8a96fd886b5d71745"], "source_path": "/app/data/电信基础设施维护规程.pdf", "source_type": "manual", "split_index": 0, "start_unit": 0, "table_parse_applied": false, "table_parse_skip_reason": "block_type_is_paragraph", "table_parse_status": "skipped", "table_parser_route": "deepdoc", "tenant_id": "default", "title": "电信基础设施维护规程", "version_id": "v_8ae9b63d869002c1"}, "text": "章节：电信基础设施维护规程 > 第339页\n页码：339\nT/CAICI XXXX—XXXX\n333\n表格列：附；录；A\n（资料性）\n信息通信光缆线路维护突发事件处理流程图"}, "keyword_score": 1.0, "normalized_bm25_score": 1.0, "rerank_score": null, "retrieval_score": 0.8447208192778131, "score": 0.8447208192778131, "semantic_score": 0.7781725989683045}, {"bm25_score": 51.736142870544, "chunk": {"document_id": "c8588238d99d4079e1ec6101", "id": "3c3adabc0eba4a63136a74a5", "metadata": {"block_id": "blk_e6050210ca8f2b669e5d", "block_index": 32, "block_type": "paragraph", "business_module": "通用知识", "chunk_index": 32, "chunk_parse_quality_status": "parsed_with_warning", "chunk_parse_warning_codes": [], "content_hash": "8ae9b63d869002c1950aaf1192e44b0b876ccb9d927154f35e8c48bcd24094bb", "detected_codes": [], "document_ocr_page_count": 0, "document_ocr_status": "not_required", "document_parse_quality_status": "parsed_with_warning", "document_parse_warning_count": 7, "end_unit": 71, "error_codes": [], "extension": ".pdf", "filename": "电信基础设施维护规程.pdf", "governance_source": "default_curated_policy", "heading_path": ["电信基础设施维护规程", "第33页"], "knowledge_status": "approved", "media_type": "pdf", "next_block_id": "blk_8ba01934edc93ca654aa", "page_number": 33, "page_warning_codes": [], "parent_block_id": "blk_5bfcdf2cc042dfe2608b", "parser_name": "pdf", "parser_strategy": "pymupdf_text_with_page_quality_report", "parser_version": "document-parser-v7", "permission_tags": ["public"], "previous_block_id": "blk_5bfcdf2cc042dfe2608b", "review_status": "approved", "section_path": ["电信基础设施维护规程", "第33页"], "section_title": "第33页", "source": "电信基础设施维护规程.pdf", "source_block_ids": ["blk_e6050210ca8f2b669e5d"], "source_path": "/app/data/电信基础设施维护规程.pdf", "source_type": "manual", "split_index": 0, "start_unit": 0, "table_parse_applied": false, "table_parse_skip_reason": "block_type_is_paragraph", "table_parse_status": "skipped", "table_parser_route": "deepdoc", "tenant_id": "default", "title": "电信基础设施维护规程", "version_id": "v_8ae9b63d869002c1"}, "text": "章节：电信基础设施维护规程 > 第33页 页码：33 T/CAICI XXXX—XXXX 27 4.7.0.4 重大突发事件，维护企业必须进行全天24 小时看护，保证光缆线路安全运行，并在第一时间内 通知运营企业，运营企业线路管理人员应及时进行现场确认。根据现场情况，运营企业线路管理人员与维 护企业技术人员共同制定相应的处理方案，并立即组织实施。处理方案应按光缆线路障碍抢修流程、光缆 线路割接流程、光缆线路迁移改造流程予以实施。 4.7.0.5 运营企业应针对可能发生的突发事件编制应急预案，维护企业应根据运营企业的应急预案编制自 己的预案，发生突发事件时应按照应急预案进行应急处理。 4.7.0.6 应急预案的编制应包括以下内容： a） 应急组织方案； b） 指挥机构； c） 主要车辆、仪表、工机具及材料的配置； d） 现场职责分工。 4.7.0.7 光缆线路维护突发事件处理流程见附录A。 4.8 信息通信光缆线路迁改与割接 4.8.1 光缆线路迁移改造 4.8.1.1 当光缆线路路由上方出现工程施工、自然环境改变等危及光缆运行时，为保证光缆安全而进行必 要的光缆线路迁移、下沉、加固等迁改工作或为提高光缆运行质量而进行光缆更换等优化工作，应按照光 缆线路迁移改造流程实施。 4.8.1.2 当光缆线路必须实施迁改、优化等工作时，维护企业向运营企业上报申请并附初步方案。 4.8.1.3 运营企业根据维护企业的申请和初步方案，进行实地勘察、方案论证工作后提出方案的审核意见 并及时向维护企业反馈。 4.8.1.4 迁改优化方案由维护企业组织施工时，应制定具体施工方案，运营企业组织相关单位对方案进行 论证；运营企业委托第三方施工时，也应制定具体施工方案，运营企业组织维护企业及相关部门对方案进 行论证并签订三方安全施工协议。 4.8.1.5 迁改方案实施过程中，每个隐蔽处均需运营企业现场验收签证。 4.8.1.6 维护企业在光缆线路迁改、优化工作完成后，应在七个工作日内向运营企业提交施工情况报告， 含迁改竣工资料。第三方完成迁移改造后，由运营企业组织验收，并在七个工作日内转交竣工资料给维护 企业。 4.8.1.7 光缆线路维护迁移改造流程见附录B。 4.8.2 光缆线路割接 4.8.2.1 光缆线路割接必须按照割接流程实施。 4.8.2.2 维护企业必须完成光缆线路割接前期准备工作，并向运营企业提交割接申请，同时制定割接技术 方案。 4.8.2.3 运营企业论证审核割接技术方案，在三个工作日内将意见反馈维护企业。 4.8.2.4 维护企业按审批后的割接总体方案做好各项工作，严格按照方案完成割接工作。割接完成后五个 工作日内反馈割接情况报告。 4.8.2.5 光缆线路割接技术方案的编制应包括以下内容： a） 割接工作概况； b） 指挥组织及通信联系方式；"}, "keyword_score": 0.6481709263138492, "normalized_bm25_score": 0.6481709263138492, "rerank_score": null, "retrieval_score": 0.7224952913917534, "score": 0.7224952913917534, "semantic_score": 0.7543485907108552}, {"bm25_score": 42.99930652126465, "chunk": {"document_id": "c8588238d99d4079e1ec6101", "id": "3a141ab8e8dfab0fa765501c", "metadata": {"block_id": "blk_e8cff96e0a79a3087eb4", "block_index": 356, "block_type": "paragraph", "business_module": "设备维护", "chunk_index": 356, "chunk_parse_quality_status": "parsed_with_warning", "chunk_parse_warning_codes": ["table_like_text_detected", "bordered_table_detected"], "content_hash": "8ae9b63d869002c1950aaf1192e44b0b876ccb9d927154f35e8c48bcd24094bb", "detected_codes": [], "document_ocr_page_count": 0, "document_ocr_status": "not_required", "document_parse_quality_status": "parsed_with_warning", "document_parse_warning_count": 7, "end_unit": 29, "error_codes": [], "extension": ".pdf", "filename": "电信基础设施维护规程.pdf", "governance_source": "default_curated_policy", "heading_path": ["电信基础设施维护规程", "第357页"], "knowledge_status": "approved", "media_type": "pdf", "next_block_id": "blk_6411861fe3f1c1780bc4", "page_number": 357, "page_warning_codes": ["table_like_text_detected", "bordered_table_detected"], "parent_block_id": "blk_dbb11f04e5c671a29ba6", "parser_name": "pdf", "parser_strategy": "pymupdf_text_with_page_quality_report", "parser_version": "document-parser-v7", "permission_tags": ["public"], "previous_block_id": "blk_dbb11f04e5c671a29ba6", "review_status": "approved", "section_path": ["电信基础设施维护规程", "第357页"], "section_title": "第357页", "source": "电信基础设施维护规程.pdf", "source_block_ids": ["blk_e8cff96e0a79a3087eb4"], "source_path": "/app/data/电信基础设施维护规程.pdf", "source_type": "manual", "split_index": 0, "start_unit": 0, "table_parse_applied": false, "table_parse_skip_reason": "block_type_is_paragraph", "table_parse_status": "skipped", "table_parser_route": "deepdoc", "tenant_id": "default", "title": "电信基础设施维护规程", "version_id": "v_8ae9b63d869002c1"}, "text": "章节：电信基础设施维护规程 > 第357页 页码：357 T/CAICI XXXX—XXXX 351 表格列：附；录；K （资料性） 小型局站有线设备维护突发事件处理流程 突发事件 运营管