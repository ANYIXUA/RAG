9510552883, 0.019946586340665817, 0.013756266795098782, -0.038574863225221634, 0.0032957722432911396, -0.012387804687023163, -0.03126684948801994, -0.015475800260901451, 0.02285546436905861, 0.019602680578827858, 0.006247637793421745, -0.045624952763319016, 0.03264247626066208, -0.012774700298905373, -0.09566337615251541, -0.038345593959093094, -0.12701620161533356, -0.016607826575636864, -0.014845305122435093, 0.02719728648662567, 0.015877025201916695, -0.05588483437895775, 0.008296748623251915, -0.0069856042973697186, 0.01504591666162014, -0.0185996200889349, -0.0400078110396862, 0.06855206191539764, 0.003408616641536355, 0.008826937526464462, 0.020132869482040405, -0.04854815825819969, 0.0049723172560334206, -0.0018825307488441467, -0.012351981364190578, -0.0021888227201998234, -0.03221259266138077, -0.014164656400680542, -0.014830974861979485, 0.032241251319646835, 0.03754314407706261, -0.01504591666162014, -0.00365579966455698, -0.028716206550598145, -0.01752491109073162, -0.009529081173241138, 0.01991792768239975, -0.05210186168551445, 0.022368263453245163, -0.018542300909757614, -0.033129677176475525, -0.014207644388079643, -0.015547447837889194, 0.03318699449300766, -0.020290493965148926, 0.030922941863536835, -0.043962735682725906, 0.007171886973083019, -0.009894481860101223, 0.016020318493247032, -0.06098611652851105, -0.05218783766031265, 0.016908744350075722, -0.0013469677651301026, -0.04344687610864639], "query_text": "设备在远程管理时，如何确保SSH和telnet协议的安全使用？ 终端设备 设备信息 设备状态 业务说明 知识库 常见问题", "relative_score_threshold": 0.35, "semantic_weight": 0.7, "tenant_id": null, "top_k": 4}, "results": [{"bm25_score": 47.343738175497364, "chunk": {"document_id": "a2053ec18f1415e4912c510f", "id": "81951fb8b5e157346ed83d77", "metadata": {"block_id": "blk_331fac305d9199e20770", "block_index": 51, "block_type": "paragraph", "business_module": "地址校验", "chunk_index": 51, "chunk_parse_quality_status": "parsed_with_warning", "chunk_parse_warning_codes": [], "content_hash": "ab72ce00c904f060e1a60edb2af37b98f35cb9464f510e1022e29c657a94cf99", "detected_codes": [], "document_ocr_page_count": 0, "document_ocr_status": "not_required", "document_parse_quality_status": "parsed_with_warning", "document_parse_warning_count": 6, "end_unit": 59, "error_codes": [], "extension": ".pdf", "filename": "中国移动智慧家庭全光组网产品技术规范V2.0.0.pdf", "governance_source": "default_curated_policy", "heading_path": ["中国移动智慧家庭全光组网产品技术规范V2.0.0", "第52页"], "knowledge_status": "approved", "media_type": "pdf", "next_block_id": "blk_9a7fdd98791acb52b3ca", "page_number": 52, "page_warning_codes": [], "parent_block_id": "blk_19513fdd1c53321bc989", "parser_name": "pdf", "parser_strategy": "pymupdf_text_with_page_quality_report", "parser_version": "document-parser-v7", "permission_tags": ["public"], "previous_block_id": "blk_19513fdd1c53321bc989", "review_status": "approved", "section_path": ["中国移动智慧家庭全光组网产品技术规范V2.0.0", "第52页"], "section_title": "第52页", "source": "中国移动智慧家庭全光组网产品技术规范V2.0.0.pdf", "source_block_ids": ["blk_331fac305d9199e20770"], "source_path": "/app/data/中国移动智慧家庭全光组网产品技术规范V2.0.0.pdf", "source_type": "manual", "split_index": 0, "start_unit": 0, "table_parse_applied": false, "table_parse_skip_reason": "block_type_is_paragraph", "table_parse_status": "skipped", "table_parser_route": "deepdoc", "tenant_id": "default", "title": "中国移动智慧家庭全光组网产品技术规范V2.0.0", "version_id": "v_ab72ce00c904f060"}, "text": "章节：中国移动智慧家庭全光组网产品技术规范V2.0.0 > 第52页 页码：52 47 4.8.2. 账号口令 1、禁用调试账号 设备中除为用户提供的唯一账号外，在设备出厂后不应以任何形式在设备中预留任 何其他账号。 2、口令安全 口令应支持足够复杂的策略，口令应满足至少8 位长度要求，且包含字符、数字和特 殊字符等。 4.8.3. WAN 侧接入安全性 除上网业务的交互协议，以及与中国移动业务管理平台的远程连接之外，全光组网终 端不应为其他第三方提供如用户数据分析等服务。 4.8.4. LAN 侧接入安全性 1. WLAN 应支持Open System 和Pre-Shared Key 两种链路层鉴权方式。 2. WLAN 应支持WPA-PSK、WPA2-PSK、WPA-PSK/WPA2-PSK 混和模式、WPA3、 WPA2/WPA3混合模式，应支持AES、TKIP+AES混合加密模式。推荐启用WPA2/WPA3 混合模式和TKIP+AES 混合加密模式。 3. 应支持有线用户和无线用户的MAC 认证，即能对用户终端的MAC 地址进行“黑名 单”（禁止黑名单内的MAC 终端接入网络）、“白名单”（只允许白名单内的MAC 终端接入网络）配置和操作。 4. 应支持国家无线局域网安全标准。 5. 应支持VPN（IP SEC，PPTP，L2TP）透传功能。 4.8.5. 设备端口安全要求 默认情况下，设备应禁用SSH 和telnet 等远程管理协议，包括标准和非标准端口的 SSH 和telnet 协议。如在特殊情况下需要打开SSH 和Telnet 远程管理协议，应设置满足 本规范要求的账户口令验证措施，不应出现空口令或弱口令登录的情况。"}, "keyword_score": 1.0, "normalized_bm25_score": 1.0, "rerank_score": null, "retrieval_score": 0.7312190523380417, "score": 0.7312190523380417, "semantic_score": 0.616027217625774}, {"bm25_score": 28.37166745467355, "chunk": {"document_id": "a2053ec18f1415e4912c510f", "id": "00f7942e754f0fcdd7c2fa53", "metadata": {"block_id": "blk_1b511fb60960ee1865a4", "block_index": 52, "block_type": "paragraph", "business_module": "设备维护", "chunk_index": 52, "chunk_parse_quality_status": "parsed_with_warning", "chunk_parse_warning_codes": [], "content_hash": "ab72ce00c904f060e1a60edb2af37b98f35cb9464f510e1022e29c657a94cf99", "detected_codes": [], "document_ocr_page_count": 0, "document_ocr_status": "not_required", "document_parse_quality_status": "parsed_with_warning", "document_parse_warning_count": 6, "end_unit": 47, "error_codes": [], "extension": ".pdf", "filename": "中国移动智慧家庭全光组网产品技术规范V2.0.0.pdf", "governance_source": "default_curated_policy", "heading_path": ["中国移动智慧家庭全光组网产品技术规范V2.0.0", "第53页"], "knowledge_status": "approved", "media_type": "pdf", "next_block_id": "blk_d65c7017d502bb2868a5", "page_number": 53, "page_warning_codes": [], "parent_block_id": "blk_9a7fdd98791acb52b3ca", "parser_name": "pdf", "parser_strategy": "pymupdf_text_with_page_quality_report", "parser_version": "document-parser-v7", "permission_tags": ["public"], "previous_block_id": "blk_9a7fdd98791acb52b3ca", "review_status": "approved", "section_path": ["中国移动智慧家庭全光组网产品技术规范V2.0.0", "第53页"], "section_title": "第53页", "source": "中国移动智慧家庭全光组网产品技术规范V2.0.0.pdf", "source_block_ids": ["blk_1b511fb60960ee1865a4"], "source_path": "/app/data/中国移动智慧家庭全光组网产品技术规范V2.0.0.pdf", "source_type": "manual", "split_index": 0, "start_unit": 0, "table_parse_applied": false, "table_parse_skip_reason": "block_type_is_paragraph", "table_parse_status": "skipped", "table_parser_route": "deepdoc", "tenant_id": "default", "title": "中国移动智慧家庭全光组网产品技术规范V2.0.0", "version_id": "v_ab72ce00c904f060"}, "text": "章节：中国移动智慧家庭全光组网产品技术规范V2.0.0 > 第53页 页码：53 48 4.8.6. 管理通道安全要求 1. 应默认禁用串口，如在特殊情况下需要启用串口，必须添加登录密码，且设置满足本 规范要求的账户口令验证措施，不应出现空口令或弱口令登录的情况。 2. 设备不应以隐藏后门、秘密通道等任何形式存在后门，如预留对用户未知的账号、开 放对用户未知的远程管理端口、预设或预留对用户未知的登录方式等。 4.8.7. 固件安全要求 1. 应具备固件更新机制。 2. 固件启动、固件升级时，应对升级文件的来源和完整性进行校验，包括验证升级包的 哈希值、大小、版本号和签名。 3. 固件下载传输通道应确保可信，防止中间人劫持或者嗅探。 4. 固件升级失败后，应确保设备可用性。 4.8.8. 通信安全要求 1. 设备与服务器、控制端设备等进行通信时，应进行身份认证。 2. 应使用安全传输协议保障数据在传输过程中的保密性和完整性，同时对于密钥、身份 认证凭证、用户敏感信息（如口令等）等重要数据应使用加密、签名等保护机制；使 用的安全传输协议应避免使用已公开的不安全版本。 4.8.9. 业务与数据安全要求 1. 数据传输时，应用或系统应具备对数据机密性和完整性保护机制，且用于传输加密的 密钥不应硬编码在代码中。 2. 禁止将登录用户名、密码等登录凭证明文硬编码存储在设备中。 3. 不应在本地存储用户个人敏感数据（如姓名、手机号、邮箱、生物特征等），如果业 务需要必须存储用户个人敏感数据时，应告知用户使用用途，并进行加密。 4. 密钥、证书等关键安全信息应加密保存，禁止明文存储在本地文件中。 5. 对设备密码、设备鉴别信息等关键安全信息进行加密处理，不应在日志和配置文件中 明文记录关键安全信息。"}, "keyword_score": 0.5992696932697477, "normalized_bm25_score": 0.5992696932697477, "rerank_score": null, "retrieval_score": 0.5863402503223323, "score": 0.5863402503223323, "semantic_score": 0.5807990604877257}, {"bm25_score": 24.529658580558927, "chunk": {"document_id": "a2053ec18f1415e4912c510f", "id": "d1d75534f8865f49c152b4dd", "metadata": {"block_id": "blk_cd7c721200d0bd979ea7", "block_index": 55, "block_type": "paragraph", "business_module": "设备维护", "chunk_index": 55, "chunk_parse_quality_status": "parsed_with_warning", "chunk_parse_warning_codes": [], "content_hash": "ab72ce00c904f060e1a60edb2af37b98f35cb9464f510e1022e29c657a94cf99", "detected_codes": [], "document_ocr_page_count": 0, "document_ocr_status": "not_required", "document_parse_quality_status": "parsed_with_warning", "document_parse_warning_count": 6, "end_unit": 58, "error_codes": [], "extension": ".pdf", "filename": "中国移动智慧家庭全光组网产品技术规范V2.0.0.pdf", "governance_source": "default_curated_policy", "heading_path": ["中国移动智慧家庭全光组网产品技术规范V2.0.0", "第56页"], "knowledge_status": "approved", "media_type": "pdf", "next_block_id": "blk_e1fe4388a485e264d786", "page_number": 56, "page_warning_codes": [], "parent_block_id": "blk_76912f8eb61f0d2e0da1", "parser_name": "pdf", "parser_strategy": "pymupdf_text_with_page_quality_report", "parser_version": "document-parser-v7", "permission_tags": ["public"], "previous_block_id": "blk_76912f8eb61f0d2e0da1", "review_status": "approved", "section_path": ["中国移动智慧家庭全光组网产品技术规范V2.0.0", "第56页"], "section_title": "第56页", "source": "中国移动智慧家庭全光组网产品技术规范V2.0.0.pdf", "source_block_ids": ["blk_cd7c721200d0bd979ea7"], "source_path": "/app/data/中国移动智慧家庭全光组网产品技术规范V2.0.0.pdf", "source_type": "manual", "split_index": 0, "start_unit": 0, "table_parse_applied": false, "table_parse_skip_reason": "block_type_is_paragraph", "table_parse_status": "skipped", "table_parser_route": "deepdoc", "tenant_id": "default", "title": "中国移动智慧家庭全光组网产品技术规范V2.0.0", "version_id": "v_ab72ce00c904f060"}, "text": "章节：中国移动智慧家庭全光组网产品技术规范V2.0.0 > 第56页 页码：56 51 4.9.2. 远程管理要求 4.9.2.1. 管理协议要求 全光组网终端应支持与管理平台通过加密方式建立交互，实现平台对终端的远程管 控，具体功能及接口请参阅《中国移动智慧家庭全光组网产品入库接口规范》。 4.9.2.2. 远程故障诊断功能 全光组网终端应能配合管理平台实现如下的远程故障诊断功能： 1. 全光组网终端能够接受管理平台的远程控制，执行设备重启、参数设置等操作。 2. 全光组网终端能够配合管理平台对无线用户连接故障进行诊断，呈现家庭网络的 连接拓扑，指明可能的故障原因，并将故障信息上报到管理平台。 3. 全光组网终端能够将设备运行日志上报给管理平台，协助排查终端异常原因。 4.9.2.3. 设备告警功能 全光组网终端应备具有设备告警的功能，能够上传设备的告警信息。 4.9.2.4. 软件远程管理 全光组网终端能够接受管理平台的远程控制，进行软件版本升级。全光组网终端升级 软件时应具有容错校验功能，如果升级失败，应能恢复到原来的软件版本或者连接管理平 台接受再次升级。 4.10. 专项要求 4.10.1. 设备接口要求 4.10.1.1. 上行接口要求 4.10.1.1.1. 光网关上行接口要求 XG-PON Combo 接口可工作在GPON 模式和XG-PON 模式。 光网关上行XG-PON 模式应采用N2a 光模块，应符合《中国移动10G PON 设备规 范》要求； 光网关上行GPON 模式应符合《中国移动GPON 设备规范》要求。光模块应采用Class B+，并与OLT 配合满足Class C+的光链路功率预算。光接口参数应符合G.984.2 Amd1 和 Amd2 的相关要求。"}, "keyword_score": 0.5181183304459509, "normalized_bm25_score": 0.5181183304459509, "rerank_score": null, "retrieval_score": 0.5679289139375375, "score": 0.5679289139375375, "semantic_score": 0.5892763068625033}, {"bm25_score": 24.21115068837926, "chunk": {"document_id": "a2053ec18f1415e4912c510f", "id": "3ef6f0c2eb6c280b4b3a262b", "metadata": {"block_id": "blk_da0c727b1a172288b791", "block_index": 50, "block_type": "paragraph", "business_module": "地址校验", "chunk_index": 50, "chunk_parse_quality_status": "parsed_with_warning", "chunk_parse_warning_codes": [], "content_hash": "ab72ce00c904f060e1a60edb2af37b98f35cb9464f510e1022e29c657a94cf99", "detected_codes": [], "document_ocr_page_count": 0, "document_ocr_status": "not_required", "document_parse_quality_status": "parsed_with_warning", "document_parse_warning_count": 6, "end_unit": 65, "error_codes": [], "extension": ".pdf", "filename": "中国移动智慧家庭全光组网产品技术规范V2.0.0.pdf", "governance_source": "default_curated_policy", "heading_path": ["中国移动智慧家庭全光组网产品技术规范V2.0.0", "第51页"], "knowledge_status": "approved", "media_type": "pdf", "next_block_id": "blk_19513fdd1c53321bc989", "page_number": 51, "page_warning_codes": [], "parent_block_id": "blk_6fa0a328c67a7375954f", "parser_name": "pdf", "parser_strategy": "pymupdf_text_with_page_quality_report", "parser_version": "document-parser-v7", "permission_tags": ["public"], "previous_block_id": "blk_6fa0a328c67a7375954f", "review_status": "approved", "section_path": ["中国移动智慧家庭全光组网产品技术规范V2.0.0", "第51页"], "section_title": "第51页", "source": "中国移动智慧家庭全光组网产品技术规范V2.0.0.pdf", "source_block_ids": ["blk_da0c727b1a172288b791"], "source_path": "/app/data/中国移动智慧家庭全光组网产品技术规范V2.0.0.pdf", "source_type": "manual", "split_index": 0, "start_unit": 0, "table_parse_applied": false, "table_parse_skip_reason": "block_type_is_paragraph", "table_parse_status": "skipped", "table_parser_route": "deepdoc", "tenant_id": "default", "title": "中国移动智慧家庭全光组网产品技术规范V2.0.0", "version_id": "v_ab72ce00c904f060"}, "text": "章节：中国移动智慧家庭全光组网产品技术规范V2.0.0 > 第51页 页码：51 46 4.8. 安全要求 1. 全光组网终端需符合GB/T 41387-2022《信息安全技术 智能家居通用安全规范》 相关安全要求。 2. 全光组网终端需要满足以下具体安全要求： 4.8.1. 防攻击功能 全光组网终端应支持防DoS 攻击功能，能够防止LAND、Ping of Death、SYN Flooding、 ICMP Redirection、Smurf、Winnuke 等类型的攻击。 应能够提供防端口扫描功能，支持防其它设备或者应用的恶意端口扫描。 仅开启提供业务和网管所必需的网络和服务端口，关闭其他所有不使用的网络和服 务端口。 光网关应支持防火墙功能，支持对防火墙等级的设置，支持对防火墙规则的配置，且 支持接收管理平台下发策略进行远程配置。支持基于以下规则对报文进行过滤： （1）支持根据源MAC 地址、目的MAC 地址进行报文过滤； （2）支持根据源IP 地址及范围段、目的IP 地址及范围段进行报文过滤； （3）支持根据IP 源端口及范围段、目的端口及范围段进行报文过滤； （4）支持根据以太网包的传输层协议类型进行报文过滤，要求有IP/PPPoE/ARP 的 选项； （5 ）支持根据 IP 包的传输层协议类型进行报文过滤，要求有 TCP/UDP/ICMP/TCP+UDP/ANY 的选项； （6）支持对匹配规则的报文进行处理模式的选择，对匹配规则的报文的处理模式， 有允许和禁止2 种，默认为禁止模式。 应支持防止用户做源的组播，禁止用户端口发出的IGMP Query 和组播数据报文。 应支持对特定协议的广播/多播包（例如DHCP，ARP，IGMP 等）进行抑制，并能对 其它二层广播报文进行速率限制。 Web 管理界面应避免常见的Web 漏洞，如SQL 注入、致跨站脚本漏洞XSS、跨站请 求伪造CSRF、文件上传、目录遍历等。 在上网业务不受影响的前提下能抵御攻击源数量不低于3000 个，每条流不低于 300pps 的DDoS 攻击。"}, "keyword_score": 0.5113907693269071, "normalized_bm25_score": 0.5113907693269071, "rerank_score": null, "retrieval_score": 0.5538078319678594, "score": 0.5538078319678594, "semantic_score": 0.5719865730996962}]}], "sources": [{"bm25_score": 47.343738175497364, "chunk": {"document_id": "a2053ec18f1415e4912c510f", "id": "81951fb8b5e157346ed83d77", "metadata": {"block_id": "blk_331fac305d9199e20770", "block_index": 51, "block_type": "paragraph", "business_module": "地址校验", "chunk_index": 51, "chunk_parse_quality_status": "parsed_with_warning", "chunk_parse_warning_codes": [], "content_hash": "ab72ce00c904f060e1a60edb2af37b98f35cb9464f510e1022e29c657a94cf99", "detected_codes": [], "document_ocr_page_count": 0, "document_ocr_status": "not_required", "document_parse_quality_status": "parsed_with_warning", "document_parse_warning_count": 6, "end_unit": 59, "error_codes": [], "extension": ".pdf", "filename": "中国移动智慧家庭全光组网产品技术规范V2.0.0.pdf", "governance_source": "default_curated_policy", "heading_path": ["中国移动智慧家庭全光组网产品技术规范V2.0.0", "第52页"], "knowledge_status": "approved", "media_type": "pdf", "next_block_id": "blk_9a7fdd98791acb52b3ca", "page_number": 52, "page_warning_codes": [], "parent_block_id": "blk_19513fdd1c53321bc989", "parser_name": "pdf", "parser_strategy": "pymupdf_text_with_page_quality_report", "parser_version": "document-parser-v7", "permission_tags": ["public"], "previous_block_id": "blk_19513fdd1c53321bc989", "review_status": "approved", "section_path": ["中国移动智慧家庭全光组网产品技术规范V2.0.0", "第52页"], "section_title": "第52页", "source": "中国移动智慧家庭全光组网产品技术规范V2.0.0.pdf", "source_block_ids": ["blk_331fac305d9199e20770"], "source_path": "/app/data/中国移动智慧家庭全光组网产品技术规范V2.0.0.pdf", "source_type": "manual", "split_index": 0, "start_unit": 0, "table_parse_applied": false, "table_parse_skip_reason": "block_type_is_paragraph", "table_parse_status": "skipped", "table_parser_route": "deepdoc", "tenant_id": "default", "title": "中国移动智慧家庭全光组网产品技术规范V2.0.0", "version_id": "v_ab72ce00c904f060"}, "text": "章节：中国移动智慧家庭全光组网产品技术规范V2.0.0 > 第52页 页码：52 47 4.8.2. 账号口令 1、禁用调试账号 设备中除为用户提供的唯一账号外，在设备出厂后不应以任何形式在设备中预留任 何其他账号。 2、口令安全 口令应支持足够复杂的策略，口令应满足至少8 位长度要求，且包含字符、数字和特 殊字符等。 4.8.3. WAN 侧接入安全性 除上网业务的交互协议，以及与中国移动业务管理平台的远程连接之外，全光组网终 端不应为其他第三方提供如用户数据分析等服务。 4.8.4. LAN 侧接入安全性 1. WLAN 应支持Open System 和Pre-Shared Key 两种链路层鉴权方式。 2. WLAN 应支持WPA-PSK、WPA2-PSK、WPA-PSK/WPA2-PSK 混和模式、WPA3、 WPA2/WPA3混合模式，应支持AES、TKIP+AES混合加密模式。推荐启用WPA2/WPA3 混合模式和TKIP+AES 混合加密模式。 3. 应支持有线用户和无线用户的MAC 认证，即能对用户终端的MAC 地址进行“黑名 单”（禁止黑名单内的MAC 终端接入网络）、“白名单”（只允许白名单内的MAC 终端接入网络）配置和操作。 4. 应支持国家无线局域网安全标准。 5. 应支持VPN（IP SEC，PPTP，L2TP）透传功能。 4.8.5. 设备端口安全要求 默认情况下，设备应禁用SSH 和telnet 等远程管理协议，包括标准和非标准端口的 SSH 和telnet 协议。如在特殊情况下需要打开SSH 和Telnet 远程管理协议，应设置满足 本规范要求的账户口令验证措施，不应出现空口令或弱口令登录的情况。"}, "keyword_score": 1.0, "normalized_bm25_score": 1.0, "rerank_score": null, "retrieval_score": 0.7312190523380417, "score": 0.7312190523380417, "semantic_score": 0.616027217625774}, {"bm25_score": 28.37166745467355, "chunk": {"document_id": "a2053ec18f1415e4912c510f", "id": "00f7942e754f0fcdd7c2fa53", "metadata": {"block_id": "blk_1b511fb60960ee1865a4", "block_index": 52, "block_type": "paragraph", "business_module": "设备维护", "chunk_index": 52, "chunk_parse_quality_status": "parsed_with_warning", "chunk_parse_warning_codes": [], "content_hash": "ab72ce00c904f060e1a60edb2af37b98f35cb9464f510e1022e29c657a94cf99", "detected_codes": [], "document_ocr_page_count": 0, "document_ocr_status": "not_required", "document_parse_quality_status": "parsed_with_warning", "document_parse_warning_count": 6, "end_unit": 47, "error_codes": [], "extension": ".pdf", "filename": "中国移动智慧家庭全光组网产品技术规范V2.0.0.pdf", "governance_source": "default_curated_policy", "heading_path": ["中国移动智慧家庭全光组网产品技术规范V2.0.0", "第53页"], "knowledge_status": "approved", "media_type": "pdf", "next_block_id": "blk_d65c7017d502bb2868a5", "page_number": 53, "page_warning_codes": [], "parent_block_id": "blk_9a7fdd98791acb52b3ca", "parser_name": "pdf", "parser_strategy": "pymupdf_text_with_page_quality_report", "parser_version": "document-parser-v7", "permission_tags": ["public"], "previous_block_id": "blk_9a7fdd98791acb52b3ca", "review_status": "approved", "section_path": ["中国移动智慧家庭全光组网产品技术规范V2.0.0", "第53页"], "section_title": "第53页", "source": "中国移动智慧家庭全光组网产品技术规范V2.0.0.pdf", "source_block_ids": ["blk_1b511fb60960ee1865a4"], "source_path": "/app/data/中国移动智慧家庭全光组网产品技术规范V2.0.0.pdf", "source_type": "manual", "split_index": 0, "start_unit": 0, "table_parse_applied": false, "table_parse_skip_reason": "block_type_is_paragraph", "table_parse_status": "skipped", "table_parser_route": "deepdoc", "tenant_id": "default", "title": "中国移动智慧家庭全光组网产品技术规范V2.0.0", "version_id": "v_ab72ce00c904f060"}, "text": "章节：中国移动智慧家庭全光组网产品技术规范V2.0.0 > 第53页 页码：53 48 4.8.6. 管理通道安全要求 1. 应默认禁用串口，如在特殊情况下需要启用串口，必须添加登录密码，且设置满足本 规范要求的账户口令验证措施，不应出现空口令或弱口令登录的情况。 2. 设备不应以隐藏后门、秘密通道等任何形式存在后门，如预留对用户未知的账号、开 放对用户未知的远程管理端口、预设或预留对用户未知的登录方式等。 4.8.7. 固件安全要求 1. 应具备固件更新机制。 2. 固件启动、固件升级时，应对升级文件的来源和完整性进行校验，包括验证升级包的 哈希值、大小、版本号和签名。 3. 固件下载传输通道应确保可信，防止中间人劫持或者嗅探。 4. 固件升级失败后，应确保设备可用性。 4.8.8. 通信安全要求 1. 设备与服务器、控制端设备等进行通信时，应进行身份认证。 2. 应使用安全传输协议保障数据在传输过程中的保密性和完整性，同时对于密钥、身份 认证凭证、用户敏感信息（如口令等）等重要数据应使用加密、签名等保护机制；使 用的安全传输协议应避免使用已公开的不安全版本。 4.8.9. 业务与数据安全要求 1. 数据传输时，应用或系统应具备对数据机密性和完整性保护机制，且用于传输加密的 密钥不应硬编码在代码中。 2. 禁止将登录用户名、密码等登录凭证明文硬编码存储在设备中。 3. 不应在本地存储用户个人敏感数据（如姓名、手机号、邮箱、生物特征等），如果业 务需要必须存储用户个人敏感数据时，应告知用户使用用途，并进行加密。 4. 密钥、证书等关键安全信息应加密保存，禁止明文存储在本地文件中。 5. 对设备密码、设备鉴别信息等关键安全信息进行加密处理，不应在日志和配置文件中 明文记录关键安全信息。"}, "keyword_score": 0.5992696932697477, "normalized_bm25_score": 0.5992696932697477, "rerank_score": null, "retrieval_score": 0.5863402503223323, "score": 0.5863402503223323, "semantic_score": 0.5807990604877257}, {"bm25_score": 24.529658580558927, "chunk": {"document_id": "a2053ec18f1415e4912c510f", "id": "d1d75534f8865f49c152b4dd", "metadata": {"block_id": "blk_cd7c721200d0bd979ea7", "block_index": 55, "block_type": "paragraph", "business_module": "设备维护", "chunk_index": 55, "chunk_parse_quality_status": "parsed_with_warning", "chunk_parse_warning_codes": [], "content_hash": "ab72ce00c904f060e1a60edb2af37b98f35cb9464f510e1022e29c657a94cf99", "detected_codes": [], "document_ocr_page_count": 0, "document_ocr_status": "not_required", "document_parse_quality_status": "parsed_with_warning", "document_parse_warning_count": 6, "end_unit": 58, "error_codes": [], "extension": ".pdf", "filename": "中国移动智慧家庭全光组网产品技术规范V2.0.0.pdf", "governance_source": "default_curated_policy", "heading_path": ["中国移动智慧家庭全光组网产品技术规范V2.0.0", "第56页"], "knowledge_status": "approved", "media_type": "pdf", "next_block_id": "blk_e1fe4388a485e264d786", "page_number": 56, "page_warning_codes": [], "parent_block_id": "blk_76912f8eb61f0d2e0da1", "parser_name": "pdf", "parser_strategy": "pymupdf_text_with_page_quality_report", "parser_version": "document-parser-v7", "permission_tags": ["public"], "previous_block_id": "blk_76912f8eb61f0d2e0da1", "review_status": "approved", "section_path": ["中国移动智慧家庭全光组网产品技术规范V2.0.0", "第56页"], "section_title": "第56页", "source": "中国移动智慧家庭全光组网产品技术规范V2.0.0.pdf", "source_block_ids": ["blk_cd7c721200d0bd979ea7"], "source_path": "/app/data/中国移动智慧家庭全光组网产品技术规范V2.0.0.pdf", "source_type": "manual", "split_index": 0, "start_unit": 0, "table_parse_applied": false, "table_parse_skip_reason": "block_type_is_paragraph", "table_parse_status": "skipped", "table_parser_route": "deepdoc", "tenant_id": "default", "title": "中国移动智慧家庭全光组网产品技术规范V2.0.0", "version_id": "v_ab72ce00c904f060"}, "text": "章节：中国移动智慧家庭全光组网产品技术规范V2.0.0 > 第56页 页码：56 51 4.9.2. 远程管理要求 4.9.2.1. 管理协议要求 全光组网终端应支持与管理平台通过加密方式建立交互，实现平台对终端的远程管 控，具体功能及接口请参阅《中国移动智慧家庭全光组网产品入库接口规范》。 4.9.2.2. 远程故障诊断功能 全光组网终端应能配合管理平台实现如下的远程故障诊断功能： 1. 全光组网终端能够接受管理平台的远程控制，执行设备重启、参数设置等操作。 2. 全光组网终端能够配合管理平台对无线用户连接故障进行诊断，呈现家庭网络的 连接拓扑，指明可能的故障原因，并将故障信息上报到管理平台。 3. 全光组网终端能够将设备运行日志上报给管理平台，协助排查终端异常原因。 4.9.2.3. 设备告警功能 全光组网终端应备具有设备告警的功能，能够上传设备的告警信息。 4.9.2.4. 软件远程管理 全光组网终端能够接受管理平台的远程控制，进行软件版本升级。全光组网终端升级 软件时应具有容错校验功能，如果升级失败，应能恢复到原来的软件版本或者连接管理平 台接受再次升级。 4.10. 专项要求 4.10.1. 设备接口要求 4.10.1.1. 上行接口要求 4.10.1.1.1. 光网关上行接口要求 XG-PON Combo 接口可工作在GPON 模式和XG-PON 模式。 光网关上行XG-PON 模式应采用N2a 光模块，应符合《中国移动10G PON 设备规 范》要求； 光网关上行GPON 模式应符合《中国移动GPON 设备规范》要求。光模块应采用Class B+，并与OLT 配合满足Class C+的光链路功率预算。光接口参数应符合G.984.2 Amd1 和 Amd2 的相关要求。"}, "keyword_score": 0.5181183304459509, "normalized_bm25_score": 0.5181183304459509, "rerank_score": null, "retrieval_score": 0.5679289139375375, "score": 0.5679289139375375, "semantic_score": 0.5892763068625033}, {"bm25_score": 24.21115068837926, "chunk": {"document_id": "a2053ec18f1415e4912c510f", "id": "3ef6f0c2eb6c280b4b3a262b", "metadata": {"block_id": "blk_da0c727b1a172288b791", "block_index": 50, "block_type": "paragraph", "business_module": "地址校验", "chunk_index": 50, "chunk_parse_quality_status": "parsed_with_warning", "chunk_parse_warning_codes": [], "content_hash": "ab72ce00c904f060e1a60edb2af37b98f35cb9464f510e1022e29c657a94cf99", "detected_codes": [], "document_ocr_page_count": 0, "document_ocr_status": "not_required", "document_parse_quality_status": "parsed_with_warning", "document_parse_warning_count": 6, "end_unit": 65, "error_codes": [], "extension": ".pdf", "filename": "中国移动智慧家庭全光组网产品技术规范V2.0.0.pdf", "governance_source": "default_curated_policy", "heading_path": ["中国移动智慧家庭全光组网产品技术规范V2.0.0", "第51页"], "knowledge_status": "approved", "media_type": "pdf", "next_block_id": "blk_19513fdd1c53321bc989", "page_number": 51, "page_warning_codes": [], "parent_block_id": "blk_6fa0a328c67a7375954f", "parser_name": "pdf", "parser_strategy": "pymupdf_text_with_page_quality_report", "parser_version": "document-parser-v7", "permission_tags": ["public"], "previous_block_id": "blk_6fa0a328c67a7375954f", "review_status": "approved", "section_path": ["中国移动智慧家庭全光组网产品技术规范V2.0.0", "第51页"], "section_title": "第51页", "source": "中国移动智慧家庭全光组网产品技术规范V2.0.0.pdf", "source_block_ids": ["blk_da0c727b1a172288b791"], "source_path": "/app/data/中国移动智慧家庭全光组网产品技术规范V2.0.0.pdf", "source_type": "manual", "split_index": 0, "start_unit": 0, "table_parse_applied": false, "table_parse_skip_reason": "block_type_is_paragraph", "table_parse_status": "skipped", "table_parser_route": "deepdoc", "tenant_id": "default", "title": "中国移动智慧家庭全光组网产品技术规范V2.0.0", "version_id": "v_ab72ce00c904f060"}, "text": "章节：中国移动智慧家庭全光组网产品技术规范V2.0.0 > 第51页 页码：51 46 4.8. 安全要求 1. 全光组网终端需符合GB/T 41387-2022《信息安全技术 智能家居通用安全规范》 相关安全要求。 2. 全光组网终端需要满足以下具体安全要求： 4.8.1. 防攻击功能 全光组网终端应支持防DoS 攻击功能，能够防止LAND、Ping of Death、SYN Flooding、 ICMP Redirection、Smurf、Winnuke 等类型的攻击。 应能够提供防端口扫描功能，支持防其它设备或者应用的恶意端口扫描。 仅开启提供业务和网管所必需的网络和服务端口，关闭其他所有不使用的网络和服 务端口。 光网关应支持防火墙功能，支持对防火墙等级的设置，支持对防火墙规则的配置，且 支持接收管理平台下发策略进行远程配置。支持基于以下规则对报文进行过滤： （1）支持根据源MAC 地址、目的MAC 地址进行报文过滤； （2）支持根据源IP 地址及范围段、目的IP 地址及范围段进行报文过滤； （3）支持根据IP 源端口及范围段、目的端口及范围段进行报文过滤； （4）支持根据以太网包的传输层协议类型进行报文过滤，要求有IP/PPPoE/ARP 的 选项； （5 ）支持根据 IP 包的传输层协议类型进行报文过滤，要求有 TCP/UDP/ICMP/TCP+UDP/ANY 的选项； （6）支持对匹配规则的报文进行处理模式的选择，对匹配规则的报文的处理模式， 有允许和禁止2 种，默认为禁止模式。 应支持防止用户做源的组播，禁止用户端口发出的IGMP Query 和组播数据报文。 应支持对特定协议的广播/多播包（例如DHCP，ARP，IGMP 等）进行抑制，并能对 其它二层广播报文进行速率限制。 Web 管理界面应避免常见的Web 漏洞，如SQL 注入、致跨站脚本漏洞XSS、跨站请 求伪造CSRF、文件上传、目录遍历等。 在上网业务不受影响的前提下能抵御攻击源数量不低于3000 个，每条流不低于 300pps 的DDoS 攻击。"}, "keyword_score": 0.5113907693269071, "normalized_bm25_score": 0.5113907693269071, "rerank_score": null, "retrieval_score": 0.5538078319678594, "score": 0.5538078319678594, "semantic_score": 0.5719865730996962}], "state": "success", "timeout": false, "trace": {"answer_source": "rag", "augmented_context": "请求ID：999e7c8748e647e694d60968a78d12c5\n会话ID：p6-e2e-run01-qwen-flash-p6s-0124-attempt1\n租户ID：未指定\n用户ID：未指定\n权限标签：未指定\n用户原始问题：设备在远程管理时，如何确保SSH和telnet协议的安全使用？\n归一化查询：设备在远程管理时，如何确保SSH和telnet协议的安全使用？\n是否跟进问答：否\n上下文改写查询：设备在远程管理时，如何确保SSH和telnet协议的安全使用？\n上下文关键术语：无\n改写查询：设备在远程管理时，如何确保SSH和telnet协议的安全使用？\n检索查询：设备在远程管理时，如何确保SSH和telnet协议的安全使用？ 终端设备 设备信息 设备状态 业务说明 知识库 常见问题\n同义词扩展：终端设备, 设备信息, 设备状态\n语义扩展：业务说明, 知识库, 常见问题\n识别意图：general_knowledge\n\n会话历史摘要：\n无\n\n工具调用结果：\n无\n\n检索到的相关文档：\n[1] 来源：中国移动智慧家庭全光组网产品技术规范V2.0.0.pdf\n引用标签：[1]\n标题：第52页\n定位信息：52\n综合分：0.731219\n召回综合分：0.731219\n重排分：无\n语义分：0.616027\nBM25 原始分：47.343738\nBM25 归一化分：1.000000\n内容：章节：中国移动智慧家庭全光组网产品技术规范V2.0.0 > 第52页 页码：52 47 4.8.2. 账号口令 1、禁用调试账号 设备中除为用户提供的唯一账号外，在设备出厂后不应以任何形式在设备中预留任 何其他账号。 2、口令安全 口令应支持足够复杂的策略，口令应满足至少8 位长度要求，且包含字符、数字和特 殊字符等。 4.8.3. WAN 侧接入安全性 除上网业务的交互协议，以及与中国移动业务管理平台的远程连接之外，全光组网终 端不应为其他第三方提供如用户数据分析等服务。 4.8.4. LAN 侧接入安全性 1. WLAN 应支持Open System 和Pre-Shared Key 两种链路层鉴权方式。 2. WLAN 应支持WPA-PSK、WPA2-PSK、WPA-PSK/WPA2-PSK 混和模式、WPA3、 WPA2/WPA3混合模式，应支持AES、TKIP+AES混合加密模式。推荐启用WPA2/WPA3 混合模式和TKIP+AES 混合加密模式。 3. 应支持有线用户和无线用户的MAC 认证，即能对用户终端的MAC 地址进行“黑名 单”（禁止黑名单内的MAC 终端接入网络）、“白名单”（只允许白名单内的MAC 终端接入网络）配置和操作。 4. 应支持国家无线局域网安全标准。 5. 应支持VPN（IP SEC，PPTP，L2TP）透传功能。 4.8.5. 设备端口安全要求 默认情况下，设备应禁用SSH 和telnet 等远程管理协议，包括标准和非标准端口的 SSH 和telnet 协议。如在特殊情况下需要打开SSH 和Telnet 远程管理协议，应设置满足 本规范要求的账户口令验证措施，不应出现空口令或弱口令登录的情况。\n\n[2] 来源：中国移动智慧家庭全光组网产品技术规范V2.0.0.pdf\n引用标签：[2]\n标题：第53页\n定位信息：53\n综合分：0.586340\n召回综合分：0.586340\n重排分：无\n语义分：0.580799\nBM25 原始分：28.371667\nBM25 归一化分：0.599270\n内容：章节：中国移动智慧家庭全光组网产品技术规范V2.0.0 > 第53页 页码：53 48 4.8.6. 管理通道安全要求 1. 应默认禁用串口，如在特殊情况下需要启用串口，必须添加登录密码，且设置满足本 规范要求的账户口令验证措施，不应出现空口令或弱口令登录的情况。 2. 设备不应以隐藏后门、秘密通道等任何形式存在后门，如预留对用户未知的账号、开 放对用户未知的远程管理端口、预设或预留对用户未知的登录方式等。 4.8.7. 固件安全要求 1. 应具备固件更新机制。 2. 固件启动、固件升级时，应对升级文件的来源和完整性进行校验，包括验证升级包的 哈希值、大小、版本号和签名。 3. 固件下载传输通道应确保可信，防止中间人劫持或者嗅探。 4. 固件升级失败后，应确保设备可用性。 4.8.8. 通信安全要求 1. 设备与服务器、控制端设备等进行通信时，应进行身份认证。 2. 应使用安全传输协议保障数据在传输过程中的保密性和完整性，同时对于密钥、身份 认证凭证、用户敏感信息（如口令等）等重要数据应使用加密、签名等保护机制；使 用的安全传输协议应避免使用已公开的不安全版本。 4.8.9. 业务与数据安全要求 1. 数据传输时，应用或系统应具备对数据机密性和完整性保护机制，且用于传输加密的 密钥不应硬编码在代码中。 2. 禁止将登录用户名、密码等登录凭证明文硬编码存储在设备中。 3. 不应在本地存储用户个人敏感数据（如姓名、手机号、邮箱、生物特征等），如果业 务需要必须存储用户个人敏感数据时，应告知用户使用用途，并进行加密。 4. 密钥、证书等关键安全信息应加密保存，禁止明文存储在本地文件中。 5. 对设备密码、设备鉴别信息等关键安全信息进行加密处理，不应在日志和配置文件中 明文记录关键安全信息。\n\n[3] 来源：中国移动智慧家庭全光组网产品技术规范V2.0.0.pdf\n引用标签：[3]\n标题：第56页\n定位信息：56\n综合分：0.567929\n召回综合分：0.567929\n重排分：无\n语义分：0.589276\nBM25 原始分：24.529659\nBM25 归一化分：0.518118\n内容：章节：中国移动智慧家庭全光组网产品技术规范V2.0.0 > 第56页 页码：56 51 4.9.2. 远程管理要求 4.9.2.1. 管理协议要求 全光组网终端应支持与管理平台通过加密方式建立交互，实现平台对终端的远程管 控，具体功能及接口请参阅《中国移动智慧家庭全光组网产品入库接口规范》。 4.9.2.2. 远程故障诊断功能 全光组网终端应能配合管理平台实现如下的远程故障诊断功能： 1. 全光组网终端能够接受管理平台的远程控制，执行设备重启、参数设置等操作。 2. 全光组网终端能够配合管理平台对无线用户连接故障进行诊断，呈现家庭网络的 连接拓扑，指明可能的故障原因，并将故障信息上报到管理平台。 3. 全光组网终端能够将设备运行日志上报给管理平台，协助排查终端异常原因。 4.9.2.3. 设备告警功能 全光组网终端应备具有设备告警的功能，能够上传设备的告警信息。 4.9.2.4. 软件远程管理 全光组网终端能够接受管理平台的远程控制，进行软件版本升级。全光组网终端升级 软件时应具有容错校验功能，如果升级失败，应能恢复到原来的软件版本或者连接管理平 台接受再次升级。 4.10. 专项要求 4.10.1. 设备接口要求 4.10.1.1. 上行接口要求 4.10.1.1.1. 光网关上行接口要求 XG-PON Combo 接口可工作在GPON 模式和XG-PON 模式。 光网关上行XG-PON 模式应采用N2a 光模块，应符合《中国移动10G PON 设备规 范》要求； 光网关上行GPON 模式应符合《中国移动GPON 设备规范》要求。光模块应采用Class B+，并与OLT 配合满足Class C+的光链路功率预算。光接口参数应符合G.984.2 Amd1 和 Amd2 的相关要求。\n\n[4] 来源：中国移动智慧家庭全光组网产品技术规范V2.0.0.pdf\n引用标签：[4]\n标题：第51页\n定位信息：51\n综合分：0.553808\n召回综合分：0.553808\n重排分：无\n语义分：0.571987\nBM25 原始分：24.211151\nBM25 归一化分：0.511391\n内容：章节：中国移动智慧家庭全光组网产品技术规范V2.0.0 > 第51页 页码：51 46 4.8. 安全要求 1. 全光组网终端需符合GB/T 41387-2022《信息安全技术 智能家居通用安全规范》 相关安全要求。 2. 全光组网终端需要满足以下具体安全要求： 4.8.1. 防攻击功能 全光组网终端应支持防DoS 攻击功能，能够防止LAND、Ping of Death、SYN Flooding、 ICMP Redirection、Smurf、Winnuke 等类型的攻击。 应能够提供防端口扫描功能，支持防其它设备或者应用的恶意端口扫描。 仅开启提供业务和网管所必需的网络和服务端口，关闭其他所有不使用的网络和服 务端口。 光网关应支持防火墙功能，支持对防火墙等级的设置，支持对防火墙规则的配置，且 支持接收管理平台下发策略进行远程配置。支持基于以下规则对报文进行过滤： （1）支持根据源MAC 地址、目的MAC 地址进行报文过滤； （2）支持根据源IP 地址及范围段、目的IP 地址及范围段进行报文过滤； （3）支持根据IP 源端口及范围段、目的端口及范围段进行报文过滤； （4）支持根据以太网包的传输层协议类型进行报文过滤，要求有IP/PPPoE/ARP 的 选项； （5 ）支持根据 IP 包的传输层协议类型进行报文过滤，要求有 TCP/UDP/ICMP/TCP+UDP/ANY 的选项； （6）支持对匹配规则的报文进行处理模式的选择，对匹配规则的报文的处理模式， 有允许和禁止2 种，默认为禁止模式。 应支持防止用户做源的组播，禁止用户端口发出的IGMP Query 和组播数据报文。 应支持对特定协议的广播/多播包（例如DHCP，ARP，IGMP 等）进行抑制，并能对 其它二层广播报文进行速率限制。 Web 管理界面应避免常见的Web 漏洞，如SQL 注入、致跨站脚本漏洞XSS、跨站请 求伪造CSRF、文件上传、目录遍历等。 在上网业务不受影响的前提下能抵御攻击源数量不低于3000 个，每条流不低于 300pps 的DDoS 攻击。", "authorized_source_count": 4, "bm25_weight": 0.3, "context_latency_ms": 1.54, "context_terms": [], "contextual_query": "设备在远程管理时，如何确保SSH和telnet协议的安全使用？", "conversation_history_turn_count": 0, "created_at": "2026-11-05T12:15:07.476147+00:00", "degradation_reason": null, "embedding_latency_ms": 168.449, "generation_latency_ms": 1443.064, "intent_confidence": 0.35, "intent_label": "general_knowledge", "intent_latency_ms": 0.038, "intent_reason": "未命中明确业务意图，按通用知识问答处理。", "is_follow_up": false, "keyword_weight": 0.3, "latency_ms": 2042.876, "min_similarity_score": 0.05, "normalized_query": "设备在远程管理时，如何确保SSH和telnet协议的安全使用？", "original_query": "设备在远程管理时，如何确保SSH和telnet协议的安全使用？", "override_degradation_reason": null, "override_hit": false, "override_id": null, "override_type": null, "permission_tags": [], "query_embedding_cache_hit": false, "query_embedding_dimensions": 1024, "query_rewrite_rules": [], "relative_score_threshold": 0.35, "request_id": "999e7c8748e647e694d60968a78d12c5", "rerank_applied": false, "rerank_candidate_k": 20, "rerank_latency_ms": 0.0, "rerank_model": "none", "rerank_provider": "none", "rerank_skip_reason": "provider_disabled", "reranked_count": 4, "retrieval_candidate_k": 20, "retrieval_latency_ms": 595.133, "retrieval_mode": "hybrid", "retrieval_query": "设备在远程管理时，如何确保SSH和telnet协议的安全使用？ 终端设备 设备信息 设备状态 业务说明 知识库 常见问题", "retrieved_count": 4, "rewrite_latency_ms": 0.056, "rewritten_query": "设备在远程管理时，如何确保SSH和telnet协议的安全使用？", "semantic_expansions": ["业务说明", "知识库", "常见问题"], "semantic_weight": 0.7, "session_id": "p6-e2e-run01-qwen-flash-p6s-0124-attempt1", "synonym_expansions": ["终端设备", "设备信息", "设备状态"], "tenant_id": null, "tool_calls": [], "top_k": 4, "user_id": null, "vector_search_latency_ms": 426.662, "vector_store_provider": "postgresql"}, "wall_seconds": 2.0666968999430537}
{"answer": "1. 小型局站有线设备维护中，用于传输的数字传输分析仪型号为10G及以下。[1]  \n2. 该仪器属于维护常用仪表，配套使用于光传输设备测试。[1]  \n3. 未提及具体品牌或详细型号信息。[1]  \n4. 维护规程中明确列出该设备为必备工具之一。[1]  \n5. 具体型号需结合实际采购或配置确定。[1]", "attempt": 1, "case_id": "p6s-0125", "error": null, "finished_at": "2026-11-05T20:15:10.394432+08:00", "model_calls": [{"api_call_id": "7cf74f1eb5af477891150c26bd193443", "kind": "embedding", "request": {"dimensions": 1024, "input": ["小型局站有线设备维护中，用于传输专业的数字传输分析仪型号是什么？ 终端设备 设备信息 设备状态 业务说明 知识库 常见问题"], "model": "text-embedding-v4", "timeout": 3.0}, "response": {"data": [{"embedding": [-0.023838641121983528, 0.008407440036535263, -0.034079283475875854, 0.018191536888480186, 0.03216882050037384, 0.042030178010463715, 0.01133634801954031, 0.09108411520719528, -0.006135254167020321, 0.05130154266953468, 0.02687290497124195, -0.019287243485450745, -0.01725035347044468, 0.052650101482868195, -0.005654126405715942, -0.013731449842453003, 0.024709586054086685, -0.1199096292257309, -0.035146892070770264, -0.012108962051570415, -0.005566329695284367, 0.027519090101122856, 0.005921029485762119, -0.013654189184308052, 0.03455689921975136, 0.0402601920068264, 0.002725218888372183, -0.02424601837992668, 0.032646436244249344, -0.014623467810451984, 0.03436023369431496, -0.07563184201717377, 0.006577751133590937, -0.02414768561720848, 0.048997748643159866, 0.048716798424720764, 0.016365360468626022, 0.024625301361083984, -0.02253222092986107, 0.023726260289549828, 0.0005671685794368386, -0.004979845602065325, -0.004400385543704033, -0.016547977924346924, -0.0401759073138237, 0.03697307035326958, 0.022124843671917915, -0.037815921008586884, -0.03598974645137787, -0.06270812451839447, 0.004755085334181786, -0.03315214440226555, -0.002270430326461792, -0.008070300333201885, -0.03343309462070465, 0.02941550500690937, -0.013541808351874352, -0.03618641197681427, 0.0011220455635339022, 0.019778907299041748, -0.0027831648476421833, 0.03472546860575676, -0.016814880073070526, -0.011181825771927834, 0.05793197080492973, -0.01