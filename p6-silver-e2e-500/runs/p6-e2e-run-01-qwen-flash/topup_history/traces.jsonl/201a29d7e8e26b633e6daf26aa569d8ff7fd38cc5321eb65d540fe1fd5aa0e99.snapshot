P 4.4.2 能接入智能设备、开通应用 4.4.1 物联网基础知识 4.4.2 计算机网络基础知识 3.5 家庭复合总线接入业务运维 4.5.1 能接入交互式网络电视和广电 视听业务 4.5.2 能接入智能设备、开通应用 4.5.3 能通过计算机进行路由配置 4.5.4 能上层拓展、接入社区等不同 管理平台 4.5.1 运营商视听业务基础知识 4.5.2 网络基础知识 4.5.3 智能家居基础知识 4.5.4 管理平台基础知识 5.服务能力 5.1 服务交付能力 5.1.1 能懂得服务礼仪 5.1.2 能进行交付技巧展示 5.1.3 能进行销售技巧展示 5.1.4 能进行沟通技巧展示 5.1.5 能进行维护技巧展示 5.1.1 服务规范基础知识 5.1.2 交付技巧基础知识 5.1.3 销售技巧基础知识 5.1.4 沟通技巧基础知识 5.1.5 维护技术基础知识 6.安全作业 6.1 施工作业安全 6.1.1 能安全施工 6.1.2 能遵守用户信息安全 6.1.1 施工安全知识 6.1.2 用户信息安全知识 6.1.3 网络安全基础知识"}, "keyword_score": 0.4502501281234772, "normalized_bm25_score": 0.4502501281234772, "rerank_score": null, "retrieval_score": 0.5653937608354432, "score": 0.5653937608354432, "semantic_score": 0.6147410319977145}, {"bm25_score": 19.688048683578245, "chunk": {"document_id": "5256824b6b72b3f03d9c7a2c", "id": "1c317b1dd2cebfbf9647d03e", "metadata": {"block_id": "blk_e4bef2211b5bd8cddc76", "block_index": 11, "block_type": "paragraph", "business_module": "通用知识", "chunk_index": 11, "chunk_parse_quality_status": "parsed_with_warning", "chunk_parse_warning_codes": ["bordered_table_detected"], "content_hash": "dcf78195a87f01f45fc99b3af1c541f948a7cc8b6578168c0cb862cf9b620277", "detected_codes": [], "document_ocr_page_count": 0, "document_ocr_status": "not_required", "document_parse_quality_status": "parsed_with_warning", "document_parse_warning_count": 4, "end_unit": 96, "error_codes": [], "extension": ".pdf", "filename": "智慧家庭装维工程与管理职业技能等级标准.pdf", "governance_source": "default_curated_policy", "heading_path": ["智慧家庭装维工程与管理职业技能等级标准", "第12页"], "knowledge_status": "approved", "media_type": "pdf", "next_block_id": "blk_7678536353d72d515bc9", "page_number": 12, "page_warning_codes": ["bordered_table_detected"], "parent_block_id": "blk_941760edda054c582a94", "parser_name": "pdf", "parser_strategy": "pymupdf_text_with_page_quality_report", "parser_version": "document-parser-v7", "permission_tags": ["public"], "previous_block_id": "blk_941760edda054c582a94", "review_status": "approved", "section_path": ["智慧家庭装维工程与管