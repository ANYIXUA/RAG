 室外 226.18 141.36 42.41 42.41 1.24 WH23115005 安装数据交换汇聚单元 228.00 142.50 42.75 42.75 1.25 WH23115006 安装PoE 供电模块 54.72 34.20 10.26 10.26 0.30"}, "keyword_score": 0.9111571460875679, "normalized_bm25_score": 0.9111571460875679, "rerank_score": null, "retrieval_score": 0.7696170674971636, "score": 0.7696170674971636, "semantic_score": 0.708957033815562}, {"bm25_score": 22.844953728147644, "chunk": {"document_id": "c8588238d99d4079e1ec6101", "id": "31ca53eabc210bec4a94da9e", "metadata": {"block_id": "blk_722406ccf06a4f216862", "block_index": 225, "block_type": "paragraph", "business_module": "设备维护", "chunk_index": 225, "chunk_parse_quality_status": "parsed_with_warning", "chunk_parse_warning_codes": ["bordered_table_detected", "semi_structured_table_detected"], "content_hash": "8ae9b63d869002c1950aaf1192e44b0b876ccb9d927154f35e8c48bcd24094bb", "detected_codes": [], "document_ocr_page_count": 0, "document_ocr_status": "not_required", "document_parse_quality_status": "parsed_with_warning", "document_parse_warning_count": 7, "end_unit": 62, "error_codes": [], "extension": ".pdf", "filename": "电信基础设施维护规程.pdf", "governance_source": "default_curated_policy", "heading_path": ["电信基础设施维护规程", "第226页"], "knowledge_status": "approved", "media_type": "pdf", "next_block_id": "blk_890e4a269393c2b21ace", "page_number": 226, "page_warning_codes": ["bordered_table_detected", "semi_structured_table_detected"], "parent_block_id": "blk_7be0657a654ec27bac03", "parser_name": "pdf", "parser_strategy": "pymupdf_text_with_page_quality_report", "parser_version": "document-parser-v7", "permission_tags": ["public"], "previous_block_id": "blk_7be0657a654ec27bac03", "review_status": "approved", "section_path": ["电信基础设施维护规程", "第226页"], "section_title": "第226页", "source": "电信基础设施维护规程.pdf", "source_block_ids": ["blk_722406ccf06a4f216862"], "source_path": "/app/data/电信基础设施维护规程.pdf", "source_type": "manual", "split_index": 0, "start_unit": 0, "table_parse_applied": false, "table_parse_skip_reason": "block_type_is_paragraph", "table_parse_status": "skipped", "table_parser_route": "deepdoc", "tenant_id": "default", "title": "电信基础设施维护规程", "version_id": "v_8ae9b63d869002c1"}, "text": "章节：电信基础设施维护规程 > 第226页 页码：226 T/CAICI XXXX—XXXX 220 10.3 无线通信基站设备和设施维护工作量清单项目综合单价指标 10.3.1 无线通信基站设备和设施日常维护项目综合单价指标 表10.3.1.1 WH21101 基站主设备巡检 工作内容：清洁设备滤网，查看设备工作状态、进行告警处理，检查设备连线和标签标识、防雷模块，进行拨打测试等。 计量单位：三台·次 次 维护分项作业 项目编码 项目名称 综合单价 （元） 其中 名称 人工 人工费(元) 企业管理费(元) 利润(元) 技工 普工 单位 工日 单价(元) 114.00 61.00 WH21101001 基站主设备巡检 市区 18.24 11.40 3.42 3.42 消耗量 0.10 — WH21101002 平原、丘陵 21.89 13.68 4.10 4.10 0.12 — WH21101003 山区 27.36 17.10 5.13 5.13 0.15 — 注：主设备巡检按机房为基本统计单位，以每三台为基本计量单位，不足三台按三台计算。"}, "keyword_score": 1.0, "normalized_bm25_score": 1.0, "rerank_score": null, "retrieval_score": 0.7492955505008193, "score": 0.7492955505008193, "semantic_score": 0.6418507864297419}, {"bm25_score": 17.318994443920342, "chunk": {"document_id": "c8588238d99d4079e1ec6101", "id": "2b084d78117381ea7107de44", "metadata": {"block_id": "blk_48a12b5062cb579c8367", "block_index": 137, "block_type": "paragraph", "business_module": "设备维护", "chunk_index": 137, "chunk_parse_quality_status": "parsed_with_warning", "chunk_parse_warning_codes": ["table_like_text_detected", "bordered_table_detected"], "content_hash": "8ae9b63d869002c1950aaf1192e44b0b876ccb9d927154f35e8c48bcd24094bb", "detected_codes": [], "document_ocr_page_count": 0, "document_ocr_status": "not_required", "document_parse_quality_status": "parsed_with_warning", "document_parse_warning_count": 7, "end_unit": 105, "error_codes": [], "extension": ".pdf", "filename": "电信基础设施维护规程.pdf", "governance_source": "default_curated_policy", "heading_path": ["电信基础设施维护规程", "第138页"], "knowledge_status": "approved", "media_type": "pdf", "next_block_id": "blk_ee3ffed17be608117420", "page_number": 138, "page_warning_codes": ["table_like_text_detected", "bordered_table_detected"], "parent_block_id": "blk_0bf2c675a510a10987d5", "parser_name": "pdf", "parser_strategy": "pymupdf_text_with_page_q