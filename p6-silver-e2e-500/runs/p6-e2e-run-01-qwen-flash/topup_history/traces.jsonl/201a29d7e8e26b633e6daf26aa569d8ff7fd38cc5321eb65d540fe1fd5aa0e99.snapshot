4.1 宽带安装项目 宽带安装项目。维护工作量清单项目设置及工作量计算规则，应按表8.6.4.1 的规定执行。 表8.6.4.1 宽带安装项目（编码：WH411） 项目编码 维护分项作业名称 项目特征 计量单位 维护工作量计算规则 维护工作（操作）内容 WH41101 打穿楼墙洞 砖墙、混凝土 墙 个 1.确定位置 2.打穿墙洞 3.抹水泥等 WH41102 打穿楼层洞 个 不区分材料和结构类型， 按实计列 1.确定位置 2.打穿楼板洞 3.上下抹平等 WH41103 敷设塑料线槽 十米 不区分线槽宽度，按实计 列 1.线槽检查 2.测位 3.安装线槽、挫锐等 WH41104 敷设塑料波纹管 十米 不区分管材直径，按实计 列 1.管材检查 2.测位 3.安装固定等 WH41105 敷设硬质PVC 管 十米 不区分管材直径，按实计 列 1.管材检查 2.配管 3.挫管内口"}, "keyword_score": 0.5803152511793888, "normalized_bm25_score": 0.5803152511793888, "rerank_score": null, "retrieval_score": 0.6109246277746117, "score": 0.6109246277746117, "semantic_score": 0.6240429320297073}]}], "sources": [{"bm25_score": 22.069209727153762, "chunk": {"document_id": "c8588238d99d4079e1ec6101", "id": "6d7a9e41a2a2b736a7746409", "metadata": {"block_id": "blk_d80a61c301fa263f1b9a", "block_index": 323, "block_type": "paragraph", "business_module": "通用知识", "chunk_index": 323, "chunk_parse_quality_status": "parsed_with_warning", "chunk_parse_warning_codes": ["bordered_table_detected"], "content_hash": "8ae9b63d869002c1950aaf1192e44b0b876ccb9d927154f35e8c48bcd24094bb", "detected_codes": [], "document_ocr_page_count": 0, "document_ocr_status": "not_required", "document_parse_quality_status": "parsed_with_warning", "document_parse_warning_count": 7, "end_unit": 39, "error_codes": [], "extension": ".pdf", "filename": "电信基础设施维护规程.pdf", "governance_source": "default_curated_policy", "heading_path": ["电信基础设施维护规程", "第324页"], "knowledge_status": "approved", "media_type": "pdf", "next_block_id": "blk_add305aa36377afac8de", "page_number": 324, "page_warning_codes": ["bordered_table_detected"], "parent_block_id": "blk_d8744a8caa9d5ef37d0c", "parser_name": "pdf", "parser_strategy": "pymupdf_text_with_page_quality_report", "parser_version": "document-parser-v7", "permission_tags": ["public"], "previous_block_id": "blk_d8744a8caa9d5ef37d0c", "review_status": "approved", "section_path": ["电信基础设施维护规程", "第324页"], "section_title": "第324页", "source": "电信基础设施维护规程.pdf", "source_block_ids"