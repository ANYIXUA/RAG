lk_bf9adab9f267ecc9dfb7", "parser_name": "pdf", "parser_strategy": "pymupdf_text_with_page_quality_report", "parser_version": "document-parser-v7", "permission_tags": ["public"], "previous_block_id": "blk_bf9adab9f267ecc9dfb7", "review_status": "approved", "section_path": ["电信基础设施维护规程", "第9页"], "section_title": "第9页", "source": "电信基础设施维护规程.pdf", "source_block_ids": ["blk_e3b63eb065af81a971d8"], "source_path": "/app/data/电信基础设施维护规程.pdf", "source_type": "manual", "split_index": 0, "start_unit": 0, "table_parse_applied": false, "table_parse_skip_reason": "block_type_is_paragraph", "table_parse_status": "skipped", "table_parser_route": "deepdoc", "tenant_id": "default", "title": "电信基础设施维护规程", "version_id": "v_8ae9b63d869002c1"}, "text": "章节：电信基础设施维护规程 > 第9页 页码：9 T/CAICI XXXX—XXXX 3 3.5 维护企业 Maintain the enterprise 指与运营企业签订网络设备及附属设施维护协议，承担相关维护工作的单位。 3.6 光缆 Optical fiber cable 光缆主要是由光导纤维和塑料保护套管及塑料外皮构成。由一定数量的光纤按照一定方式组成缆心， 外包有护套，有的还包覆外护层，用以实现光信号传输的一种通信线路。 3.7 拉线 Pull line 从电杆上端拉入地面的镀锌钢铰线，起到平衡电杆受力的作用，使电杆不向一方倾倒。 3.8 地锚 ground anchor 一般由水泥块加钢筋组成，埋于地下，用于固定拉线，起到稳定拉线的作用。 3.9 吊线 Suspension line 用于吊挂光线的镀锌钢铰线，架设于杆路上端。 3.10 架空线路 Overhead line 由杆路、吊线、拉线组成，光缆挂在吊线上。 3.11 直埋线路 Buried line 光缆直接埋在地下，并在地上设置标石，标石间距不超过200 米。 3.12 管道线路 Pipeline 光缆布放在管道中，设置人（手）孔，人（手）孔的距离不超过150 米。 3.13 接头盒 Cable connector box 光缆接续盒属于机械压力密封接头系统，是相邻光缆间提供光学、密封和机械强度连续性的接续保护 装置。主要是在适用于各种结构光缆的架空、管道、直埋等敷设方式之直通和分支连接。 3.14 镀锌钢绞线 Galvanized Steel Strand"}, "keyword_score": 0.41724946286318415, "normalized_bm25_score": 0.41724946286318415, "rerank_score": null, "retrieval_score": 0.4784683264848869, "score": 0.4784683264848869, "semantic_score": 0.5047049823227595}, {"bm25_score": 9.219351581654108, "chunk": {"document_id": "c8588238d99d4079e1ec6101", "id": "88235f32760b8924182fb676", "metadata": {"block_id": "blk_957a8d9999c7d71c0a70", "block_index": 255, "block_type": "paragraph", "business_module": "通用知识", "chunk_index": 255, "chunk_parse_quality_status": "parsed_with_warning", "chunk_parse_warning_codes": ["bordered_ta