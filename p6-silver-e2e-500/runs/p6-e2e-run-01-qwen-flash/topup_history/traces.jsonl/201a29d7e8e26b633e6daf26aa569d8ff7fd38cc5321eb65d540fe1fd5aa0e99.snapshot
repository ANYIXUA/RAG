ge_number": 29, "page_warning_codes": ["bordered_table_detected"], "parent_block_id": "blk_96bc4aee94fa2991f222", "parser_name": "pdf", "parser_strategy": "pymupdf_text_with_page_quality_report", "parser_version": "document-parser-v7", "permission_tags": ["public"], "previous_block_id": "blk_96bc4aee94fa2991f222", "review_status": "approved", "section_path": ["电信基础设施维护规程", "第29页"], "section_title": "第29页", "source": "电信基础设施维护规程.pdf", "source_block_ids": ["blk_33c547ef489c9ff2c213"], "source_path": "/app/data/电信基础设施维护规程.pdf", "source_type": "manual", "split_index": 0, "start_unit": 0, "table_parse_applied": false, "table_parse_skip_reason": "block_type_is_paragraph", "table_parse_status": "skipped", "table_parser_route": "deepdoc", "tenant_id": "default", "title": "电信基础设施维护规程", "version_id": "v_8ae9b63d869002c1"}, "text": "章节：电信基础设施维护规程 > 第29页 页码：29 T/CAICI XXXX—XXXX 23 路 面 维 护 巡查 一级、二级线路、 本地网等各类线路 1~2 次/周； 不得漏巡；一级、二级线路、本地网等各类线路的徒步巡回 每月不得少于2 次。暴风雨后或有外力影响可能造成线路障 碍隐患时，应立即巡回。高速公路中线路的巡回周期为2~3 次/月。 标志牌 除草、培土 按需 标准牌周围50 厘米内无杂草。 油漆、描字 年 可视具体情况缩短周期。 路由探测、修路 年 可结合徒步巡回进行 抽除管道线路人孔内的 积水 按需 可视具体情况缩短周期。 管道线路的人（手）孔 检修 半年 高速公路中人孔的检修按需进行 杆路 维护 整理、更换挂钩，检修镀锌钢 绞线 年 清除架空线路上和镀锌钢绞 线上的杂物 按需 杆路检修 年 可结合巡回进行 管 道 光 缆 维 护 巡回 1～2 次/周 不得漏巡；徒步巡回每月不得少于2 次，暴风雨后或有外力 影响可能造成线路故障的隐患时应立即巡回和加强巡回。高 速公路中线路巡回周期为2～3 次/月，外力施工现场按需随 工监督，必要时日夜值守。每月按时提交巡回原始记录。 标石(桩)、宣 传牌 除草、培土 及时 标石(桩)、宣传牌周围50 厘米内无杂草（可结合巡回进行）。 扶正、更换 及时 油漆、描字 及时 齐全清晰可见 路由探测、砍草修路 及时 维护人员对路由熟悉，路由无杂草 人孔、手孔 更换井盖 及时 人（手）井井圈、井盖、内壁完好，井号清晰可见，无垃圾， 无渗水，大管、子管堵塞齐全，光缆标志牌齐全清晰可见， 光缆、接头盒挂靠安全，光缆防护措施齐备，子管和光缆的 井号油漆、描 字 及时"}, "keyword_score": 1.0, "normalized_bm25_score": 1.0, "rerank_score": null, "retrieval_score": 0.8196235525832452, "score": 0.8196235525832452, "semantic_score": 0.7423193608332075}, {"bm25_score": 44.37446398926564, "chunk": {"document_id": "c8588238d99d4079e1ec6101", "id": "362c9e604739de54353d1864", "metadata": {"block_id": "blk_fcf0b5b7d27d0845c836", "block_index": 29, "block_type": "paragraph", "business_module": "通用知识", "chunk_index": 29, "chu