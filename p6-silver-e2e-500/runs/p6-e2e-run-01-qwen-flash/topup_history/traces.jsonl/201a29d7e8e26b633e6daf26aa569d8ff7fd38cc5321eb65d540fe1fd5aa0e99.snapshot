f35cb9464f510e1022e29c657a94cf99", "detected_codes": [], "document_ocr_page_count": 0, "document_ocr_status": "not_required", "document_parse_quality_status": "parsed_with_warning", "document_parse_warning_count": 6, "end_unit": 57, "error_codes": [], "extension": ".pdf", "filename": "中国移动智慧家庭全光组网产品技术规范V2.0.0.pdf", "governance_source": "default_curated_policy", "heading_path": ["中国移动智慧家庭全光组网产品技术规范V2.0.0", "第7页"], "knowledge_status": "approved", "media_type": "pdf", "next_block_id": "blk_17651398ca54c859e41b", "page_number": 7, "page_warning_codes": ["bordered_table_detected"], "parent_block_id": "blk_6ad6b85f63d11a46a03d", "parser_name": "pdf", "parser_strategy": "pymupdf_text_with_page_quality_report", "parser_version": "document-parser-v7", "permission_tags": ["public"], "previous_block_id": "blk_6ad6b85f63d11a46a03d", "review_status": "approved", "section_path": ["中国移动智慧家庭全光组网产品技术规范V2.0.0", "第7页"], "section_title": "第7页", "source": "中国移动智慧家庭全光组网产品技术规范V2.0.0.pdf", "source_block_ids": ["blk_204870b80b5e89f7aa67"], "source_path": "/app/data/中国移动智慧家庭全光组网产品技术规范V2.0.0.pdf", "source_type": "manual", "split_index": 0, "start_unit": 0, "table_parse_applied": false, "table_parse_skip_reason": "block_type_is_paragraph", "table_parse_status": "skipped", "table_parser_route": "deepdoc", "tenant_id": "default", "title": "中国移动智慧家庭全光组网产品技术规范V2.0.0", "version_id": "v_ab72ce00c904f060"}, "text": "章节：中国移动智慧家庭全光组网产品技术规范V2.0.0 > 第7页 页码：7 2 1.4. 名词解释 1.4.1. 光网关 光网关是连接家庭网络和外部网络的智能化网关单元，可通过各种网络侧接口与接入 节点/接入网相连，并通过用户侧接口（光口、电口）等适配设备与用户终端设备相连， 同时可通过安装插件等方式与上层平台交互提供增值功能。 家庭网络内部各种无线Wi-Fi 终端（如手机、笔记本电脑、平板电脑、智能家居设备 等）可以通过光网关用户侧WLAN 接口接入家庭无线网络。 光网关可通过和家亲APP 远程管理，并具备保持家庭网络内多个光路由间的统一 SSID 能力。 1.4.2. 光路由 光路由是家庭宽带用户网络内，延伸光网关无线局域网网络覆盖的终端设备。 家庭网络内部各种无线Wi-Fi 终端（如手机、笔记本电脑、平板电脑、智能家居设备 等）可以通过光路由用户侧WLAN 接口接入家庭无线网络，并经由光网关接入外部网络。 光路由通过光纤接入光网关，通过本地适配器供电或光电混合缆由上级终端统一供电。 光路由可通过和家亲APP 远程管理，在同一局域网内部可同时存在多台光路由，向 家庭提供更广的无线网络覆盖范围。 1.4.3. 产品名称、产品名称码、产品型号 产品名称是指本规范第4 章定义的设备形态名称，产品名称码如下表所示： 产品名称码 产品名称 16，50 Wi-Fi 6 光网关 52，53 Wi-Fi 7 光网关 55 无频光网关1 16，60 Wi-Fi 6 光路由 62，63 Wi-Fi 7 光路由 1允许无频光网关产品入库，无须支持Wi-Fi功能，其他规格须不低于Wi-Fi 6光网关要求。"}, "keyword_score": 1.0, "normalized_bm25_score": 1.0, "rerank_score": null, "retrieval_score": 0.819690533885644, "score": 0.819690533885644, "semantic_score": 0.7424150484080628}, {"bm25_score": 50.05364094448929, "chunk": {"document_id": "a2053ec18f1415e4912c510f", "id": "c120df3a569ae215d69183ac", "metadata": {"block_id": "blk_0e9f34a5017e65493591", "block_index": 60, "block_type": "paragraph", "business_module": "地址校验", "chunk_index": 60, "chunk_parse_quality_status": "parsed_with_warning", "chunk_parse_warning_codes": ["table_like_text_detected", "semi_structured_table_detected"], "content_hash": "ab72ce00c904f060e1a60edb2af37b98f35cb9464f510e1022e29c657a94cf99", "detected_codes": [], "document_ocr_page_count": 0, "document_ocr_status": "not_required", "document_parse_quality_status": "parsed_with_warning", "document_parse_warning_count": 6, "end_unit": 42, "error_codes": [], "extension": ".pdf", "filename": "中国移动智慧家庭全光组网产品技术规范V2.0.0.pdf", "governance_source": "default_curated_policy", "heading_path": ["中国移动智慧家庭全光组网产品技术规范V2.0.0", "第61页"], "knowledge_status": "approved", "media_type": "pdf", "next_block_id": "blk_064e0f6da6396f3bb0f4", "page_number": 61, "page_warning_codes": ["table_like_text_detected", "semi_structured_table_detected"], "parent_block_id": "blk_c4b3e58e5ce3e156f087", "parser_name": "pdf", "parser_strategy": "pymupdf_text_with_page_quality_report", "parser_version": "document-parser-v7", "permission_tags": ["public"], "previous_block_id": "blk_c4b3e58e5ce3e156f087", "review_status": "approved", "section_path": ["中国移动智慧家庭全光组网产品技术规范V2.0.0", "第61页"], "section_title": "第61页", "source": "中国移动智慧家庭全光组网产品技术规范V2.0.0.pdf", "source_block_ids": ["blk_0e9f34a5017e65493591"], "source_path": "/app/data/中国移动智慧家庭全光组网产品技术规范V2.0.0.pdf", "source_type": "manual", "split_index": 0, "start_unit": 0, "table_parse_applied": false, "table_parse_skip_reason": "block_type_is_paragraph", "table_parse_status": "skipped", "table_parser_route": "deepdoc", "tenant_id": "default", "title": "中国移动智慧家庭全光组网产品技术规范V2.0.0", "version_id": "v_ab72ce00c904f060"}, "text": "章节：中国移动智慧家庭全光组网产品技术规范V2.0.0 > 第61页 页码：61 56 A.2 光路由终端二维码标识要求 二维码内容： （1）ssid1：设备的Wi-Fi名称，需与设备背面板的“默认无线网络名称”一致，一般 使用2.4G的SSID； （2）wifipwd：设备的Wi-Fi密码，需与设备背面板的“默认无线网络密钥”一致； （3）username：用户帐号，需与设备背面板的“默认终端配置帐号”一致；注：如 果此设备只使用密码登录，则username可填写空值； （4）userpwd：用户密码，需与设备背面板的“默认终端配置密码”一致； （5）productname: 产品名称码，2位阿拉伯数字； （6）mac：全光组网终端MAC地址； （7）sn：全光组网终端的SN； （8）cmei: 全光组网终端的CMEI号，具体编码规则请参考《中国移动非蜂窝类智能 硬件产品统一编码规范》； （9）ip：终端配置地址，如192.168.10.1，需与设备背面板的“默认终端配置地址” 一致; （10）vendor：全光组网终端合作伙伴名称，使用智家中心分配的厂商编码； （11）model：全光组网终端的产品型号，使用智家中心分配的型号编码。 （12）date：智能设备生产日期，6字节，格式xxxxxx，前4字节表示年，后2字节表示 月，例如：201901表示2019年1月。 二维码内容格式要求： 二维码内容所有符号为英文半角；用“&”把所有字段连起来，“&”左右无空格。 【实例】 ssid1=CMCC-xxx(无线网络名称)&wifipwd=xxx(无线网络密钥)&username=xxx（终端 配置帐号）&userpwd=xxx(终端配置密码)&ip=192.168.10.1&productname=xxx(产品名称 码)& mac=xxx( 终端MAC 地址)&sn=xxx( 终端的SN)&cmei=xxx( 终端的CMEI)& vendor=xxx(合作伙伴名称)&model=xxx(产品型号)&date=xxx(生产日期) 表格列：3.；二维码要求： （1）颜色：黑色； （2）黏贴位置：组网终端背面；"}, "keyword_score": 0.5590527767240883, "normalized_bm25_score": 0.5590527767240883, "rerank_score": null, "retrieval_score": 0.7082782909885064, "score": 0.7082782909885064, "semantic_score": 0.7722320828161141}, {"bm25_score": 43.01366313783375, "chunk": {"document_id": "a2053ec18f1415e4912c510f", "id": "3b8f42f7061b1f1a8e2205a6", "metadata": {"block_id": "blk_d3aff3b6d011d71e5f93", "block_index": 7, "block_type": "paragraph", "business_module": "设备维护", "chunk_index": 7, "chunk_parse_quality_status": "parsed_with_warning", "chunk_parse_warning_codes": ["bordered_table_detected"], "content_hash": "ab72ce00c904f060e1a60edb2af37b98f35cb9464f510e1022e29c657a94cf99", "detected_codes": [], "document_ocr_page_count": 0, "document_ocr_status": "not_required", "document_parse_quality_status": "parsed_with_warning", "document_parse_warning_count": 6, "end_unit": 113, "error_codes": [], "extension": ".pdf", "filename": "中国移动智慧家庭全光组网产品技术规范V2.0.0.pdf", "governance_source": "default_curated_policy", "heading_path": ["中国移动智慧家庭全光组网产品技术规范V2.0.0", "第8页"], "knowledge_status": "approved", "media_type": "pdf", "next_block_id": "blk_1d6b0ca0c2f9f8830907", "page_number": 8, "page_warning_codes": ["bordered_table_detected"], "parent_block_id": "blk_17651398ca54c859e41b", "parser_name": "pdf", "parser_strategy": "pymupdf_text_with_page_quality_report", "parser_version": "document-parser-v7", "permission_tags": ["public"], "previous_block_id": "blk_17651398ca54c859e41b", "review_status": "approved", "section_path": ["中国移动智慧家庭全光组网产品技术规范V2.0.0", "第8页"], "section_title": "第8页", "source": "中国移动智慧家庭全光组网产品技术规范V2.0.0.pdf", "source_block_ids": ["blk_d3aff3b6d011d71e5f93"], "source_path": "/app/data/中国移动智慧家庭全光组网产品技术规范V2.0.0.pdf", "source_type": "manual", "split_index": 0, "start_unit": 0, "table_parse_applied": false, "table_parse_skip_reason": "block_type_is_paragraph", "table_parse_status": "skipped", "table_parser_route": "deepdoc", "tenant_id": "default", "title": "中国移动智慧家庭全光组网产品技术规范V2.0.0", "version_id": "v_ab72ce00c904f060"}, "text": "章节：中国移动智慧家庭全光组网产品技术规范V2.0.0 > 第8页 页码：8 3 说明： 1）Wi-Fi 6 光网关产品编码为50，Wi-Fi 7 光网关产品编码为52、53，无频光网关产 品编码为55，另有51、54 备用；Wi-Fi 6 光路由产品编码为60，Wi-Fi 7 光路由 产品编码为62、63，另有61、64 备用；已入库全光组网终端（含光网关、光路 由）继续使用产品编码为16，新入库产品不再分配该产品编码。 产品型号是指各厂家自定义的型号或名称（不应包含*（）等特殊字符），如“HN300”。 1.4.4. 缩略语 下列缩略语适用于本标准： 缩略语 全称 解释 API Application Programming Interface 应用程序编程接口 APP Application 手机客户端软件 BSS Basic Service Set 基本服务集合 CQC China Quality Certification Center 中国质量认证中心 DCM Dual Carrier Modulation 双载波调制 DHCP Dynamic Host Configuration Protocol 动态主机配置协议 EMLSR Enhanced Multilink Single-Radio 增强型多链路单射频 FTTH Fiber to The Home 光纤入户 FTTR Fiber to The Room 光纤到房间 GE Gigabit Ethernet 千兆以太网 GPON Gigabit Passive Optical Network 千兆无源光网络 IGMP Internet Group Management Protocol 网间组信息协议 IPTV Internet Protocol Television 交互式网络电视 LAN Local Area Network 局域网 LDPC Low-density Parity-check 低密度奇偶校验 MAC Medium Access Control 媒质访问控制 MLO Multi-Link Operation 多链路操作"}, "keyword_score": 0.48042274968466586, "normalized_bm25_score": 0.48042274968466586, "rerank_score": null, "retrieval_score": 0.692357631003933, "score": 0.692357631003933, "semantic_score": 0.7831868658550476}, {"bm25_score": 61.82173691443302, "chunk": {"document_id": "a2053ec18f1415e4912c510f", "id": "e69ef87cafd302938c765e20", "metadata": {"block_id": "blk_c9b952d90e55927ad69b", "block_index": 14, "block_type": "paragraph", "business_module": "设备维护", "chunk_index": 14, "chunk_parse_quality_status": "parsed_with_warning", "chunk_parse_warning_codes": ["bordered_table_detected", "semi_structured_table_detected"], "content_hash": "ab72ce00c904f060e1a60edb2af37b98f35cb9464f510e1022e29c657a94cf99", "detected_codes": [], "document_ocr_page_count": 0, "document_ocr_status": "not_required", "document_parse_quality_status": "parsed_with_warning", "document_parse_warning_count": 6, "end_unit": 94, "error_codes": [], "extension": ".pdf", "filename": "中国移动智慧家庭全光组网产品技术规范V2.0.0.pdf", "governance_source": "default_curated_policy", "heading_path": ["中国移动智慧家庭全光组网产品技术规范V2.0.0", "第15页"], "knowledge_status": "approved", "media_type": "pdf", "next_block_id": "blk_fdf91a2f6aae57de2189", "page_number": 15, "page_warning_codes": ["bordered_table_detected", "semi_structured_table_detected"], "parent_block_id": "blk_1f95d48adc1fd3c54089", "parser_name": "pdf", "parser_strategy": "pymupdf_text_with_page_quality_report", "parser_version": "document-parser-v7", "permission_tags": ["public"], "previous_block_id": "blk_1f95d48adc1fd3c54089", "review_status": "approved", "section_path": ["中国移动智慧家庭全光组网产品技术规范V2.0.0", "第15页"], "section_title": "第15页", "source": "中国移动智慧家庭全光组网产品技术规范V2.0.0.pdf", "source_block_ids": ["blk_c9b952d90e55927ad69b"], "source_path": "/app/data/中国移动智慧家庭全光组网产品技术规范V2.0.0.pdf", "source_type": "manual", "split_index": 0, "start_unit": 0, "table_parse_applied": false, "table_parse_skip_reason": "block_type_is_paragraph", "table_parse_status": "skipped", "table_parser_route": "deepdoc", "tenant_id": "default", "title": "中国移动智慧家庭全光组网产品技术规范V2.0.0", "version_id": "v_ab72ce00c904f060"}, "text": "章节：中国移动智慧家庭全光组网产品技术规范V2.0.0 > 第15页 页码：15 10 4. 产品入库要求 4.1. 基本要求 4.1.1. 接入要求 全光组网终端均需支持EasyMesh 功能，其中光网关的Mesh 角色为Controller，光路 由的Mesh 角色为Agent。 光网关在遵循本规范基础上，需同步遵循最新版本《中国移动智能家庭网关技术规范》 和相关管理接口要求，实现RMS 平台纳管。 光网关应支持基于光路由的逻辑标识对光路由合法性进行认证的能力，应拒绝非法光 路由接入。 4.2. 设备形态 全光组网终端主要用于家庭用户和泛家庭用户，提供以太网/IP 类业务接入能力。全 光组网终端设备的硬件设计、天线连接等应稳定可靠。 表4-1 设备形态 产品类型 光网关 光路由 产品名称 Wi-Fi 7 光网关 Wi-Fi 6 光网关 Wi-Fi 7 光路由 Wi-Fi 6 光路由 网络侧接口 (WAN 口) 不低于XG-PON 推荐支持XG-PON Combo 2.5G 非对称 推荐支持2.5G 对称 用户 侧接 口 网络 接口 1 个光口 最大物理分光比不低于支持1:8 面板式：不少于1×GE 其他：不少于2×GE，至 少有1 个网口支持2.5GE 面板式：不少于1×GE 其他：不少于2×GE 不少于2×GE，至少有 1 个网口支持2.5GE 不少于2×GE WLAN 接口 2.4GHz 802.11be （2×2） + 5GHz 2.4GHz 802.11ax （2×2） + 5GHz 2.4GHz 802.11be （2×2） + 5GHz 2.4GHz 802.11ax （2×2） + 5GHz"}, "keyword_score": 0.6904915013525095, "normalized_bm25_score": 0.6904915013525095, "rerank_score": null, "retrieval_score": 0.6860083616724479, "score": 0.6860083616724479, "semantic_score": 0.6840870160952788}]}], "sources": [{"bm25_score": 89.53294398749132, "chunk": {"document_id": "a2053ec18f1415e4912c510f", "id": "d349f789d2e652960680ae1c", "metadata": {"block_id": "blk_204870b80b5e89f7aa67", "block_index": 6, "block_type": "paragraph", "business_module": "设备维护", "chunk_index": 6, "chunk_parse_quality_status": "parsed_with_warning", "chunk_parse_warning_codes": ["bordered_table_detected"], "content_hash": "ab72ce00c904f060e1a60edb2af37b98f35cb9464f510e1022e29c657a94cf99", "detected_codes": [], "document_ocr_page_count": 0, "document_ocr_status": "not_required", "document_parse_quality_status": "parsed_with_warning", "document_parse_warning_count": 6, "end_unit": 57, "error_codes": [], "extension": ".pdf", "filename": "中国移动智慧家庭全光组网产品技术规范V2.0.0.pdf", "governance_source": "default_curated_policy", "heading_path": ["中国移动智慧家庭全光组网产品技术规范V2.0.0", "第7页"], "knowledge_status": "approved", "media_type": "pdf", "next_block_id": "blk_17651398ca54c859e41b", "page_number": 7, "page_warning_codes": ["bordered_table_detected"], "parent_block_id": "blk_6ad6b85f63d11a46a03d", "parser_name": "pdf", "parser_strategy": "pymupdf_text_with_page_quality_report", "parser_version": "document-parser-v7", "permission_tags": ["public"], "previous_block_id": "blk_6ad6b85f63d11a46a03d", "review_status": "approved", "section_path": ["中国移动智慧家庭全光组网产品技术规范V2.0.0", "第7页"], "section_title": "第7页", "source": "中国移动智慧家庭全光组网产品技术规范V2.0.0.pdf", "source_block_ids": ["blk_204870b80b5e89f7aa67"], "source_path": "/app/data/中国移动智慧家庭全光组网产品技术规范V2.0.0.pdf", "source_type": "manual", "split_index": 0, "start_unit": 0, "table_parse_applied": false, "table_parse_skip_reason": "block_type_is_paragraph", "table_parse_status": "skipped", "table_parser_route": "deepdoc", "tenant_id": "default", "title": "中国移动智慧家庭全光组网产品技术规范V2.0.0", "version_id": "v_ab72ce00c904f060"}, "text": "章节：中国移动智慧家庭全光组网产品技术规范V2.0.0 > 第7页 页码：7 2 1.4. 名词解释 1.4.1. 光网关 光网关是连接家庭网络和外部网络的智能化网关单元，可通过各种网络侧接口与接入 节点/接入网相连，并通过用户侧接口（光口、电口）等适配设备与用户终端设备相连， 同时可通过安装插件等方式与上层平台交互提供增值功能。 家庭网络内部各种无线Wi-Fi 终端（如手机、笔记本电脑、平板电脑、智能家居设备 等）可以通过光网关用户侧WLAN 接口接入家庭无线网络。 光网关可通过和家亲APP 远程管理，并具备保持家庭网络内多个光路由间的统一 SSID 能力。 1.4.2. 光路由 光路由是家庭宽带用户网络内，延伸光网关无线局域网网络覆盖的终端设备。 家庭网络内部各种无线Wi-Fi 终端（如手机、笔记本电脑、平板电脑、智能家居设备 等）可以通过光路由用户侧WLAN 接口接入家庭无线网络，并经由光网关接入外部网络。 光路由通过光纤接入光网关，通过本地适配器供电或光电混合缆由上级终端统一供电。 光路由可通过和家亲APP 远程管理，在同一局域网内部可同时存在多台光路由，向 家庭提供更广的无线网络覆盖范围。 1.4.3. 产品名称、产品名称码、产品型号 产品名称是指本规范第4 章定义的设备形态名称，产品名称码如下表所示： 产品名称码 产品名称 16，50 Wi-Fi 6 光网关 52，53 Wi-Fi 7 光网关 55 无频光网关1 16，60 Wi-Fi 6 光路由 62，63 Wi-Fi 7 光路由 1允许无频光网关产品入库，无须支持Wi-Fi功能，其他规格须不低于Wi-Fi 6光网关要求。"}, "keyword_score": 1.0, "normalized_bm25_score": 1.0, "rerank_score": null, "retrieval_score": 0.819690533885644, "score": 0.819690533885644, "semantic_score": 0.7424150484080628}, {"bm25_score": 50.05364094448929, "chunk": {"document_id": "a2053ec18f1415e4912c510f", "id": "c120df3a569ae215d69183ac", "metadata": {"block_id": "blk_0e9f34a5017e65493591", "block_index": 60, "block_type": "paragraph", "business_module": "地址校验", "chunk_index": 60, "chunk_parse_quality_status": "parsed_with_warning", "chunk_parse_warning_codes": ["table_like_text_detected", "semi_structured_table_detected"], "content_hash": "ab72ce00c904f060e1a60edb2af37b98f35cb9464f510e1022e29c657a94cf99", "detected_codes": [], "document_ocr_page_count": 0, "document_ocr_status": "not_required", "document_parse_quality_status": "parsed_with_warning", "document_parse_warning_count": 6, "end_unit": 42, "error_codes": [], "extension": ".pdf", "filename": "中国移动智慧家庭全光组网产品技术规范V2.0.0.pdf", "governance_source": "default_curated_policy", "heading_path": ["中国移动智慧家庭全光组网产品技术规范V2.0.0", "第61页"], "knowledge_status": "approved", "media_type": "pdf", "next_block_id": "blk_064e0f6da6396f3bb0f4", "page_number": 61, "page_warning_codes": ["table_like_text_detected", "semi_structured_table_detected"], "parent_block_id": "blk_c4b3e58e5ce3e156f087", "parser_name": "pdf", "parser_strategy": "pymupdf_text_with_page_quality_report", "parser_version": "document-parser-v7", "permission_tags": ["public"], "previous_block_id": "blk_c4b3e58e5ce3e156f087", "review_status": "approved", "section_path": ["中国移动智慧家庭全光组网产品技术规范V2.0.0", "第61页"], "section_title": "第61页", "source": "中国移动智慧家庭全光组网产品技术规范V2.0.0.pdf", "source_block_ids": ["blk_0e9f34a5017e65493591"], "source_path": "/app/data/中国移动智慧家庭全光组网产品技术规范V2.0.0.pdf", "source_type": "manual", "split_index": 0, "start_unit": 0, "table_parse_applied": false, "table_parse_skip_reason": "block_type_is_paragraph", "table_parse_status": "skipped", "table_parser_route": "deepdoc", "tenant_id": "default", "title": "中国移动智慧家庭全光组网产品技术规范V2.0.0", "version_id": "v_ab72ce00c904f060"}, "text": "章节：中国移动智慧家庭全光组网产品技术规范V2.0.0 > 第61页 页码：61 56 A.2 光路由终端二维码标识要求 二维码内容： （1）ssid1：设备的Wi-Fi名称，需与设备背面板的“默认无线网络名称”一致，一般 使用2.4G的SSID； （2）wifipwd：设备的Wi-Fi密码，需与设备背面板的“默认无线网络密钥”一致； （3）username：用户帐号，需与设备背面板的“默认终端配置帐号”一致；注：如 果此设备只使用密码登录，则username可填写空值； （4）userpwd：用户密码，需与设备背面板的“默认终端配置密码”一致； （5）productname: 产品名称码，2位阿拉伯数字； （6）mac：全光组网终端MAC地址； （7）sn：全光组网终端的SN； （8）cmei: 全光组网终端的CMEI号，具体编码规则请参考《中国移动非蜂窝类智能 硬件产品统一编码规范》； （9）ip：终端配置地址，如192.168.10.1，需与设备背面板的“默认终端配置地址” 一致; （10）vendor：全光组网终端合作伙伴名称，使用智家中心分配的厂商编码； （11）model：全光组网终端的产品型号，使用智家中心分配的型号编码。 （12）date：智能设备生产日期，6字节，格式xxxxxx，前4字节表示年，后2字节表示 月，例如：201901表示2019年1月。 二维码内容格式要求： 二维码内容所有符号为英文半角；用“&”把所有字段连起来，“&”左右无空格。 【实例】 ssid1=CMCC-xxx(无线网络名称)&wifipwd=xxx(无线网络密钥)&username=xxx（终端 配置帐号）&userpwd=xxx(终端配置密码)&ip=192.168.10.1&productname=xxx(产品名称 码)& mac=xxx( 终端MAC 地址)&sn=xxx( 终端的SN)&cmei=xxx( 终端的CMEI)& vendor=xxx(合作伙伴名称)&model=xxx(产品型号)&date=xxx(生产日期) 表格列：3.；二维码要求： （1）颜色：黑色； （2）黏贴位置：组网终端背面；"}, "keyword_score": 0.5590527767240883, "normalized_bm25_score": 0.5590527767240883, "rerank_score": null, "retrieval_score": 0.7082782909885064, "score": 0.7082782909885064, "semantic_score": 0.7722320828161141}, {"bm25_score": 43.01366313783375, "chunk": {"document_id": "a2053ec18f1415e4912c510f", "id": "3b8f42f7061b1f1a8e2205a6", "metadata": {"block_id": "blk_d3aff3b6d011d71e5f93", "block_index": 7, "block_type": "paragraph", "business_module": "设备维护", "chunk_index": 7, "chunk_parse_quality_status": "parsed_with_warning", "chunk_parse_warning_codes": ["bordered_table_detected"], "content_hash": "ab72ce00c904f060e1a60edb2af37b98f35cb9464f510e1022e29c657a94cf99", "detected_codes": [], "document_ocr_page_count": 0, "document_ocr_status": "not_required", "document_parse_quality_status": "parsed_with_warning", "document_parse_warning_count": 6, "end_unit": 113, "error_codes": [], "extension": ".pdf", "filename": "中国移动智慧家庭全光组网产品技术规范V2.0.0.pdf", "governance_source": "default_curated_policy", "heading_path": ["中国移动智慧家庭全光组网产品技术规范V2.0.0", "第8页"], "knowledge_status": "approved", "media_type": "pdf", "next_block_id": "blk_1d6b0ca0c2f9f8830907", "page_number": 8, "page_warning_codes": ["bordered_table_detected"], "parent_block_id": "blk_17651398ca54c859e41b", "parser_name": "pdf", "parser_strategy": "pymupdf_text_with_page_quality_report", "parser_version": "document-parser-v7", "permission_tags": ["public"], "previous_block_id": "blk_17651398ca54c859e41b", "review_status": "approved", "section_path": ["中国移动智慧家庭全光组网产品技术规范V2.0.0", "第8页"], "section_title": "第8页", "source": "中国移动智慧家庭全光组网产品技术规范V2.0.0.pdf", "source_block_ids": ["blk_d3aff3b6d011d71e5f93"], "source_path": "/app/data/中国移动智慧家庭全光组网产品技术规范V2.0.0.pdf", "source_type": "manual", "split_index": 0, "start_unit": 0, "table_parse_applied": false, "table_parse_skip_reason": "block_type_is_paragraph", "table_parse_status": "skipped", "table_parser_route": "deepdoc", "tenant_id": "default", "title": "中国移动智慧家庭全光组网产品技术规范V2.0.0", "version_id": "v_ab72ce00c904f060"}, "text": "章节：中国移动智慧家庭全光组网产品技术规范V2.0.0 > 第8页 页码：8 3 说明： 1）Wi-Fi 6 光网关产品编码为50，Wi-Fi 7 光网关产品编码为52、53，无频光网关产 品编码为55，另有51、54 备用；Wi-Fi 6 光路由产品编码为60，Wi-Fi 7 光路由 产品编码为62、63，另有61、64 备用；已入库全光组网终端（含光网关、光路 由）继续使用产品编码为16，新入库产品不再分配该产品编码。 产品型号是指各厂家自定义的型号或名称（不应包含*（）等特殊字符），如“HN300”。 1.4.4. 缩略语 下列缩略语适用于本标准： 缩略语 全称 解释 API Application Programming Interface 应用程序编程接口 APP Application 手机客户端软件 BSS Basic Service Set 基本服务集合 CQC China Quality Certification Center 中国质量认证中心 DCM Dual Carrier Modulation 双载波调制 DHCP Dynamic Host Configuration Protocol 动态主机配置协议 EMLSR Enhanced Multilink Single-Radio 增强型多链路单射频 FTTH Fiber to The Home 光纤入户 FTTR Fiber to The Room 光纤到房间 GE Gigabit Ethernet 千兆以太网 GPON Gigabit Passive Optical Network 千兆无源光网络 IGMP Internet Group Management Protocol 网间组信息协议 IPTV Internet Protocol Television 交互式网络电视 LAN Local Area Network 局域网 LDPC Low-density Parity-check 低密度奇偶校验 MAC Medium Access Control 媒质访问控制 MLO Multi-Link Operation 多链路操作"}, "keyword_score": 0.48042274968466586, "normalized_bm25_score": 0.48042274968466586, "rerank_score": null, "retrieval_score": 0.692357631003933, "score": 0.692357631003933, "semantic_score": 0.7831868658550476}, {"bm25_score": 61.82173691443302, "chunk": {"document_id": "a2053ec18f1415e4912c510f", "id": "e69ef87cafd302938c765e20", "metadata": {"block_id": "blk_c9b952d90e55927ad69b", "block_index": 14, "block_type": "paragraph", "business_module": "设备维护", "chunk_index": 14, "chunk_parse_quality_status": "parsed_with_warning", "chunk_parse_warning_codes": ["bordered_table_detected", "semi_structured_table_detected"], "content_hash": "ab72ce00c904f060e1a60edb2af37b98f35cb9464f510e1022e29c657a94cf99", "detected_codes": [], "document_ocr_page_count": 0, "document_ocr_status": "not_required", "document_parse_quality_status": "parsed_with_warning", "document_parse_warning_count": 6, "end_unit": 94, "error_codes": [], "extension": ".pdf", "filename": "中国移动智慧家庭全光组网产品技术规范V2.0.0.pdf", "governance_source": "default_curated_policy", "heading_path": ["中国移动智慧家庭全光组网产品技术规范V2.0.0", "第15页"], "knowledge_status": "approved", "media_type": "pdf", "next_block_id": "blk_fdf91a2f6aae57de2189", "page_number": 15, "page_warning_codes": ["bordered_table_detected", "semi_structured_table_detected"], "parent_block_id": "blk_1f95d48adc1fd3c54089", "parser_name": "pdf", "parser_strategy": "pymupdf_text_with_page_quality_report", "parser_version": "document-parser-v7", "permission_tags": ["public"], "previous_block_id": "blk_1f95d48adc1fd3c54089", "review_status": "approved", "section_path": ["中国移动智慧家庭全光组网产品技术规范V2.0.0", "第15页"], "section_title": "第15页", "source": "中国移动智慧家庭全光组网产品技术规范V2.0.0.pdf", "source_block_ids": ["blk_c9b952d90e55927ad69b"], "source_path": "/app/data/中国移动智慧家庭全光组网产品技术规范V2.0.0.pdf", "source_type": "manual", "split_index": 0, "start_unit": 0, "table_parse_applied": false, "table_parse_skip_reason": "block_type_is_paragraph", "table_parse_status": "skipped", "table_parser_route": "deepdoc", "tenant_id": "default", "title": "中国移动智慧家庭全光组网产品技术规范V2.0.0", "version_id": "v_ab72ce00c904f060"}, "text": "章节：中国移动智慧家庭全光组网产品技术规范V2.0.0 > 第15页 页码：15 10 4. 产品入库要求 4.1. 基本要求 4.1.1. 接入要求 全光组网终端均需支持EasyMesh 功能，其中光网关的Mesh 角色为Controller，光路 由的Mesh 角色为Agent。 光网关在遵循本规范基础上，需同步遵循最新版本《中国移动智能家庭网关技术规范》 和相关管理接口要求，实现RMS 平台纳管。 光网关应支持基于光路由的逻辑标识对光路由合法性进行认证的能力，应拒绝非法光 路由接入。 4.2. 设备形态 全光组网终端主要用于家庭用户和泛家庭用户，提供以太网/IP 类业务接入能力。全 光组网终端设备的硬件设计、天线连接等应稳定可靠。 表4-1 设备形态 产品类型 光网关 光路由 产品名称 Wi-Fi 7 光网关 Wi-Fi 6 光网关 Wi-Fi 7 光路由 Wi-Fi 6 光路由 网络侧接口 (WAN 口) 不低于XG-PON 推荐支持XG-PON Combo 2.5G 非对称 推荐支持2.5G 对称 用户 侧接 口 网络 接口 1 个光口 最大物理分光比不低于支持1:8 面板式：不少于1×GE 其他：不少于2×GE，至 少有1 个网口支持2.5GE 面板式：不少于1×GE 其他：不少于2×GE 不少于2×GE，至少有 1 个网口支持2.5GE 不少于2×GE WLAN 接口 2.4GHz 802.11be （2×2） + 5GHz 2.4GHz 802.11ax （2×2） + 5GHz 2.4GHz 802.11be （2×2） + 5GHz 2.4GHz 802.11ax （2×2） + 5GHz"}, "keyword_score": 0.6904915013525095, "normalized_bm25_score": 0.6904915013525095, "rerank_score": null, "retrieval_score": 0.6860083616724479, "score": 0.6860083616724479, "semantic_score": 0.6840870160952788}], "state": "success", "timeout": false, "trace": {"answer_source": "rag", "augmented_context": "请求ID：84a9f418631549178485d1fb0f60fc56\n会话ID：p6-e2e-run01-qwen-flash-p6s-0111-attempt1\n租户ID：未指定\n用户ID：未指定\n权限标签：未指定\n用户原始问题：Wi-Fi 7 光网关的产品名称码是多少？若家庭用户需通过光路由扩展无线覆盖，其对应的设备编码应如何配置？\n归一化查询：Wi-Fi 7 光网关的产品名称码是多少？若家庭用户需通过光路由扩展无线覆盖，其对应的设备编码应如何配置？\n是否跟进问答：否\n上下文改写查询：Wi-Fi 7 光网关的产品名称码是多少？若家庭用户需通过光路由扩展无线覆盖，其对应的设备编码应如何配置？\n上下文关键术语：无\n改写查询：Wi-Fi 7 光网关的产品名称码是多少？若家庭用户需通过光路由扩展无线覆盖，其对应的设备编码应如何配置？\n检索查询：Wi-Fi 7 光网关的产品名称码是多少？若家庭用户需通过光路由扩展无线覆盖，其对应的设备编码应如何配置？ 终端设备 设备信息 设备状态 业务说明 知识库 常见问题\n同义词扩展：终端设备, 设备信息, 设备状态\n语义扩展：业务说明, 知识库, 常见问题\n识别意图：general_knowledge\n\n会话历史摘要：\n无\n\n工具调用结果：\n无\n\n检索到的相关文档：\n[1] 来源：中国移动智慧家庭全光组网产品技术规范V2.0.0.pdf\n引用标签：[1]\n标题：第7页\n定位信息：7\n综合分：0.819691\n召回综合分：0.819691\n重排分：无\n语义分：0.742415\nBM25 原始分：89.532944\nBM25 归一化分：1.000000\n内容：章节：中国移动智慧家庭全光组网产品技术规范V2.0.0 > 第7页 页码：7 2 1.4. 名词解释 1.4.1. 光网关 光网关是连接家庭网络和外部网络的智能化网关单元，可通过各种网络侧接口与接入 节点/接入网相连，并通过用户侧接口（光口、电口）等适配设备与用户终端设备相连， 同时可通过安装插件等方式与上层平台交互提供增值功能。 家庭网络内部各种无线Wi-Fi 终端（如手机、笔记本电脑、平板电脑、智能家居设备 等）可以通过光网关用户侧WLAN 接口接入家庭无线网络。 光网关可通过和家亲APP 远程管理，并具备保持家庭网络内多个光路由间的统一 SSID 能力。 1.4.2. 光路由 光路由是家庭宽带用户网络内，延伸光网关无线局域网网络覆盖的终端设备。 家庭网络内部各种无线Wi-Fi 终端（如手机、笔记本电脑、平板电脑、智能家居设备 等）可以通过光路由用户侧WLAN 接口接入家庭无线网络，并经由光网关接入外部网络。 光路由通过光纤接入光网关，通过本地适配器供电或光电混合缆由上级终端统一供电。 光路由可通过和家亲APP 远程管理，在同一局域网内部可同时存在多台光路由，向 家庭提供更广的无线网络覆盖范围。 1.4.3. 产品名称、产品名称码、产品型号 产品名称是指本规范第4 章定义的设备形态名称，产品名称码如下表所示： 产品名称码 产品名称 16，50 Wi-Fi 6 光网关 52，53 Wi-Fi 7 光网关 55 无频光网关1 16，60 Wi-Fi 6 光路由 62，63 Wi-Fi 7 光路由 1允许无频光网关产品入库，无须支持Wi-Fi功能，其他规格须不低于Wi-Fi 6光网关要求。\n\n[2] 来源：中国移动智慧家庭全光组网产品技术规范V2.0.0.pdf\n引用标签：[2]\n标题：第61页\n定位信息：61\n综合分：0.708278\n召回综合分：0.708278\n重排分：无\n语义分：0.772232\nBM25 原始分：50.053641\nBM25 归一化分：0.559053\n内容：章节：中国移动智慧家庭全光组网产品技术规范V2.0.0 > 第61页 页码：61 56 A.2 光路由终端二维码标识要求 二维码内容： （1）ssid1：设备的Wi-Fi名称，需与设备背面板的“默认无线网络名称”一致，一般 使用2.4G的SSID； （2）wifipwd：设备的Wi-Fi密码，需与设备背面板的“默认无线网络密钥”一致； （3）username：用户帐号，需与设备背面板的“默认终端配置帐号”一致；注：如 果此设备只使用密码登录，则username可填写空值； （4）userpwd：用户密码，需与设备背面板的“默认终端配置密码”一致； （5）productname: 产品名称码，2位阿拉伯数字； （6）mac：全光组网终端MAC地址； （7）sn：全光组网终端的SN； （8）cmei: 全光组网终端的CMEI号，具体编码规则请参考《中国移动非蜂窝类智能 硬件产品统一编码规范》； （9）ip：终端配置地址，如192.168.10.1，需与设备背面板的“默认终端配置地址” 一致; （10）vendor：全光组网终端合作伙伴名称，使用智家中心分配的厂商编码； （11）model：全光组网终端的产品型号，使用智家中心分配的型号编码。 （12）date：智能设备生产日期，6字节，格式xxxxxx，前4字节表示年，后2字节表示 月，例如：201901表示2019年1月。 二维码内容格式要求： 二维码内容所有符号为英文半角；用“&”把所有字段连起来，“&”左右无空格。 【实例】 ssid1=CMCC-xxx(无线网络名称)&wifipwd=xxx(无线网络密钥)&username=xxx（终端 配置帐号）&userpwd=xxx(终端配置密码)&ip=192.168.10.1&productname=xxx(产品名称 码)& mac=xxx( 终端MAC 地址)&sn=xxx( 终端的SN)&cmei=xxx( 终端的CMEI)& vendor=xxx(合作伙伴名称)&model=xxx(产品型号)&date=xxx(生产日期) 表格列：3.；二维码要求： （1）颜色：黑色； （2）黏贴位置：组网终端背面；\n\n[3] 来源：中国移动智慧家庭全光组网产品技术规范V2.0.0.pdf\n引用标签：[3]\n标题：第8页\n定位信息：8\n综合分：0.692358\n召回综合分：0.692358\n重排分：无\n语义分：0.783187\nBM25 原始分：43.013663\nBM25 归一化分：0.480423\n内容：章节：中国移动智慧家庭全光组网产品技术规范V2.0.0 > 第8页 页码：8 3 说明： 1）Wi-Fi 6 光网关产品编码为50，Wi-Fi 7 光网关产品编码为52、53，无频光网关产 品编码为55，另有51、54 备用；Wi-Fi 6 光路由产品编码为60，Wi-Fi 7 光路由 产品编码为62、63，另有61、64 备用；已入库全光组网终端（含光网关、光路 由）继续使用产品编码为16，新入库产品不再分配该产品编码。 产品型号是指各厂家自定义的型号或名称（不应包含*（）等特殊字符），如“HN300”。 1.4.4. 缩略语 下列缩略语适用于本标准： 缩略语 全称 解释 API Application Programming Interface 应用程序编程接口 APP Application 手机客户端软件 BSS Basic Service Set 基本服务集合 CQC China Quality Certification Center 中国质量认证中心 DCM Dual Carrier Modulation 双载波调制 DHCP Dynamic Host Configuration Protocol 动态主机配置协议 EMLSR Enhanced Multilink Single-Radio 增强型多链路单射频 FTTH Fiber to The Home 光纤入户 FTTR Fiber to The Room 光纤到房间 GE Gigabit Ethernet 千兆以太网 GPON Gigabit Passive Optical Network 千兆无源光网络 IGMP Internet Group Management Protocol 网间组信息协议 IPTV Internet Protocol Television 交互式网络电视 LAN Local Area Network 局域网 LDPC Low-density Parity-check 低密度奇偶校验 MAC Medium Access Control 媒质访问控制 MLO Multi-Link Operation 多链路操作\n\n[4] 来源：中国移动智慧家庭全光组网产品技术规范V2.0.0.pdf\n引用标签：[4]\n标题：第15页\n定位信息：15\n综合分：0.686008\n召回综合分：0.686008\n重排分：无\n语义分：0.684087\nBM25 原始分：61.821737\nBM25 归一化分：0.690492\n内容：章节：中国移动智慧家庭全光组网产品技术规范V2.0.0 > 第15页 页码：15 10 4. 产品入库要求 4.1. 基本要求 4.1.1. 接入要求 全光组网终端均需支持EasyMesh 功能，其中光网关的Mesh 角色为Controller，光路 由的Mesh 角色为Agent。 光网关在遵循本规范基础上，需同步遵循最新版本《中国移动智能家庭网关技术规范》 和相关管理接口要求，实现RMS 平台纳管。 光网关应支持基于光路由的逻辑标识对光路由合法性进行认证的能力，应拒绝非法光 路由接入。 4.2. 设备形态 全光组网终端主要用于家庭用户和泛家庭用户，提供以太网/IP 类业务接入能力。全 光组网终端设备的硬件设计、天线连接等应稳定可靠。 表4-1 设备形态 产品类型 光网关 光路由 产品名称 Wi-Fi 7 光网关 Wi-Fi 6 光网关 Wi-Fi 7 光路由 Wi-Fi 6 光路由 网络侧接口 (WAN 口) 不低于XG-PON 推荐支持XG-PON Combo 2.5G 非对称 推荐支持2.5G 对称 用户 侧接 口 网络 接口 1 个光口 最大物理分光比不低于支持1:8 面板式：不少于1×GE 其他：不少于2×GE，至 少有1 个网口支持2.5GE 面板式：不少于1×GE 其他：不少于2×GE 不少于2×GE，至少有 1 个网口支持2.5GE 不少于2×GE WLAN 接口 2.4GHz 802.11be （2×2） + 5GHz 2.4GHz 802.11ax （2×2） + 5GHz 2.4GHz 802.11be （2×2） + 5GHz 2.4GHz 802.11ax （2×2） + 5GHz", "authorized_source_count": 4, "bm25_weight": 0.3, "context_latency_ms": 1.697, "context_terms": [], "contextual_query": "Wi-Fi 7 光网关的产品名称码是多少？若家庭用户需通过光路由扩展无线覆盖，其对应的设备编码应如何配置？", "conversation_history_turn_count": 0, "created_at": "2026-11-05T12:14:55.303705+00:00", "degradation_reason": null, "embedding_latency_ms": 178.161, "generation_latency_ms": 1400.608, "intent_confidence": 0.35, "intent_label": "general_knowledge", "intent_latency_ms": 0.033, "intent_reason": "未命中明确业务意图，按通用知识问答处理。", "is_follow_up": false, "keyword_weight": 0.3, "latency_ms": 3085.52, "min_similarity_score": 0.05, "normalized_query": "Wi-Fi 7 光网关的产品名称码是多少？若家庭用户需通过光路由扩展无线覆盖，其对应的设备编码应如何配置？", "original_query": "Wi-Fi 7 光网关的产品名称码是多少？若家庭用户需通过光路由扩展无线