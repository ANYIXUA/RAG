线通信基站设备和设施其他维护项目。维护工作量清单项目设置及工作量计算规则，应按表8.6.2.4 的规定执行。 表8.6.2.4 无线通信基站设备和设施应急维护（编码：WH24） 项目编码 维护分项 作业名称 项目特征 计量单位 维护工作量计算规则 维护工作（操作）内容 WH24101 应急发电 ²地貌（平原、山 区、城区） ²发电时长 次 按实际发电次数和时长计算 注：时长以2 小时起计，超出2 小时部分按每增加1 小时单独 计算工日 1.器材准备 2.发电 3.恢复现场 4.记录发电时间 WH24102 故障抢修 ²地貌（平原、山 区、城区） ²故障类型 次 根据实际发生次数计算 1.天馈系统故障抢修。 2.主设备故障抢修。 3.配套设备故障抢修。 WH24103 其他维护 工作 ²地貌（平原、山 区、城区） ²工作项目 天²次 站²次 根据规程要求的操作方式和实 际发生次数计算 1.资产盘点、工程随工验 收、资源录入。 2.代缴电费 3.站址业主维系、业主满意 度调查。"}, "keyword_score": 0.44778898301784703, "normalized_bm25_score": 0.44778898301784703, "rerank_score": null, "retrieval_score": 0.48918426913936536, "score": 0.48918426913936536, "semantic_score": 0.5069251060485875}, {"bm25_score": 12.185474314287841, "chunk": {"document_id": "c8588238d99d4079e1ec6101", "id": "4ce91d813f1601103aae315a", "metadata": {"block_id": "blk_fd7a62ab0017cfb4c0dc", "block_index": 295, "block_type": "paragraph", "business_module": "设备维护", "chunk_index": 295, "chunk_parse_quality_status": "parsed_with_warning", "chunk_parse_warning_codes": ["bordered_table_detected", "semi_structured_table_detected"], "content_hash": "8ae9b63d869002c1950aaf1192e44b0b876ccb9d927154f35e8c48bcd24094bb", "detected_codes": [], "document_ocr_page_count": 0, "document_ocr_status": "not_required", "document_parse_quality_status": "parsed_with_warning", "document_parse_warning_count": 7, "end_unit": 115, "error_codes": [], "extension": ".pdf", "filename": "电信基础设施维护规程.pdf", "governance_source": "default_curated_policy", "heading_path": ["电信基础设施维护规程", "第296页"], "knowledge_status": "approved", "media_type": "pdf", "next_block_id": "blk_388b0239ff4be2ee8b6b", "page_number": 296, "page_warning_codes": ["bordered_table_detected", "semi_structured_table_detected"], "parent_block_id": "blk_3135784a4ed20b5519be", "parser_name": "pdf", "parser_strategy": "pymupdf_text_with_page_quality_report", "parser_version": "document-parser-v7", "permission_tags": ["public"], "previous_block_id": "blk_3135784a4ed20b5519be", "review_status": "approved", "s