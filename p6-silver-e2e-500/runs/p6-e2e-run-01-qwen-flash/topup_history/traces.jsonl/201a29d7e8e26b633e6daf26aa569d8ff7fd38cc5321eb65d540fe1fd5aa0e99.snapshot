的维护次数 计算 1.检查清洁设备外观。 2.检查和处理设备功能、告警信息。 3.检查防雷模块工作状态。 4.检查各类缆线固定情况和标签标识。 5.检查设备及空开温度等。 6.检查电池外观、温度等信息。 WH21110 直流拉远供 电设备巡检 地貌、社会因素 （市区、平原、 山区） 台²次 按照合同约定的 维护周期和实际 发生的维护次数 计算 1.检查清洁设备外观。 2.检查处理设备运行、告警信息。 3.检查各类缆线固定、标识标签情况。 4.测量输出电压电流。 WH21111 发电机设备 巡检 1.地貌、社会因 素（市区、平原、 山区） 2.发电设备（固 定燃油发电机 组、小型离网风 台²次 按照合同约定的 维护周期和实际 发生的维护次数 计算 1.检查清洁燃油发电机外观、三液。 2.燃油发电机空载试机及启动电池检查。 3.检查风力发电机基础以及固定情况。 4.检查发电机外观及运行情况。 5.检查清洁太阳能光伏板。 6.检查紧固光伏板支架和基础。"}, "keyword_score": 0.6987449219154532, "normalized_bm25_score": 0.6987449219154532, "rerank_score": null, "retrieval_score": 0.6894943824661848, "score": 0.6894943824661848, "semantic_score": 0.6855298655593556}, {"bm25_score": 28.214698406111353, "chunk": {"document_id": "c8588238d99d4079e1ec6101", "id": "e3c8b8f0828edef287c4c60c", "metadata": {"block_id": "blk_8a49983c7c4622817b0b", "block_index": 297, "block_type": "paragraph", "business_module": "通用知识", "chunk_index": 297, "chunk_parse_quality_status": "parsed_with_warning", "chunk_parse_warning_codes": ["bordered_table_detected"], "content_hash": "8ae9b63d869002c1950aaf1192e44b0b876ccb9d927154f35e8c48bcd24094bb", "detected_codes": [], "document_ocr_page_count": 0, "document_ocr_status": "not_required", "document_parse_quality_status": "parsed_with_warning", "document_parse_warning_count": 7, "end_unit": 48, "error_codes": [], "extension": ".pdf", "filename": "电信基础设施维护规程.pdf", "governance_source": "default_curated_policy", "heading_path": ["电信基础设施维护规程", "第298页"], "knowledge_status": "approved", "media_type": "pdf", "next_block_id": "blk_2ab796d049a715447af4", "page_number": 298, "page_warning_codes": ["bordered_table_detected"], "parent_block_id": "blk_3346a6d2044fb764e077", "parser_name": "pdf", "parser_strategy": "pymupdf_text_with_page_quality_report", "parser_version": "document-parser-v7", "permission_tags": ["public"], "previous_block_id": "blk_3346a6d2044fb764e077", "review_status": "approved", "section_path": ["电信基础设施维护规程", "第298页"], "section_title": "第298页", "source": "电信基础设施维护规程.