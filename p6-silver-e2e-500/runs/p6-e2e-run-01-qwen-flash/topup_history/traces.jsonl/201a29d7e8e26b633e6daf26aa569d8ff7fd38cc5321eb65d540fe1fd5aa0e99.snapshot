": [], "document_ocr_page_count": 0, "document_ocr_status": "not_required", "document_parse_quality_status": "parsed_with_warning", "document_parse_warning_count": 6, "end_unit": 64, "error_codes": [], "extension": ".pdf", "filename": "中国移动智慧家庭全光组网产品技术规范V2.0.0.pdf", "governance_source": "default_curated_policy", "heading_path": ["中国移动智慧家庭全光组网产品技术规范V2.0.0", "第57页"], "knowledge_status": "approved", "media_type": "pdf", "next_block_id": "blk_c7b835ad8445f649e93d", "page_number": 57, "page_warning_codes": [], "parent_block_id": "blk_e1fe4388a485e264d786", "parser_name": "pdf", "parser_strategy": "pymupdf_text_with_page_quality_report", "parser_version": "document-parser-v7", "permission_tags": ["public"], "previous_block_id": "blk_e1fe4388a485e264d786", "review_status": "approved", "section_path": ["中国移动智慧家庭全光组网产品技术规范V2.0.0", "第57页"], "section_title": "第57页", "source": "中国移动智慧家庭全光组网产品技术规范V2.0.0.pdf", "source_block_ids": ["blk_d98b5d72c1999c022ff1"], "source_path": "/app/data/中国移动智慧家庭全光组网产品技术规范V2.0.0.pdf", "source_type": "manual", "split_index": 0, "start_unit": 0, "table_parse_applied": false, "table_parse_skip_reason": "block_type_is_paragraph", "table_parse_status": "skipped", "table_parser_route": "deepdoc", "tenant_id": "default", "title": "中国移动智慧家庭全光组网产品技术规范V2.0.0", "version_id": "v_ab72ce00c904f060"}, "text": "章节：中国移动智慧家庭全光组网产品技术规范V2.0.0 > 第57页 页码：57 52 4.10.1.1.2. 光路由上行接口要求 为满足部分光网关和光路由不加链路衰减，直连使用需求，光路由上行光口链路预算 等级可参考Ra 等级，要求发送光功率范围-4~0dBm，接收光功率范围为-22~0dBm，最大 光链路损耗不超过18dB。实际使用中需要保证光路由接收光功率在饱和功率值和接收灵 敏度之间。 2.5G 对称模式的光路由上行光口功率要求应参考2.5G 非对称模式的要求。 光路由上行接口需支持2.5G 非对称模式，推荐支持2.5G 对称模式。光路由上行线路 码型推荐采用NRZ 编码，推荐光路由上行工作波长范围为1310±10nm。 4.10.1.2. 用户侧接口要求 4.10.1.2.1. 用户侧光接口要求 为满足光网关和光路由之间不加链路衰减，直连使用需求，2.5G 非对称模式的光网关 下行光口链路预算等级可参考Ra 等级，要求发送光功率范围-4~0dBm，接收光功率范围 为-22~0dBm，最大光链路损耗不超过18dB。实际使用中需要保证光网关PONMAC 接收 光功率在饱和功率值和接收灵敏度之间。 2.5G 对称模式的光网关下行光口功率要求应参考2.5G 非对称模式的要求。 光网关下行接口需支持2.5G 非对称模式，可选支持2.5G 对称模式。光网关下行线路 码型推荐采用NRZ 编码，推荐光网关下行工作波长范围为1490±10nm。 4.10.1.2.2. 用户侧以太网接口要求 用户侧以太网接口应支持100/1000Base-T Ethernet 接口，Wi-Fi 7 全光组网终端还需 支持2.5G Base-T Ethernet 接口。应符合IEEE 802.3 标准，支持采用直连网线进行连接， 支持自动校验连接网线的功能。 4.10.1.2.3. 用户侧WLAN 接口要求 2.4GHz 和5GHz 频段应符合IEEE 802.11ax/be 协议。 4.10.2. 设备兼容性要求 全光组网终端应具有良好兼容性，新设备需实现对现网已激活终端的前向兼容能力。"}, "keyword_score": 1.0, "normalized_bm25_score": 1.0, "rerank_score": null, "retrieval_score": 0.8520127353653031, "score": 0.8520127353653031, "semantic_score": 0.788589621950433}, {"bm25_score": 33.84408459397672, "chunk": {"document_id": "a2053ec18f1415e4912c510f", "id": "546f017c81972bb8f8da4d1d", "metadata": {"block_id": "blk_1a990a3d91d0b6ba2e04", "block_index": 37, "block_type": "paragraph", "business_module": "设备维护", "chunk_index": 37, "chunk_parse_quality_status": "parsed_with_warning", "chunk_parse_warning_codes": ["bordered_table_detected"], "content_hash": "ab72ce00c904f060e1a60edb2af37b98f35cb9464f510e1022e29c657a94cf99", "detected_codes": [], "document_ocr_page_count": 0, "document_ocr_status": "not_required", "document_parse_quality_status": "parsed_with_warning", "document_parse_warning_count": 6, "end_unit": 41, "error_codes": [], "extension": ".pdf", "filename": "中国移动智慧家庭全光组网产品技术规范V2.0.0.pdf", "governance_source": "default_curated_policy", "heading_path": ["中国移动智慧家庭全光组网产品技术规范V2.0.0", "第38页"], "knowledge_status": "approved", "media_type": "pdf", "next_block_id": "blk_4fd8e79b55758d925d4a", "page_number": 38, "page_warning_codes": ["bordered_table_detected"], "parent_block_id": "blk_09b8f73dc02549db5321", "parser_name": "pdf", "parser_strategy": "pymupdf_text_with_page_quality_report", "parser_version": "document-parser-v7", "permission_tags": ["public"], "previous_block_id": "blk_09b8f73dc02549db5321", "review_status": "approved", "section_path": ["中国移动智慧家庭全光组网产品技术规范V2.0.0", "第38页"], "section_title": "第38页", "source": "中国移动智慧家庭全光组网产品技术规范V2.0.0.pdf", "source_block_ids": ["blk_1a990a3d91d0b6ba2e04"], "source_path": "/app/data/中国移动智慧家庭全光组网产品技术规范V2.0.0.pdf", "source_type": "manual", "split_index": 0, "start_unit": 0, "table_parse_applied": false, "table_parse_skip_reason": "block_type_is_paragraph", "table_parse_status": "skipped", "table_parser_route": "deepdoc", "tenant_id": "default", "title": "中国移动智慧家庭全光组网产品技术规范V2.0.0", "version_id": "v_ab72ce00c904f060"}, "text": "章节：中国移动智慧家庭全光组网产品技术规范V2.0.0 > 第38页 页码：38 33 光网关 光路由 近距离 中距离（RSSI -55±2dbm) 远距离（RSSI -65±2dbm) STA1-4K视频 STA2-4K视频 STA3-4K视频 STA4-下载 STA5-下载 STA6-下载 STA7-云游戏 STA8-云游戏 STA9-云游戏 STA10-手游 STA11-手游 STA12-手游 图4-3：时延测试拓扑 在FTTR组网场景下，光网关与光路由相互存在Wi-Fi干扰，由于无线局域网（WLAN） 空口被其他干扰信号占用，数据传输过程中存在一定的丢包和重传，而重传会使业务时延 增加，本场景需要满足如下设定： 1） 多用户并发时延指标场景的用户数为12个。 2） 连接方案： 光网关与光路由之间通过光纤进行连接，光网关和光路由间Wi-Fi可见，相互间信号 强度为-60dBm±2dBm；STA2/4/8/10对光网关和光路由均可见，其他STA仅对光网关或光 路由可见；STA2/4/8/10仅约束同光网关及光路由间的相互信号强度，STA连接热点由全光 组网终端自身算法决定；测试业务流从光网关上行口进行打流； 3） 待测FTTR终端工作设置：光网关和光路由的2.4GHz频段均工作在信道1，频宽 20MHz；5GHz频段均工作在36信道，频宽160MHz； 4） 业务模型："}, "keyword_score": 0.2707749908018388, "normalized_bm25_score": 0.2707749908018388, "rerank_score": null, "retrieval_score": 0.5667846361918457, "score": 0.5667846361918457, "semantic_score": 0.693645912787563}, {"bm25_score": 38.25839501542747, "chunk": {"document_id": "a2053ec18f1415e4912c510f", "id": "d60c3992acb84d003c25c027", "metadata": {"block_id": "blk_7d181905d42cf5e9a3e5", "block_index": 45, "block_type": "paragraph", "business_module": "设备维护", "chunk_index": 45, "chunk_parse_quality_status": "parsed_with_warning", "chunk_parse_warning_codes": ["bordered_table_detected", "semi_structured_table_detected"], "content_hash": "ab72ce00c904f060e1a60edb2af37b98f35cb9464f510e1022e29c657a94cf99", "detected_codes": [], "document_ocr_page_count": 0, "document_ocr_status": "not_required", "document_parse_quality_status": "parsed_with_warning", "document_parse_warning_count": 6, "end_unit": 72, "error_codes": [], "extension": ".pdf", "filename": "中国移动智慧家庭全光组网产品技术规范V2.0.0.pdf", "governance_source": "default_curated_policy", "heading_path": ["中国移动智慧家庭全光组网产品技术规范V2.0.0", "第46页"], "knowledge_status": "approved", "media_type": "pdf", "next_block_id": "blk_063d627554c69cc92f11", "page_number": 46, "page_warning_codes": ["bordered_table_detected", "semi_structured_table_detected"], "parent_block_id": "blk_5be764fc91f1af2aceae", "parser_name": "pdf", "parser_strategy": "pymupdf_text_with_page_quality_report", "parser_version": "document-parser-v7", "permission_tags": ["public"], "previous_block_id": "blk_5be764fc91f1af2aceae", "review_status": "approved", "section_path": ["中国移动智慧家庭全光组网产品技术规范V2.0.0", "第46页"], "section_title": "第46页", "source": "中国移动智慧家庭全光组网产品技术规范V2.0.0.pdf", "source_block_ids": ["blk_7d181905d42cf5e9a3e5"], "source_path": "/app/data/中国移动智慧家庭全光组网产品技术规范V2.0.0.pdf", "source_type": "manual", "split_index": 0, "start_unit": 0, "table_parse_applied": false, "table_parse_skip_reason": "block_type_is_paragraph", "table_parse_status": "skipped", "table_parser_route": "deepdoc", "tenant_id": "default", "title": "中国移动智慧家庭全光组网产品技术规范V2.0.0", "version_id": "v_ab72ce00c904f060"}, "text": "章节：中国移动智慧家庭全光组网产品技术规范V2.0.0 > 第46页 页码：46 41 4.5.5. 过压过流保护 设备应满足GB/T 17626.5-2019《电磁兼容 试验和测量技术 浪涌(冲击)抗扰度试验》 对模拟雷电冲击、电力线感应、电力线接触等指标的要求。 设备电源应具备共模4KV/差模4KV；以太网接口应具备1.5KV（共模）的防护能力。 4.6. 硬件要求 4.6.1. 指示灯要求 4.6.1.1. 光网关指示灯要求 光网关应具备表4-12 中的指示灯，指示各模块运行状态； 表4-11 光网关指示灯要求 指示灯名称 颜色 建议标识文字 显示功能 电源指示灯 颜色A 电源 常亮：系统正常上电 熄灭：系统未上电 PON 状态灯（可选） 颜色A 注册 熄灭：未开始注册流程 常亮：完成注册 闪烁：正在注册 上行光信号状态灯 红色 光信号 熄灭：接收光功率正常 闪烁：接收光功率异常 下行光信号状态灯 颜色A 光网络 熄灭：系统未上电或下行光纤未连接 常亮：下行光纤已连接，但无数据传输 闪烁：正在进行数据传输 以太网口状态灯 颜色A 1,2 （用户侧接 口） 熄灭：系统未上电或网口未连接 常亮：网口已连接，但无数据传输 闪烁：正常进行数据传输 USB 口状态灯（可选） 颜色A USB-序号 熄灭：系统未上电或USB 接口未连接 常亮：USB 接口已连接，但无数据传输 闪烁：正在进行数据传输 WLAN 口状态灯（可选） 颜色A 无线 熄灭：系统未上电或无线接口被禁用"}, "keyword_score": 0.30609238461244037, "normalized_bm25_score": 0.30609238461244037, "rerank_score": null, "retrieval_score": 0.5392203851700663, "score": 0.5392203851700663, "semantic_score": 0.6391323854090489}, {"bm25_score": 22.358655800426156, "chunk": {"document_id": "a2053ec18f1415e4912c510f", "id": "0a4d3ca37e5dd0727f0df0b7", "metadata": {"block_id": "blk_fc00cfab6e8410f98035", "block_index": 35, "block_type": "paragraph", "business_module": "设备维护", "chunk_index": 35, "chunk_parse_quality_status": "parsed_with_warning", "chunk_parse_warning_codes": [], "content_hash": "ab72ce00c904f060e1a60edb2af37b98f35cb9464f510e1022e29c657a94cf99", "detected_codes": [], "document_ocr_page_count": 0, "document_ocr_status": "not_required", "document_parse_quality_status": "parsed_with_warning", "document_parse_warning_count": 6, "end_unit": 34, "error_codes": [], "extension": ".pdf", "filename": "中国移动智慧家庭全光组网产品技术规范V2.0.0.pdf", "governance_source": "default_curated_policy", "heading_path": ["中国移动智慧家庭全光组网产品技术规范V2.0.0", "第36页"], "knowledge_status": "approved", "media_type": "pdf", "next_block_id": "blk_09a93afe8cb8a1d39b71", "page_number": 36, "page_warning_codes": [], "parent_block_id": "blk_1c22d297772417f085c1", "parser_name": "pdf", "parser_strategy": "pymupdf_text_with_page_quality_report", "parser_version": "document-parser-v7", "permission_tags": ["public"], "previous_block_id": "blk_1c22d297772417f085c1", "review_status": "approved", "section_path": ["中国移动智慧家庭全光组网产品技术规范V2.0.0", "第36页"], "section_title": "第36页", "source": "中国移动智慧家庭全光组网产品技术规范V2.0.0.pdf", "source_block_ids": ["blk_fc00cfab6e8410f98035"], "source_path": "/app/data/中国移动智慧家庭全光组网产品技术规范V2.0.0.pdf", "source_type": "manual", "split_index": 0, "start_unit": 0, "table_parse_applied": false, "table_parse_skip_reason": "block_type_is_paragraph", "table_parse_status": "skipped", "table_parser_route": "deepdoc", "tenant_id": "default", "title": "中国移动智慧家庭全光组网产品技术规范V2.0.0", "version_id": "v_ab72ce00c904f060"}, "text": "章节：中国移动智慧家庭全光组网产品技术规范V2.0.0 > 第36页 页码：36 31 光网关及光路由和测试STA位于三个屏蔽箱内，对于支持11ax的全光组网终端，测试 STA建议通过5GHz频段与光网关或光路由建立关联，对于支持11b的全光组网终端，测试 STA建议通过MLO与光网关或光路由建立关联；光网关和光路由之间通过光纤连接，光网 关与光路由间Wi-Fi信号相互可见，且信号强度为-60dBm±2dBm； 使用流量服务器从OLT向测试STA发送200Mbps或1000pps，1500byte字节长度的UDP 流，发流的同时，按照1dB/s的速率调节STA终端与光网关/光路由间屏蔽箱的衰减，模拟 测试STA终端在光网关及光路由间的相对运动，记录测试STA在光网关及光路由间漫游过 程中的吞吐量，测试时长为3分钟，按秒记录吞吐量及漫游时延； 光网关和光路由均支持Wi-Fi 6时，漫游吞吐平均不低于150Mbps，最小不低于75Mbps； 光网关和光路由均支持Wi-Fi 7时，漫游吞吐平均不低于170Mbps，最小不低于80Mbps。 对于支持802.11k/v/r 的客户端，全光组网终端间使用光纤组网时，STA 在全光组网 终端间漫游切换时延须优于75ms，宜优于40ms； 4.4.1.4. 接收灵敏度要求 全光组网终端符合802.11n 协议20.3.22.1 中的相关要求。 全光组网终端应符合802.11ac协议中22.3.19.1的相关要求。 全光组网终端应符合802.11ax协议中27.3.19.2的相关要求。 全光组网终端应符合802.11be协议中36.3.19/20的相关要求。 4.4.1.5. 方向性要求 方向性是指全光组网终端的不同方位上获取性能的偏差。其性能同全光组网终端天 线极化方向、方向图、空间MIMO信道差异等因素，导致不同方向上的性能指标存在差异。 对于双空间流的全光组网终端，其多个方向下行性能平均值要求如表4-7所示："}, "keyword_score": 0.1788839878913239, "normalized_bm25_score": 0.1788839878913239, "rerank_score": null, "retrieval_score": 0.5202083900329505, "score": 0.5202083900329505, "semantic_score": 0.6664902766650762}]}], "sources": [{"bm25_score": 124.98969898865151, "chunk": {"document_id": "a2053ec18f1415e4912c510f", "id": "acbdb12c2a62c12fe9787ef7", "metadata": {"block_id": "blk_d98b5d72c1999c022ff1", "block_index": 56, "block_type": "paragraph", "business_module": "设备维护", "chunk_index": 56, "chunk_parse_quality_status": "parsed_with_warning", "chunk_parse_warning_codes": [], "content_hash": "ab72ce00c904f060e1a60edb2af37b98f35cb9464f510e1022e29c657a94cf99", "detected_codes": [], "document_ocr_page_count": 0, "document_ocr_status": "not_required", "document_parse_quality_status": "parsed_with_warning", "document_parse_warning_count": 6, "end_unit": 64, "error_codes": [], "extension": ".pdf", "filename": "中国移动智慧家庭全光组网产品技术规范V2.0.0.pdf", "governance_source": "default_curated_policy", "heading_path": ["中国移动智慧家庭全光组网产品技术规范V2.0.0", "第57页"], "knowledge_status": "approved", "media_type": "pdf", "next_block_id": "blk_c7b835ad8445f649e93d", "page_number": 57, "page_warning_codes": [], "parent_block_id": "blk_e1fe4388a485e264d786", "parser_name": "pdf", "parser_strategy": "pymupdf_text_with_page_quality_report", "parser_version": "document-parser-v7", "permission_tags": ["public"], "previous_block_id": "blk_e1fe4388a485e264d786", "review_status": "approved", "section_path": ["中国移动智慧家庭全光组网产品技术规范V2.0.0", "第57页"], "section_title": "第57页", "source": "中国移动智慧家庭全光组网产品技术规范V2.0.0.pdf", "source_block_ids": ["blk_d98b5d72c1999c022ff1"], "source_path": "/app/data/中国移动智慧家庭全光组网产品技术规范V2.0.0.pdf", "source_type": "manual", "split_index": 0, "start_unit": 0, "table_parse_applied": false, "table_parse_skip_reason": "block_type_is_paragraph", "table_parse_status": "skipped", "table_parser_route": "deepdoc", "tenant_id": "default", "title": "中国移动智慧家庭全光组网产品技术规范V2.0.0", "version_id": "v_ab72ce00c904f060"}, "text": "章节：中国移动智慧家庭全光组网产品技术规范V2.0.0 > 第57页 页码：57 52 4.10.1.1.2. 光路由上行接口要求 为满足部分光网关和光路由不加链路衰减，直连使用需求，光路由上行光口链路预算 等级可参考Ra 等级，要求发送光功率范围-4~0dBm，接收光功率范围为-22~0dBm，最大 光链路损耗不超过18dB。实际使用中需要保证光路由接收光功率在饱和功率值和接收灵 敏度之间。 2.5G 对称模式的光路由上行光口功率要求应参考2.5G 非对称模式的要求。 光路由上行接口需支持2.5G 非对称模式，推荐支持2.5G 对称模式。光路由上行线路 码型推荐采用NRZ 编码，推荐光路由上行工作波长范围为1310±10nm。 4.10.1.2. 用户侧接口要求 4.10.1.2.1. 用户侧光接口要求 为满足光网关和光路由之间不加链路衰减，直连使用需求，2.5G 非对称模式的光网关 下行光口链路预算等级可参考Ra 等级，要求发送光功率范围-4~0dBm，接收光功率范围 为-22~0dBm，最大光链路损耗不超过18dB。实际使用中需要保证光网关PONMAC 接收 光功率在饱和功率值和接收灵敏度之间。 2.5G 对称模式的光网关下行光口功率要求应参考2.5G 非对称模式的要求。 光网关下行接口需支持2.5G 非对称模式，可选支持2.5G 对称模式。光网关下行线路 码型推荐采用NRZ 编码，推荐光网关下行工作波长范围为1490±10nm。 4.10.1.2.2. 用户侧以太网接口要求 用户侧以太网接口应支持100/1000Base-T Ethernet 接口，Wi-Fi 7 全光组网终端还需 支持2.5G Base-T Ethernet 接口。应符合IEEE 802.3 标准，支持采用直连网线进行连接， 支持自动校验连接网线的功能。 4.10.1.2.3. 用户侧WLAN 接口要求 2.4GHz 和5GHz 频段应符合IEEE 802.11ax/be 协议。 4.10.2. 设备兼容性要求 全光组网终端应具有良好兼容性，新设备需实现对现网已激活终端的前向兼容能力。"}, "keyword_score": 1.0, "normalized_bm25_score": 1.0, "rerank_score": null, "retrieval_score": 0.8520127353653031, "score": 0.8520127353653031, "semantic_score": 0.788589621950433}, {"bm25_score": 33.84408459397672, "chunk": {"document_id": "a2053ec18f1415e4912c510f", "id": "546f017c81972bb8f8da4d1d", "metadata": {"block_id": "blk_1a990a3d91d0b6ba2e04", "block_index": 37, "block_type": "paragraph", "business_module": "设备维护", "chunk_index": 37, "chunk_parse_quality_status": "parsed_with_warning", "chunk_parse_warning_codes": ["bordered_table_detected"], "content_hash": "ab72ce00c904f060e1a60edb2af37b98f35cb9464f510e1022e29c657a94cf99", "detected_codes": [], "document_ocr_page_count": 0, "document_ocr_status": "not_required", "document_parse_quality_status": "parsed_with_warning", "document_parse_warning_count": 6, "end_unit": 41, "error_codes": [], "extension": ".pdf", "filename": "中国移动智慧家庭全光组网产品技术规范V2.0.0.pdf", "governance_source": "default_curated_policy", "heading_path": ["中国移动智慧家庭全光组网产品技术规范V2.0.0", "第38页"], "knowledge_status": "approved", "media_type": "pdf", "next_block_id": "blk_4fd8e79b55758d925d4a", "page_number": 38, "page_warning_codes": ["bordered_table_detected"], "parent_block_id": "blk_09b8f73dc02549db5321", "parser_name": "pdf", "parser_strategy": "pymupdf_text_with_page_quality_report", "parser_version": "document-parser-v7", "permission_tags": ["public"], "previous_block_id": "blk_09b8f73dc02549db5321", "review_status": "approved", "section_path": ["中国移动智慧家庭全光组网产品技术规范V2.0.0", "第38页"], "section_title": "第38页", "source": "中国移动智慧家庭全光组网产品技术规范V2.0.0.pdf", "source_block_ids": ["blk_1a990a3d91d0b6ba2e04"], "source_path": "/app/data/中国移动智慧家庭全光组网产品技术规范V2.0.0.pdf", "source_type": "manual", "split_index": 0, "start_unit": 0, "table_parse_applied": false, "table_parse_skip_reason": "block_type_is_paragraph", "table_parse_status": "skipped", "table_parser_route": "deepdoc", "tenant_id": "default", "title": "中国移动智慧家庭全光组网产品技术规范V2.0.0", "version_id": "v_ab72ce00c904f060"}, "text": "章节：中国移动智慧家庭全光组网产品技术规范V2.0.0 > 第38页 页码：38 33 光网关 光路由 近距离 中距离（RSSI -55±2dbm) 远距离（RSSI -65±2dbm) STA1-4K视频 STA2-4K视频 STA3-4K视频 STA4-下载 STA5-下载 STA6-下载 STA7-云游戏 STA8-云游戏 STA9-云游戏 STA10-手游 STA11-手游 STA12-手游 图4-3：时延测试拓扑 在FTTR组网场景下，光网关与光路由相互存在Wi-Fi干扰，由于无线局域网（WLAN） 空口被其他干扰信号占用，数据传输过程中存在一定的丢包和重传，而重传会使业务时延 增加，本场景需要满足如下设定： 1） 多用户并发时延指标场景的用户数为12个。 2） 连接方案： 光网关与光路由之间通过光纤进行连接，光网关和光路由间Wi-Fi可见，相互间信号 强度为-60dBm±2dBm；STA2/4/8/10对光网关和光路由均可见，其他STA仅对光网关或光 路由可见；STA2/4/8/10仅约束同光网关及光路由间的相互信号强度，STA连接热点由全光 组网终端自身算法决定；测试业务流从光网关上行口进行打流； 3） 待测FTTR终端工作设置：光网关和光路由的2.4GHz频段均工作在信道1，频宽 20MHz；5GHz频段均工作在36信道，频宽160MHz； 4） 业务模型："}, "keyword_score": 0.2707749908018388, "normalized_bm25_score": 0.2707749908018388, "rerank_score": null, "retrieval_score": 0.5667846361918457, "score": 0.5667846361918457, "semantic_score": 0.693645912787563}, {"bm25_score": 38.25839501542747, "chunk": {"document_id": "a2053ec18f1415e4912c510f", "id": "d60c3992acb84d003c25c027", "metadata": {"block_id": "blk_7d181905d42cf5e9a3e5", "block_index": 45, "block_type": "paragraph", "business_module": "设备维护", "chunk_index": 45, "chunk_parse_quality_status": "parsed_with_warning", "chunk_parse_warning_codes": ["bordered_table_detected", "semi_structured_table_detected"], "content_hash": "ab72ce00c904f060e1a60edb2af37b98f35cb9464f510e1022e29c657a94cf99", "detected_codes": [], "document_ocr_page_count": 0, "document_ocr_status": "not_required", "document_parse_quality_status": "parsed_with_warning", "document_parse_warning_count": 6, "end_unit": 72, "error_codes": [], "extension": ".pdf", "filename": "中国移动智慧家庭全光组网产品技术规范V2.0.0.pdf", "governance_source": "default_curated_policy", "heading_path": ["中国移动智慧家庭全光组网产品技术规范V2.0.0", "第46页"], "knowledge_status": "approved", "media_type": "pdf", "next_block_id": "blk_063d627554c69cc92f11", "page_number": 46, "page_warning_codes": ["bordered_table_detected", "semi_structured_table_detected"], "parent_block_id": "blk_5be764fc91f1af2aceae", "parser_name": "pdf", "parser_strategy": "pymupdf_text_with_page_quality_report", "parser_version": "document-parser-v7", "permission_tags": ["public"], "previous_block_id": "blk_5be764fc91f1af2aceae", "review_status": "approved", "section_path": ["中国移动智慧家庭全光组网产品技术规范V2.0.0", "第46页"], "section_title": "第46页", "source": "中国移动智慧家庭全光组网产品技术规范V2.0.0.pdf", "source_block_ids": ["blk_7d181905d42cf5e9a3e5"], "source_path": "/app/data/中国移动智慧家庭全光组网产品技术规范V2.0.0.pdf", "source_type": "manual", "split_index": 0, "start_unit": 0, "table_parse_applied": false, "table_parse_skip_reason": "block_type_is_paragraph", "table_parse_status": "skipped", "table_parser_route": "deepdoc", "tenant_id": "default", "title": "中国移动智慧家庭全光组网产品技术规范V2.0.0", "version_id": "v_ab72ce00c904f060"}, "text": "章节：中国移动智慧家庭全光组网产品技术规范V2.0.0 > 第46页 页码：46 41 4.5.5. 过压过流保护 设备应满足GB/T 17626.5-2019《电磁兼容 试验和测量技术 浪涌(冲击)抗扰度试验》 对模拟雷电冲击、电力线感应、电力线接触等指标的要求。 设备电源应具备共模4KV/差模4KV；以太网接口应具备1.5KV（共模）的防护能力。 4.6. 硬件要求 4.6.1. 指示灯要求 4.6.1.1. 光网关指示灯要求 光网关应具备表4-12 中的指示灯，指示各模块运行状态； 表4-11 光网关指示灯要求 指示灯名称 颜色 建议标识文字 显示功能 电源指示灯 颜色A 电源 常亮：系统正常上电 熄灭：系统未上电 PON 状态灯（可选） 颜色A 注册 熄灭：未开始注册流程 常亮：完成注册 闪烁：正在注册 上行光信号状态灯 红色 光信号 熄灭：接收光功率正常 闪烁：接收光功率异常 下行光信号状态灯 颜色A 光网络 熄灭：系统未上电或下行光纤未连接 常亮：下行光纤已连接，但无数据传输 闪烁：正在进行数据传输 以太网口状态灯 颜色A 1,2 （用户侧接 口） 熄灭：系统未上电或网口未连接 常亮：网口已连接，但无数据传输 闪烁：正常进行数据传输 USB 口状态灯（可选） 颜色A USB-序号 熄灭：系统未上电或USB 接口未连接 常亮：USB 接口已连接，但无数据传输 闪烁：正在进行数据传输 WLAN 口状态灯（可选） 颜色A 无线 熄灭：系统未上电或无线接口被禁用"}, "keyword_score": 0.30609238461244037, "normalized_bm25_score": 0.30609238461244037, "rerank_score": null, "retrieval_score": 0.5392203851700663, "score": 0.5392203851700663, "semantic_score": 0.6391323854090489}, {"bm25_score": 22.358655800426156, "chunk": {"document_id": "a2053ec18f1415e4912c510f", "id": "0a4d3ca37e5dd0727f0df0b7", "metadata": {"block_id": "blk_fc00cfab6e8410f98035", "block_index": 35, "block_type": "paragraph", "business_module": "设备维护", "chunk_index": 35, "chunk_parse_quality_status": "parsed_with_warning", "chunk_parse_warning_codes": [], "content_hash": "ab72ce00c904f060e1a60edb2af37b98f35cb9464f510e1022e29c657a94cf99", "detected_codes": [], "document_ocr_page_count": 0, "document_ocr_status": "not_required", "document_parse_quality_status": "parsed_with_warning", "document_parse_warning_count": 6, "end_unit": 34, "error_codes": [], "extension": ".pdf", "filename": "中国移动智慧家庭全光组网产品技术规范V2.0.0.pdf", "governance_source": "default_curated_policy", "heading_path": ["中国移动智慧家庭全光组网产品技术规范V2.0.0", "第36页"], "knowledge_status": "approved", "media_type": "pdf", "next_block_id": "blk_09a93afe8cb8a1d39b71", "page_number": 36, "page_warning_codes": [], "parent_block_id": "blk_1c22d297772417f085c1", "parser_name": "pdf", "parser_strategy": "pymupdf_text_with_page_quality_report", "parser_version": "document-parser-v7", "permission_tags": ["public"], "previous_block_id": "blk_1c22d297772417f085c1", "review_status": "approved", "section_path": ["中国移动智慧家庭全光组网产品技术规范V2.0.0", "第36页"], "section_title": "第36页", "source": "中国移动智慧家庭全光组网产品技术规范V2.0.0.pdf", "source_block_ids": ["blk_fc00cfab6e8410f98035"], "source_path": "/app/data/中国移动智慧家庭全光组网产品技术规范V2.0.0.pdf", "source_type": "manual", "split_index": 0, "start_unit": 0, "table_parse_applied": false, "table_parse_skip_reason": "block_type_is_paragraph", "table_parse_status": "skipped", "table_parser_route": "deepdoc", "tenant_id": "default", "title": "中国移动智慧家庭全光组网产品技术规范V2.0.0", "version_id": "v_ab72ce00c904f060"}, "text": "章节：中国移动智慧家庭全光组网产品技术规范V2.0.0 > 第36页 页码：36 31 光网关及光路由和测试STA位于三个屏蔽箱内，对于支持11ax的全光组网终端，测试 STA建议通过5GHz频段与光网关或光路由建立关联，对于支持11b的全光组网终端，测试 STA建议通过MLO与光网关或光路由建立关联；光网关和光路由之间通过光纤连接，光网 关与光路由间Wi-Fi信号相互可见，且信号强度为-60dBm±2dBm； 使用流量服务器从OLT向测试STA发送200Mbps或1000pps，1500byte字节长度的UDP 流，发流的同时，按照1dB/s的速率调节STA终端与光网关/光路由间屏蔽箱的衰减，模拟 测试STA终端在光网关及光路由间的相对运动，记录测试STA在光网关及光路由间漫游过 程中的吞吐量，测试时长为3分钟，按秒记录吞吐量及漫游时延； 光网关和光路由均支持Wi-Fi 6时，漫游吞吐平均不低于150Mbps，最小不低于75Mbps； 光网关和光路由均支持Wi-Fi 7时，漫游吞吐平均不低于170Mbps，最小不低于80Mbps。 对于支持802.11k/v/r 的客户端，全光组网终端间使用光纤组网时，STA 在全光组网 终端间漫游切换时延须优于75ms，宜优于40ms； 4.4.1.4. 接收灵敏度要求 全光组网终端符合802.11n 协议20.3.22.1 中的相关要求。 全光组网终端应符合802.11ac协议中22.3.19.1的相关要求。 全光组网终端应符合802.11ax协议中27.3.19.2的相关要求。 全光组网终端应符合802.11be协议中36.3.19/20的相关要求。 4.4.1.5. 方向性要求 方向性是指全光组网终端的不同方位上获取性能的偏差。其性能同全光组网终端天 线极化方向、方向图、空间MIMO信道差异等因素，导致不同方向上的性能指标存在差异。 对于双空间流的全光组网终端，其多个方向下行性能平均值要求如表4-7所示："}, "keyword_score": 0.1788839878913239, "normalized_bm25_score": 0.1788839878913239, "rerank_score": null, "retrieval_score": 0.5202083900329505, "score": 0.5202083900329505, "semantic_score": 0.6664902766650762}], "state": "success", "timeout": false, "trace": {"answer_source": "rag", "augmented_context": "请求ID：a6cab2be40e54476a45bb6697a5d4243\n会话ID：p6-e2e-run01-qwen-flash-p6s-0108-attempt1\n租户ID：未指定\n用户ID：未指定\n权限标签：未指定\n用户原始问题：在2.5G非对称模式下，光路由上行光口的发送光功率范围是多少？\n归一化查询：在2.5G非对称模式下，光路由上行光口的发送光功率范围是多少？\n是否跟进问答：否\n上下文改写查询：在2.5G非对称模式下，光路由上行光口的发送光功率范围是多少？\n上下文关键术语：无\n改写查询：在2.5G非对称模式下，光路由上行光口的发送光功率范围是多少？\n检索查询：在2.5G非对称模式下，光路由上行光口的发送光功率范围是多少？ 收光功率 光衰 光信号强度 业务说明 知识库 常见问题\n同义词扩展：收光功率, 光衰, 光信号强度\n语义扩展：业务说明, 知识库, 常见问题\n识别意图：general_knowledge\n\n会话历史摘要：\n无\n\n工具调用结果：\n无\n\n检索到的相关文档：\n[1] 来源：中国移动智慧家庭全光组网产品技术规范V2.0.0.pdf\n引用标签：[1]\n标题：第57页\n定位信息：57\n综合分：0.852013\n召回综合分：0.852013\n重排分：无\n语义分：0.788590\nBM25 原始分：124.989699\nBM25 归一化分：1.000000\n内容：章节：中国移动智慧家庭全光组网产品技术规范V2.0.0 > 第57页 页码：57 52 4.10.1.1.2. 光路由上行接口要求 为满足部分光网关和光路由不加链路衰减，直连使用需求，光路由上行光口链路预算 等级可参考Ra 等级，要求发送光功率范围-4~0dBm，接收光功率范围为-22~0dBm，最大 光链路损耗不超过18dB。实际使用中需要保证光路由接收光功率在饱和功率值和接收灵 敏度之间。 2.5G 对称模式的光路由上行光口功率要求应参考2.5G 非对称模式的要求。 光路由上行接口需支持2.5G 非对称模式，推荐支持2.5G 对称模式。光路由上行线路 码型推荐采用NRZ 编码，推荐光路由上行工作波长范围为1310±10nm。 4.10.1.2. 用户侧接口要求 4.10.1.2.1. 用户侧光接口要求 为满足光网关和光路由之间不加链路衰减，直连使用需求，2.5G 非对称模式的光网关 下行光口链路预算等级可参考Ra 等级，要求发送光功率范围-4~0dBm，接收光功率范围 为-22~0dBm，最大光链路损耗不超过18dB。实际使用中需要保证光网关PONMAC 接收 光功率在饱和功率值和接收灵敏度之间。 2.5G 对称模式的光网关下行光口功率要求应参考2.5G 非对称模式的要求。 光网关下行接口需支持2.5G 非对称模式，可选支持2.5G 对称模式。光网关下行线路 码型推荐采用NRZ 编码，推荐光网关下行工作波长范围为1490±10nm。 4.10.1.2.2. 用户侧以太网接口要求 用户侧以太网接口应支持100/1000Base-T Ethernet 接口，Wi-Fi 7 全光组网终端还需 支持2.5G Base-T Ethernet 接口。应符合IEEE 802.3 标准，支持采用直连网线进行连接， 支持自动校验连接网线的功能。 4.10.1.2.3. 用户侧WLAN 接口要求 2.4GHz 和5GHz 频段应符合IEEE 802.11ax/be 协议。 4.10.2. 设备兼容性要求 全光组网终端应具有良好兼容性，新设备需实现对现网已激活终端的前向兼容能力。\n\n[2] 来源：中国移动智慧家庭全光组网产品技术规范V2.0.0.pdf\n引用标签：[2]\n标题：第38页\n定位信息：38\n综合分：0.566785\n召回综合分：0.566785\n重排分：无\n语义分：0.693646\nBM25 原始分：33.844085\nBM25 归一化分：0.270775\n内容：章节：中国移动智慧家庭全光组网产品技术规范V2.0.0 > 第38页 页码：38 33 光网关 光路由 近距离 中距离（RSSI -55±2dbm) 远距离（RSSI -65±2dbm) STA1-4K视频 STA2-4K视频 STA3-4K视频 STA4-下载 STA5-下载 STA6-下载 STA7-云游戏 STA8-云游戏 STA9-云游戏 STA10-手游 STA11-手游 STA12-手游 图4-3：时延测试拓扑 在FTTR组网场景下，光网关与光路由相互存在Wi-Fi干扰，由于无线局域网（WLAN） 空口被其他干扰信号占用，数据传输过程中存在一定的丢包和重传，而重传会使业务时延 增加，本场景需要满足如下设定： 1） 多用户并发时延指标场景的用户数为12个。 2） 连接方案： 光网关与光路由之间通过光纤进行连接，光网关和光路由间Wi-Fi可见，相互间信号 强度为-60dBm±2dBm；STA2/4/8/10对光网关和光路由均可见，其他STA仅对光网关或光 路由可见；STA2/4/8/10仅约束同光网关及光路由间的相互信号强度，STA连接热点由全光 组网终端自身算法决定；测试业务流从光网关上行口进行打流； 3） 待测FTTR终端工作设置：光网关和光路由的2.4GHz频段均工作在信道1，频宽 20MHz；5GHz频段均工作在36信道，频宽160MHz； 4） 业务模型：\n\n[3] 来源：中国移动智慧家庭全光组网产品技术规范V2.0.0.pdf\n引用标签：[3]\n标题：第46页\n定位信息：46\n综合分：0.539220\n召回综合分：0.539220\n重排分：无\n语义分：0.639132\nBM25 原始分：38.258395\nBM25 归一化分：0.306092\n内容：章节：中国移动智慧家庭全光组网产品技术规范V2.0.0 > 第46页 页码：46 41 4.5.5. 过压过流保护 设备应满足GB/T 17626.5-2019《电磁兼容 试验和测量技术 浪涌(冲击)抗扰度试验》 对模拟雷电冲击、电力线感应、电力线接触等指标的要求。 设备电源应具备共模4KV/差模4KV；以太网接口应具备1.5KV（共模）的防护能力。 4.6. 硬件要求 4.6.1. 指示灯要求 4.6.1.1. 光网关指示灯要求 光网关应具备表4-12 中的指示灯，指示各模块运行状态； 表4-11 光网关指示灯要求 指示灯名称 颜色 建议标识文字 显示功能 电源指示灯 颜色A 电源 常亮：系统正常上电 熄灭：系统未上电 PON 状态灯（可选） 颜色A 注册 熄灭：未开始注册流程 常亮：完成注册 闪烁：正在注册 上行光信号状态灯 红色 光信号 熄灭：接收光功率正常 闪烁：接收光功率异常 下行光信号状态灯 颜色A 光网络 熄灭：系统未上电或下行光纤未连接 常亮：下行光纤已连接，但无数据传输 闪烁：正在进行数据传输 以太网口状态灯 颜色A 1,2 （用户侧接 口） 熄灭：系统未上电或网口未连接 常亮：网口已连接，但无数据传输 闪烁：正常进行数据传输 USB 口状态灯（可选） 颜色A USB-序号 熄灭：系统未上电或USB 接口未连接 常亮：USB 接口已连接，但无数据传输 闪烁：正在进行数据传输 WLAN 口状态灯（可选） 颜色A 无线 熄灭：系统未上电或无线接口被禁用\n\n[4] 来源：中国移动智慧家庭全光组网产品技术规范V2.0.0.pdf\n引用标签：[4]\n标题：第36页\n定位信息：36\n综合分：0.520208\n召回综合分：0.520208\n重排分：无\n语义分：0.666490\nBM25 原始分：22.358656\nBM25 归一化分：0.178884\n内容：章节：中国移动智慧家庭全光组网产品技术规范V2.0.0 > 第36页 页码：36 31 光网关及光路由和测试STA位于三个屏蔽箱内，对于支持11ax的全光组网终端，测试 STA建议通过5GHz频段与光网关或光路由建立关联，对于支持11b的全光组网终端，测试 STA建议通过MLO与光网关或光路由建立关联；光网关和光路由之间通过光纤连接，光网 关与光路由间Wi-Fi信号相互可见，且信号强度为-60dBm±2dBm； 使用流量服务器从OLT向测试STA发送200Mbps或1000pps，1500byte字节长度的UDP 流，发流的同时，按照1dB/s的速率调节STA终端与光网关/光路由间屏蔽箱的衰减，模拟 测试STA终端在光网关及光路由间的相对运动，记录测试STA在光网关及光路由间漫游过 程中的吞吐量，测试时长为3分钟，按秒记录吞吐量及漫游时延； 光网关和光路由均支持Wi-Fi 6时，漫游吞吐平均不低于150Mbps，最小不低于75Mbps； 光网关和光路由均支持Wi-Fi 7时，漫游吞吐平均不低于170Mbps，最小不低于80Mbps。 对于支持802.11k/v/r 的客户端，全光组网终端间使用光纤组网时，STA 在全光组网 终端间漫游切换时延须优于75ms，宜优于40ms； 4.4.1.4. 接收灵敏度要求 全光组网终端符合802.11n 协议20.3.22.1 中的相关要求。 全光组网终端应符合802.11ac协议中22.3.19.1的相关要求。 全光组网终端应符合802.11ax协议中27.3.19.2的相关要求。 全光组网终端应符合802.11be协议中36.3.19/20的相关要求。 4.4.1.5. 方向性要求 方向性是指全光组网终端的不同方位上获取性能的偏差。其性能同全光组网终端天 线极化方向、方向图、空间MIMO信道差异等因素，导致不同方向上的性能指标存在差异。 对于双空间流的全光组网终端，其多个方向下行性能平均值要求如表4-7所示：", "authorized_source_count": 4, "bm25_weight": 0.3, "context_latency_ms": 3.399, "context_terms": [], "contextual_query": "在2.5G非对称模式下，光路由上行光口的发送光功率范围是多少？", "conversation_history_turn_count": 0, "created_at": "2026-11-05T12:14:52.605867+00:00", "degradation_reason": null, "embedding_latency_ms": 316.066, "generation_latency_ms": 1545.119, "intent_confidence": 0.35, "intent_label": "general_knowledge", "intent_latency_ms": 0.038, "intent_reason": "未命中明确业务意图，按通用知识问答处理。", "is_follow_up": false, "keyword_weight": 0.3, "latency_ms": 2645.045, "min_similarity_score": 0.05, "normalized_query": "在2.5G非对称模式下，光路由上行光口的发送光功率范围是多少？", "original_query": "在2.5G非对称模式下，光路由上行光口的发送光功率范围是多少？", "override_degradation_reason": null, "override_hit": false, "override_id": null, "override_type": null, "permission_tags": [], "query_embedding_cache_hit": false, "query_embedding_dimensions": 1024, "query_rewrite_rules": [], "relative_score_threshold": 0.35, "request_id": "a6cab2be40e54476a45bb6697a5d4243", "rerank_applied": false, "rerank_candidate_k": 20, "rerank_latency_ms": 0.0, "rerank_model": "none", "rerank_provider": "none", "rerank_skip_reason": "provider_disabled", "reranked_count": 4, "retrieval_candidate_k": 20, "retrieval_latency_ms": 1088.8, "retrieval_mode": "hybrid", "retrieval_query": "在2.5G非对称模式下，光路由上行光口的发送光功率范围是多少？ 收光功率 光衰 光信号强度 业务说明 知识库 常见问题", "retrieved_count": 4, "rewrite_latency_ms": 0.05, "rewritten_query": "在2.5G非对称模式下，光路由上行光口的发送光功率范围是多少？", "semantic_expansions": ["业务说明", "知识库", "常见问题"], "semantic_weight": 0.7, "session_id": "p6-e2e-run01-qwen-flash-p6s-0108-attempt1", "synonym_expansions": ["收光功率", "光衰", "光信号强度"], "tenant_id": null, "tool_calls": [], "top_k": 4, "user_id": null, "vector_search_latency_ms": 772.7, "vector_store_provider": "postgresql"}, "wall_seconds": 2.6723100999370217}
{"answer": "1. 光网关下行接口应支持100/1000Base-T以太网速率。[1]  \n2. 全光组网终端还需支持2.5G Base-T以太网接口。[1]  \n3. 接口需符合IEEE 802.3标准，支持直连网线连接。[1]  \n4. 支持自动校验连接网线功能。[1]  \n5. 2.5G以太网接口上行吞吐量不小于2200Mbps。[3]", "attempt": 1, "case_id": "p6s-0109", "error": null, "finished_at": "2026-11-05T20:14:54.846369+08:00", "model_calls": [{"api_call_id": "9b1d3cedce8740afacd9a207181a80b0", "kind": "embedding", "request": {"dimensions": 1024, "input": ["光网关下行接口应支持哪些以太网速率？ 业务说明 知识库 常见问题"], "model": "text-embedding-v4", "timeout": 3.0}, "response": {"data": [{"embedding": [-0.07510195672512054, 0.020634014159440994, -0.006482885219156742, 0.03415587916970253, 0.037316832691431046, 0.030380291864275932, 0.004748750012367964, 0.09904326498508453, 0.019580362364649773, 0.046975307166576385, 0.010624322108924389, 0.053092341870069504, 0.03564855083823204, 0.06017522141337395, -0.028316890820860863, 0.024336429312825203, -0.03140467405319214, -0.10887734591960907, -0.0916091650724411, 0.06263374537229538, 0.01250479742884636, 0.040653396397829056, -0.018775489181280136, -0.015146244317293167, -0.009490182623267174, 0.04899480566382408, -0.0048036277294158936, -0.004935333970934153, 0.06298495829105377, -0.019258413463830948, 0.019653532654047012, -0.05206795781850815, 0.05370697006583214, 0.013295036740601063, -0.0066109332256019115, 0.04261435940861702, -0.010119447484612465, -0.005619476083666086, 0.021907176822423935, -0.03734610229730606, -0.023736432194709778, -0.01583404466509819, 0.01242431066930294, 0.037755854427814484, -0.026590073481202126, -0.003241442609578371, -0.025390081107616425, -0.041443634778261185, -0.032429058104753494, -0.04410703480243683, -0.007082881405949593, -0.04317045211791992, 0.029575418680906296, 0.02713153325021267, -0.0036036353558301926, 0.014692588709294796, 0.002774982014670968, -0.011765778064727783, 0.016946231946349144, 0.04156070947647095, 0.015468193218111992, 0.055785007774829865, 0.011392609216272831, -0.022214490920305252, -0.010353592224419117, -0.01380722783505916