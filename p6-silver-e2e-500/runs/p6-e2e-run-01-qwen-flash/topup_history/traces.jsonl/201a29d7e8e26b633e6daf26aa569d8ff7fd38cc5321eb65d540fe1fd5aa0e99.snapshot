": "pymupdf_text_with_page_quality_report", "parser_version": "document-parser-v7", "permission_tags": ["public"], "previous_block_id": "blk_385d2fe67eafb43e9ff7", "review_status": "approved", "section_path": ["电信基础设施维护规程", "第173页"], "section_title": "第173页", "source": "电信基础设施维护规程.pdf", "source_block_ids": ["blk_a20372649c831c0ba910"], "source_path": "/app/data/电信基础设施维护规程.pdf", "source_type": "manual", "split_index": 0, "start_unit": 0, "table_parse_applied": false, "table_parse_skip_reason": "block_type_is_paragraph", "table_parse_status": "skipped", "table_parser_route": "deepdoc", "tenant_id": "default", "title": "电信基础设施维护规程", "version_id": "v_8ae9b63d869002c1"}, "text": "章节：电信基础设施维护规程 > 第173页 页码：173 T/CAICI XXXX—XXXX 167 10.2 信息通信光缆线路维护工作量清单项目综合单价指标 10.2.1 信息通信光缆线路日常维护项目综合单价指标 表10.2.1.1 WH11101 架空光缆线路徒步巡回 工作内容：徒步沿线巡回，检查拉线是否生锈、电杆是否正立、有无塌方、吊线垂度是否符合要求、挂钩有无脱落、宣传牌、标志牌、警示牌是否歪斜或缺漏、 沿线重点部位保护是否到位、沿线有无外力施工影响线路安全等；做好巡查记录，并将发现的问题及时上报等。 计量单位：千米²次 维护分项作业 项目编码 项目名称 综合单价 （元） 其中 名称 人工 人工费(元) 企业管理费(元) 利润(元) 技工 普工 单位 工日 单价(元) 114.00 61.00 WH11001001 架空光缆线路徒步巡回 平原 66.01 44.79 12.27 8.96 消耗量 0.39 — WH11001002 丘陵、城市 79.22 53.74 14.73 10.75 0.47 — WH11001003 山区 99.02 67.18 18.41 13.44 0.59 —"}, "keyword_score": 1.0, "normalized_bm25_score": 1.0, "rerank_score": null, "retrieval_score": 0.8468693673610688, "score": 0.8468693673610688, "semantic_score": 0.7812419533729553}, {"bm25_score": 42.2914345256488, "chunk": {"document_id": "c8588238d99d4079e1ec6101", "id": "c379e9fa43fe7ee20946d7ab", "metadata": {"block_id": "blk_48c85ad3ad7eb7503b4c", "block_index": 174, "block_type": "paragraph", "business_module": "通用知识", "chunk_index": 174, "chunk_parse_quality_status": "parsed_with_warning", "chunk_parse_warning_codes": ["bordered_table_detected"], "content_hash": "8ae9b63d869002c1950aaf1192e44b0b876ccb9d927154f35e8c48bcd24094bb", "detected_codes": [], "document_ocr_page_count": 0, "document_ocr_status": "not_required", "document_parse_quality_status": "parsed_with_warning", "document_parse