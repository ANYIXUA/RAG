ot_required", "document_parse_quality_status": "parsed_with_warning", "document_parse_warning_count": 6, "end_unit": 53, "error_codes": [], "extension": ".pdf", "filename": "中国移动智慧家庭全光组网产品技术规范V2.0.0.pdf", "governance_source": "default_curated_policy", "heading_path": ["中国移动智慧家庭全光组网产品技术规范V2.0.0", "第58页"], "knowledge_status": "approved", "media_type": "pdf", "next_block_id": "blk_a06ebed80acea19ab374", "page_number": 58, "page_warning_codes": ["bordered_table_detected"], "parent_block_id": "blk_c7b835ad8445f649e93d", "parser_name": "pdf", "parser_strategy": "pymupdf_text_with_page_quality_report", "parser_version": "document-parser-v7", "permission_tags": ["public"], "previous_block_id": "blk_c7b835ad8445f649e93d", "review_status": "approved", "section_path": ["中国移动智慧家庭全光组网产品技术规范V2.0.0", "第58页"], "section_title": "第58页", "source": "中国移动智慧家庭全光组网产品技术规范V2.0.0.pdf", "source_block_ids": ["blk_cd3b821b7bc45c831531"], "source_path": "/app/data/中国移动智慧家庭全光组网产品技术规范V2.0.0.pdf", "source_type": "manual", "split_index": 0, "start_unit": 0, "table_parse_applied": false, "table_parse_skip_reason": "block_type_is_paragraph", "table_parse_status": "skipped", "table_parser_route": "deepdoc", "tenant_id": "default", "title": "中国移动智慧家庭全光组网产品技术规范V2.0.0", "version_id": "v_ab72ce00c904f060"}, "text": "章节：中国移动智慧家庭全光组网产品技术规范V2.0.0 > 第58页 页码：58 53 4.11. 其他要求 4.11.1. 可靠性要求 MTBF（平均无故障工作时间）至少应达到30000 小时以上，长时间运行时不应出现 业务中断或性能下降。 4.11.2. 温度要求 在室温25±2℃的情况下，非嵌入式全光组网终端表面温度需不超过50℃，嵌入式全 网组网终端设备表面温度需不超过65℃。 4.11.3. 编码要求 编码说明：SN 码（Serial Number），为15 位编码。其中，前2 位为厂家编码，再后 4 位为设备编码，厂家编码和设备编码由智家中心统一分配，设备编码信息参考章节1.4.3 定义的产品名称码，最后9 位为生产流水号，由厂家自行定义，批量生产设备的串号不得 有规律，如“末尾连续数字”等，必须将串号打乱。厂家编码及设备编码由中国移动统一 分配。 表4-14 SN 编码表 编码 XX XXXX XXXXXXXXX 位数 2 位 4 位 9 位 含义 厂家编码，用来区分产 品品牌； 设备编码，用来区分设 备型号，采用十进制 生产流水号，十进制，不能重 复。 为方便库存管理，设备应根据省公司要求具备CMEI 码，具体编码规则请参考《中国 移动非蜂窝类智能硬件产品统一编码规范》。"}, "keyword_score": 0.24514920860309808, "normalized_bm25_score": 0.24514920860309808, "rerank_score": null, "retrieval_score": 0.43281414557812203, "