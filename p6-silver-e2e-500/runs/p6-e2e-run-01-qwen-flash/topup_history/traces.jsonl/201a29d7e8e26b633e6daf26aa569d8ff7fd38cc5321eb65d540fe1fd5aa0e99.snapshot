混合缆成端接头 （端头） 71.14 44.46 13.34 13.34 0.39 WH23108005 测试光电混合缆 光纤（芯） 9.12 5.70 1.71 1.71 0.05 WH23108006 馈电线（芯） 5.47 3.42 1.03 1.03 0.03 注：高铁隧道内布放光电混合缆，按照相应子目综合单价乘以系数1.5,管井、竖井、活动地板下方、顶棚上方、其他隧道内布放光电混合缆，按照相应子目综合单价乘以系数1.3。"}, "keyword_score": 1.0, "normalized_bm25_score": 1.0, "rerank_score": null, "retrieval_score": 0.8287783946063048, "score": 0.8287783946063048, "semantic_score": 0.7553977065804355}, {"bm25_score": 34.48850877264791, "chunk": {"document_id": "c8588238d99d4079e1ec6101", "id": "db8a91a8aa6eed3abf6b5879", "metadata": {"block_id": "blk_a14a1ada2dacd6a22aa2", "block_index": 263, "block_type": "paragraph", "business_module": "通用知识", "chunk_index": 263, "chunk_parse_quality_status": "parsed_with_warning", "chunk_parse_warning_codes": ["bordered_table_detected", "semi_structured_table_detected"], "content_hash": "8ae9b63d869002c1950aaf1192e44b0b876ccb9d927154f35e8c48bcd24094bb", "detected_codes": [], "document_ocr_page_count": 0, "document_ocr_status": "not_required", "document_parse_quality_status": "parsed_with_warning", "document_parse_warning_count": 7, "end_unit": 81, "error_codes": [], "extension": ".pdf", "filename": "电信基础设施维护规程.pdf", "governance_source": "default_curated_policy", "heading_path": ["电信基础设施维护规程", "第264页"], "knowledge_status": "approved", "media_type": "pdf", "next_block_id": "blk_ad11ac1badca94c8561d", "page_number": 264, "page_warning_codes": ["bordered_table_detected", "semi_structured_table_detected"], "parent_block_id": "blk_36c4cdc0470ca8d53e79", "parser_name": "pdf", "parser_strategy": "pymupdf_text_with_page_quality_report", "parser_version": "document-parser-v7", "permission_tags": ["public"], "previous_block_id": "blk_36c4cdc0470ca8d53e79", "review_status": "approved", "section_path": ["电信基础设施维护规程", "第264页"], "section_title": "第264页", "source": "电信基础设施维护规程.pdf", "source_block_ids": ["blk_a14a1ada2dacd6a22aa2"], "source_path": "/app/data/电信基础设施维护规程.pdf", "source_type": "manual", "split_index": 0, "start_unit": 0, "table_parse_app