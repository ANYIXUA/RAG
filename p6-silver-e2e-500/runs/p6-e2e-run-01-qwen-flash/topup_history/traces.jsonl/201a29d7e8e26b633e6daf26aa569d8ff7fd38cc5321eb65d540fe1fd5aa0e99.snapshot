时停电期间的供电保 障。应急发电应根据站点等级发电，优先保障重要站点。 5.7.1.7 在多起障碍同时发生时，维护企业应遵循“先重点、后一般”和“先抢通、后修复”的原则进行 修复。 5.7.1.8 障碍抢修后，应及时对网络质量予以验证，编制上报故障处理报告。 5.7.1.9 应急发电应根据站点等级进行发电。确保重要站点发电得到保证。在允许发电时，优先向通信主 设备及传输设备供电。 5.7.1.10 乙方负责与供电部门联系协调，确认停电原因，尽快恢复供电 5.7.1.11 基站障碍抢修流程见附录G。 5.7.2 突发事件处理 5.7.2.1 凡是危及基站设备及其附属设施安全运行的事件均称为突发事件。突发事件分为一般突发事件、 重大突发事件。一般突发事件为在设备安全和通信正常的情况下，经过对基站设备一般性处理，基站设备\n\n[4] 来源：电信基础设施维护规程.pdf\n引用标签：[4]\n标题：第353页\n定位信息：353\n综合分：0.668517\n召回综合分：0.668517\n重排分：无\n语义分：0.758863\nBM25 原始分：23.292421\nBM25 归一化分：0.457710\n内容：章节：电信基础设施维护规程 > 第353页 页码：353 T/CAICI XXXX—XXXX 347 表格列：附；录；G （资料性） 无线通信基站设备和设施维护基站障碍抢修流程 障碍发生 运营管理企业通知 维护企业抢修 维护企业组织抢修 维护企业准备抢修 车辆、工器具 到达故障发生地 查找障碍点 现场抢修 障碍消除 机房验证 障碍消除 告知维护企业故障 消除、清理现场 除障作业完成 否 是", "authorized_source_count": 4, "bm25_weight": 0.3, "context_latency_ms": 1.628, "context_terms": [], "contextual_query": "无线通信基站应急维护中，故障抢修的故障类型具体包括哪些？", "conversation_history_turn_count": 0, "created_at": "2026-11-05T12:14:17.106035+00:00", "degradation_reason": null, "embedding_latency_ms": 172.249, "generation_latency_ms": 1195.809, "intent_confidence": 0.35, "intent_label": "general_knowledge", "intent_latency_ms": 0.04, "intent_reason": "未命中明确业务意图，按通用知识问答处理。", "is_follow_up": false, "keyword_weight": 0.3, "latency_ms": 2005.641, "min_similarity_score": 0.05, "normalized_query": "无线通信基站应急维护中，故障抢修的故障类型具体包括哪些？", "original_query": "无线通信基站应急维护中，故障抢修的故障类型具体包括哪些？", "override_degradation_reason": null, "override_hit": false, "override_id": null, "override_type": null, "permission_tags": [], "query_embedding_cache_hit": false, "query_embedding_dimensions": 1024, "query_rewrite_rules": [], "relative_score_threshold": 0.35, "request_id": "0f49d379ab6a4f8abcadc4a2c00d0a23", "rerank_applied": false, "rerank_candidate_k": 20, "rerank_latency_ms": 0.0, "rerank_model": "none", "rerank_provider": "none", "rerank_skip_reason": "provider_disabled", "reranked_count": 4, "retrieval_candidate_k": 20, "retrieval_latency_ms": 804.308, "retrieval_mode": "hybrid", "retrieval_query": "无线通信基站